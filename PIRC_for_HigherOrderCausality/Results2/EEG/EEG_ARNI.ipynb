    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"nz = 7  # scalp zones\\n\",\n",
    "    \"subjects = list_all_subjects(109)\\n\",\n",
    "    \"states = [\\\"01\\\", \\\"02\\\"]  # resting\\n\",\n",
    "    \"s = np.loadtxt(\\n\",\n",
    "    \"    f\\\"../../EEG_data/eeg-data/sensors-{nz}.csv\\\",\\n\",\n",
    "    \"    dtype=str,\\n\",\n",
    "    \"    delimiter=\\\",\\\"\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"z = np.loadtxt(\\n\",\n",
    "    \"    f\\\"../../EEG_data/eeg-data/zones-{nz}.csv\\\",\\n\",\n",
    "    \"    dtype=int,\\n\",\n",
    "    \"    delimiter=\\\",\\\"\\n\",\n",
    "    \")\\n\",\n",
    "    \"s2z = {s[i]: z[i] for i in range(len(s))}\\n\",\n",
    "    \"AA2 = {}\\n\",\n",
    "    \"AA3 = {}\\n\",\n",
    "    \"AA4 = {}\\n\",\n",
    "    \"relerr = {}\\n\",\n",
    "    \"rho_all = []\\n\",\n",
    "    \"ExpandNodes = nz + math.comb(nz - 1, 2)\\n\",\n",
    "    \"T_Matrix = np.zeros((nz, ExpandNodes))\\n\",\n",
    "    \"bases = ['fourier'] #'fourier''polynomial'\\n\",\n",
    "    \"types = ['mul'] #'add'\\n\",\n",
    "    \"name='ARNI2'\\n\",\n",
    "    \"# orders = (2,)\"\n",
    "   ],\n",
    "   \"id\": \"1df2d014cc4ce80\",\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": 3\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-08-24T13:08:03.618563Z\",\n",
    "     \"start_time\": \"2026-08-24T13:04:31.608869Z\"\n",
    "    }\n",
    "   },\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"T=2000\\n\",\n",
    "    \"Ainf_all=[]\\n\",\n",
    "    \"Score=[]\\n\",\n",
    "    \"for su in subjects:\\n\",\n",
    "    \"    for st in states:\\n\",\n",
    "    \"        T_from_Ainf = np.zeros_like(T_Matrix)\\n\",\n",
    "    \"        key = f\\\"S{su}R{st}\\\"\\n\",\n",
    "    \"        print(f\\\"Running {key}\\\")\\n\",\n",
    "    \"        file = (\\n\",\n",
    "    \"                        f\\\"../../EEG_data/physionet.org/files/eegmmidb/1.0.0/\\\"\\n\",\n",
    "    \"                        f\\\"S{su}/{key}.edf\\\"\\n\",\n",
    "    \"                    )\\n\",\n",
    "    \"        s2signal = read_eeg(file)\\n\",\n",
    "    \"        asig = average_over_zones(s2signal, s2z)\\n\",\n",
    "    \"        dt = 1 / 160\\n\",\n",
    "    \"        tmp = np.max(np.abs(asig), axis=0)\\n\",\n",
    "    \"        valid_idx = np.where(tmp > 1e-6)[0]\\n\",\n",
    "    \"        if len(valid_idx) == 0:\\n\",\n",
    "    \"            continue\\n\",\n",
    "    \"        start, end = valid_idx[0], valid_idx[-1]\\n\",\n",
    "    \"        X0 = denoise_fourier(asig[:, start:end + 1], 100)\\n\",\n",
    "    \"        X = X0 / np.mean(np.abs(X0))\\n\",\n",
    "    \"        Y = (X[:, 1:] - X[:, :-1]) / dt\\n\",\n",
    "    \"\\n\",\n",
    "    \"        # Y = Y0 / np.mean(np.abs(Y0))\\n\",\n",
    "    \"        X=X[:, :T]\\n\",\n",
    "    \"        Y=Y[:, :T]\\n\",\n",
    "    \"\\n\",\n",
    "    \"        expanded_cache = {}\\n\",\n",
    "    \"        for NODE in range(nz):\\n\",\n",
    "    \"            expanded_cache[(NODE, types[0])] = expand_nodes(X.T, NODE, type=types[0], order=3)\\n\",\n",
    "    \"\\n\",\n",
    "    \"        results = Parallel(n_jobs=-1)(\\n\",\n",
    "    \"                    delayed(run_node)(\\n\",\n",
    "    \"                        NODE,\\n\",\n",
    "    \"                        types[0],\\n\",\n",
    "    \"                        bases[0],\\n\",\n",
    "    \"                        2,\\n\",\n",
    "    \"                        expanded_cache,\\n\",\n",
    "    \"                        Y\\n\",\n",
    "    \"                    )\\n\",\n",
    "    \"                    for NODE in range(nz)\\n\",\n",
    "    \"                )\\n\",\n",
    "    \"\\n\",\n",
    "    \"        for NODE, vec in results:\\n\",\n",
    "    \"            T_from_Ainf[NODE, :] = vec\\n\",\n",
    "    \"        Ainf_raw=build_T_to_Ainf(T_from_Ainf,3)\\n\",\n",
    "    \"        Ainf_all.append(Ainf_raw)\\n\",\n",
    "    \"        Score.append(T_from_Ainf)\\n\",\n",
    "    \"save_dict = {\\n\",\n",
    "    \"    \\\"Ainf_all\\\": Ainf_all,\\n\",\n",
    "    \"    \\\"Score_all\\\":Score,\\n\",\n",
    "    \"}\\n\",\n",
    "    \"\\n\",\n",
    "    \"with open(\\\"ARNI1_result.pkl\\\", \\\"wb\\\") as f:\\n\",\n",
    "    \"    pickle.dump(save_dict, f)\\n\",\n",
    "    \"print(\\\"Saved to ARNI1_result.pkl\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"def build_T_to_Ainf(T_from_Ainf, max_order=3):\\n\",\n",
    "    \"    T_to_Ainf = {o: [] for o in range(2, max_order + 1)}\\n\",\n",
    "    \"\\n\",\n",
    "    \"    row, col = T_from_Ainf.shape\\n\",\n",
    "    \"    node_num = row\\n\",\n",
    "    \"\\n\",\n",
    "    \"    for i in range(row):\\n\",\n",
    "    \"        for j in range(col):\\n\",\n",
    "    \"            val = T_from_Ainf[i, j]\\n\",\n",
    "    \"\\n\",\n",
    "    \"            if val == 0:\\n\",\n",
    "    \"                continue\\n\",\n",
    "    \"\\n\",\n",
    "    \"            if j < node_num:\\n\",\n",
    "    \"                if j != i:\\n\",\n",
    "    \"                    T_to_Ainf[2].append([i, j, val])\\n\",\n",
    "    \"\\n\",\n",
    "    \"            elif j < node_num + math.comb(node_num - 1, 2):\\n\",\n",
    "    \"                idx = j - node_num\\n\",\n",
    "    \"                others = [x for x in range(node_num) if x != i]\\n\",\n",
    "    \"                comb_list = list(combinations(others, 2))\\n\",\n",
    "    \"                j0, k0 = comb_list[idx]\\n\",\n",
    "    \"                T_to_Ainf[3].append([i, j0, k0, val])\\n\",\n",
    "    \"\\n\",\n",
    "    \"            elif max_order == 4:\\n\",\n",
    "    \"                idx = j - node_num - math.comb(node_num - 1, 2)\\n\",\n",
    "    \"                others = [x for x in range(node_num) if x != i]\\n\",\n",
    "    \"                comb_list = list(combinations(others, 3))\\n\",\n",
    "    \"                j0, k0, l0 = comb_list[idx]\\n\",\n",
    "    \"                T_to_Ainf[4].append([i, j0, k0, l0, val])\\n\",\n",
    "    \"\\n\",\n",
    "    \"    for o in T_to_Ainf:\\n\",\n",
    "    \"        T_to_Ainf[o] = (\\n\",\n",
    "    \"            np.array(T_to_Ainf[o])\\n\",\n",
    "    \"            if len(T_to_Ainf[o]) > 0\\n\",\n",
    "    \"            else np.zeros((0, o + 1))\\n\",\n",
    "    \"        )\\n\",\n",
    "    \"\\n\",\n",
    "    \"    return T_to_Ainf\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"def top_freq_per_sequence(Ainf_list, order=3, top_n=5, threshold=None):\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    每个序列：\\n\",\n",
    "    \"    1. 可选：剔除 |weight| < threshold 的边\\n\",\n",
    "    \"    2. 按 |weight| 从大到小排序\\n\",\n",
    "    \"    3. 取 top_n\\n\",\n",
    "    \"    4. 统计超边出现频率\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    all_top_edges = []\\n\",\n",
    "    \"\\n\",\n",
    "    \"    for Ainf in Ainf_list:\\n\",\n",
    "    \"        if order not in Ainf or Ainf[order].shape[0] == 0:\\n\",\n",
    "    \"            continue\\n\",\n",
    "    \"\\n\",\n",
    "    \"        edges = Ainf[order]\\n\",\n",
    "    \"        weights = np.abs(edges[:, -1])\\n\",\n",
    "    \"\\n\",\n",
    "    \"        if threshold is not None:\\n\",\n",
    "    \"            valid = weights >= threshold\\n\",\n",
    "    \"            edges = edges[valid]\\n\",\n",
    "    \"            weights = weights[valid]\\n\",\n",
    "    \"\\n\",\n",
    "    \"        if len(weights) == 0:\\n\",\n",
    "    \"            continue\\n\",\n",
    "    \"\\n\",\n",
    "    \"        k = min(top_n, len(weights))\\n\",\n",
    "    \"        idx_top = np.argsort(weights)[-k:][::-1]\\n\",\n",
    "    \"\\n\",\n",
    "    \"        top_edges = edges[idx_top, :order]\\n\",\n",
    "    \"\\n\",\n",
    "    \"        for row in top_edges:\\n\",\n",
    "    \"            row = row.astype(int)\\n\",\n",
    "    \"\\n\",\n",
    "    \"            if order == 3:\\n\",\n",
    "    \"                target = int(row[0])\\n\",\n",
    "    \"                j, k0 = sorted([int(row[1]), int(row[2])])\\n\",\n",
    "    \"                edge = (target, j, k0)\\n\",\n",
    "    \"            else:\\n\",\n",
    "    \"                edge = tuple(row)\\n\",\n",
    "    \"\\n\",\n",
    "    \"            all_top_edges.append(edge)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    return Counter(all_top_edges)\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"def high_order_ratio(Score, n=7):\\n\",\n",
    "    \"    if torch.is_tensor(Score):\\n\",\n",
    "    \"        Score = Score.detach().cpu().numpy()\\n\",\n",
    "    \"\\n\",\n",
    "    \"    Score = np.asarray(Score).copy()\\n\",\n",
    "    \"\\n\",\n",
    "    \"    for i in range(n):\\n\",\n",
    "    \"        Score[i, i] = 0.0\\n\",\n",
    "    \"\\n\",\n",
    "    \"    higher = Score[:, n:].sum()\\n\",\n",
    "    \"    total = Score.sum()\\n\",\n",
    "    \"\\n\",\n",
    "    \"    return higher / (total + 1e-12)\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"top_select = 5\\n\",\n",
    "    \"\\n\",\n",
    "    \"freq_ARNI = top_freq_per_sequence(\\n\",\n",
    "    \"    Ainf_all,\\n\",\n",
    "    \"    order=3,\\n\",\n",
    "    \"    top_n=top_select,\\n\",\n",
    "    \"    threshold=None\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"top5_edges = freq_ARNI.most_common(5)\\n\",\n",
    "    \"\\n\",\n",
    "    \"rho_all = np.array([\\n\",\n",
    "    \"    high_order_ratio(S, n=7)\\n\",\n",
    "    \"    for S in Score\\n\",\n",
    "    \"])\\n\",\n",
    "    \"\\n\",\n",
    "    \"rho_mean = float(rho_all.mean())\\n\",\n",
    "    \"rho_std = float(rho_all.std())\\n\",\n",
    "    \"\\n\",\n",
    "    \"top5_all_target0 = (\\n\",\n",
    "    \"    len(top5_edges) >= 5\\n\",\n",
    "    \"    and all(edge[0] == 0 for edge, count in top5_edges)\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(f\\\"rho_all: {rho_mean:.4f} ± {rho_std:.4f}\\\")\\n\",\n",
    "    \"print(\\\"Top5:\\\", top5_edges)\\n\",\n",
    "    \"print(\\\"Top5 all target 0:\\\", top5_all_target0)\\n\",\n",
    "    \"import numpy as np\\n\",\n",
    "    \"import matplotlib.pyplot as plt\\n\",\n",
    "    \"\\n\",\n",
    "    \"rho_all = np.array([high_order_ratio(S, n=7) for S in Score])\\n\",\n",
    "    \"\\n\",\n",
    "    \"fig, ax = plt.subplots(figsize=(3.2, 4.0))\\n\",\n",
    "    \"\\n\",\n",
    "    \"bp = ax.boxplot(\\n\",\n",
    "    \"    [rho_all],\\n\",\n",
    "    \"    widths=0.45,\\n\",\n",
    "    \"    patch_artist=True,\\n\",\n",
    "    \"    showfliers=False,\\n\",\n",
    "    \"    showmeans=True,\\n\",\n",
    "    \"    meanline=True,\\n\",\n",
    "    \"    boxprops=dict(\\n\",\n",
    "    \"        facecolor = \\\"#F6D6DE\\\",\\n\",\n",
    "    \"        edgecolor=\\\"#222222\\\",\\n\",\n",
    "    \"        linewidth=1.8\\n\",\n",
    "    \"    ),\\n\",\n",
    "    \"    medianprops=dict(\\n\",\n",
    "    \"        color=\\\"#111111\\\",\\n\",\n",
    "    \"        linewidth=2.2\\n\",\n",
    "    \"    ),\\n\",\n",
    "    \"    meanprops=dict(\\n\",\n",
    "    \"        color=\\\"#B22222\\\",\\n\",\n",
    "    \"        linewidth=2.0,\\n\",\n",
    "    \"        linestyle=\\\"--\\\"\\n\",\n",
    "    \"    ),\\n\",\n",
    "    \"    whiskerprops=dict(\\n\",\n",
    "    \"        color=\\\"#222222\\\",\\n\",\n",
    "    \"        linewidth=1.6\\n\",\n",
    "    \"    ),\\n\",\n",
    "    \"    capprops=dict(\\n\",\n",
    "    \"        color=\\\"#222222\\\",\\n\",\n",
    "    \"        linewidth=1.6\\n\",\n",
    "    \"    )\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# 0.5 reference line\\n\",\n",
    "    \"ax.axhline(\\n\",\n",
    "    \"    0.5,\\n\",\n",
    "    \"    color=\\\"#666666\\\",\\n\",\n",
    "    \"    linestyle=\\\":\\\",\\n\",\n",
    "    \"    linewidth=1.8,\\n\",\n",
    "    \"    alpha=0.9,\\n\",\n",
    "    \"    zorder=0\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# optional scatter points\\n\",\n",
    "    \"x_jitter = np.random.normal(1, 0.035, size=len(rho_all))\\n\",\n",
    "    \"# ax.scatter(\\n\",\n",
