    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"def stack_score_all(Score_all):\\n\",\n",
    "    \"    return np.concatenate([to_numpy(s) for s in Score_all], axis=0)\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"def plot_global_kmeans_threshold_jitter(\\n\",\n",
