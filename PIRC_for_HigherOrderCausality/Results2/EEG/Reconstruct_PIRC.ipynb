    "    \"        idx_top = np.argsort(weights)[-top_n:][::-1]\\n\",\n",
    "    \"        top_edges = edges[idx_top, :order]\\n\",\n",
    "    \"        all_top_edges.extend([tuple(row.astype(int)) for row in top_edges])\\n\",\n",
