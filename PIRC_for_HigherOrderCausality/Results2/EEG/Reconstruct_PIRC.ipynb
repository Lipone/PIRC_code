    "    \"        )\\n\",\n",
    "    \"        R, _ = pirc.train(X_washout, X_train, Y_train)\\n\",\n",
    "    \"        if mode == 1:\\n\",\n",
    "    \"            Y_test_predict = pirc.Prediction(R, args.N_test, Y_train, Y_test)\\n\",\n",
    "    \"        else:\\n\",\n",
