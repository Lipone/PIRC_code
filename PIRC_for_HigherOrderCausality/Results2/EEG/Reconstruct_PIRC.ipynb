    "    \"\\n\",\n",
    "    \"    for pc, c in zip(parts[\\\"bodies\\\"], colors):\\n\",\n",
    "    \"        pc.set_facecolor(c)\\n\",\n",
    "    \"        pc.set_edgecolor(\\\"black\\\")\\n\",\n",
    "    \"        pc.set_alpha(0.85)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # 加中位数和四分位数\\n\",\n",
