    "    \"\\n\",\n",
    "    \"    pair = S[:, :n].sum(axis=1)\\n\",\n",
    "    \"    higher = S[:, n:].sum(axis=1)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    rho = higher / (pair + higher + 1e-12)\\n\",\n",
    "    \"    return rho\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"def plot_scoreall_percentile_violin(Score_all, labels=None, n=7):\\n\",\n",
