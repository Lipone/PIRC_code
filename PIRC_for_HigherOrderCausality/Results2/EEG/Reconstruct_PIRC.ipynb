    "   \"source\": [\n",
    "    \"import sys\\n\",\n",
    "    \"sys.path.append('/home/caoren/tmp/PIRC_for_HigherOrderCausality')\\n\",\n",
    "    \"from Model.this import *\\n\",\n",
    "    \"import os\\n\",\n",
    "    \"os.chdir(\\\"/home/caoren/tmp/PIRC_for_HigherOrderCausality/Results2/EEG\\\")\\n\",\n",
    "    \"import numpy as np\\n\",\n",
    "    \"from Torch_Library import *\\n\",\n",
    "    \"from PIRC import PIRC_flatten as Nonliear_PIRC\\n\",\n",
    "    \"from Reconstruction_PIRC import *\\n\",\n",
    "    \"import numpy as np\\n\",\n",
    "    \"from itertools import combinations\\n\",\n",
    "    \"import argparse\\n\",\n",
    "    \"import math\\n\",\n",
    "    \"import numpy as np\\n\",\n",
    "    \"import matplotlib.pyplot as plt\\n\",\n",
    "    \"import pickle\\n\",\n",
    "    \"from collections import Counter\\n\",\n",
    "    \"import optuna\\n\",\n",
    "    \"optuna.logging.set_verbosity(optuna.logging.CRITICAL)\"\n",
    "   ],\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": 5\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {\n",
    "    \"jupyter\": {\n",
    "     \"is_executing\": true\n",
    "    },\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-08-26T06:50:32.574541Z\",\n",
    "     \"start_time\": \"2026-08-25T05:27:14.444469Z\"\n",
    "    }\n",
    "   },\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"# =========================\\n\",\n",
    "    \"# Tools\\n\",\n",
    "    \"# =========================\\n\",\n",
    "    \"def Causal_score(y_pred, y_true, method=\\\"exp\\\", tau=2, eps=1e-12):\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # 转成 tensor\\n\",\n",
    "    \"    y_pred = torch.as_tensor(y_pred)\\n\",\n",
    "    \"    y_true = torch.as_tensor(y_true)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # mse over time dimension only\\n\",\n",
    "    \"    mse = (y_pred - y_true).pow(2).mean(dim=-1).abs()         # (...,)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # scale: mean over time of y_true (同你原实现)\\n\",\n",
    "    \"    # scale = y_true.mean(dim=-1).abs().clamp_min(eps)          # (...,)\\n\",\n",
    "    \"    scale1 = y_true.pow(2).mean(dim=-1).abs()\\n\",\n",
    "    \"    scale2 = y_true.var(dim=-1, correction=0)# (...,)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    return torch.sqrt(mse / scale1)\\n\",\n",
    "    \"    return torch.sqrt(mse / scale2)\\n\",\n",
    "    \"def build_T_to_Ainf(T_from_Ainf, max_order=3):\\n\",\n",
    "    \"    T_to_Ainf = {o: [] for o in range(2, max_order + 1)}\\n\",\n",
    "    \"\\n\",\n",
    "    \"    row, col = T_from_Ainf.shape\\n\",\n",
    "    \"    node_num = row\\n\",\n",
    "    \"\\n\",\n",
    "    \"    for i in range(row):\\n\",\n",
    "    \"        for j in range(col):\\n\",\n",
    "    \"            val = T_from_Ainf[i, j]\\n\",\n",
    "    \"\\n\",\n",
    "    \"            if val == 0:\\n\",\n",
    "    \"                continue\\n\",\n",
    "    \"\\n\",\n",
    "    \"            if j < node_num:\\n\",\n",
    "    \"                if j != i:\\n\",\n",
    "    \"                    T_to_Ainf[2].append([i, j, val])\\n\",\n",
    "    \"\\n\",\n",
    "    \"            elif j < node_num + math.comb(node_num - 1, 2):\\n\",\n",
    "    \"                idx = j - node_num\\n\",\n",
    "    \"                others = [x for x in range(node_num) if x != i]\\n\",\n",
    "    \"                comb_list = list(combinations(others, 2))\\n\",\n",
    "    \"                j0, k0 = comb_list[idx]\\n\",\n",
    "    \"                T_to_Ainf[3].append([i, j0, k0, val])\\n\",\n",
    "    \"\\n\",\n",
    "    \"            elif max_order == 4:\\n\",\n",
    "    \"                idx = j - node_num - math.comb(node_num - 1, 2)\\n\",\n",
    "    \"                others = [x for x in range(node_num) if x != i]\\n\",\n",
    "    \"                comb_list = list(combinations(others, 3))\\n\",\n",
    "    \"                j0, k0, l0 = comb_list[idx]\\n\",\n",
    "    \"                T_to_Ainf[4].append([i, j0, k0, l0, val])\\n\",\n",
    "    \"\\n\",\n",
    "    \"    for o in T_to_Ainf:\\n\",\n",
    "    \"        T_to_Ainf[o] = (\\n\",\n",
    "    \"            np.array(T_to_Ainf[o])\\n\",\n",
    "    \"            if len(T_to_Ainf[o]) > 0\\n\",\n",
    "    \"            else np.zeros((0, o + 1))\\n\",\n",
    "    \"        )\\n\",\n",
    "    \"\\n\",\n",
    "    \"    return T_to_Ainf\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"def top_freq_per_sequence(Ainf_list, order=3, top_n=5, threshold=None):\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    每个序列：\\n\",\n",
    "    \"    1. 可选：剔除 |weight| < threshold 的边\\n\",\n",
    "    \"    2. 按 |weight| 从大到小排序\\n\",\n",
    "    \"    3. 取 top_n\\n\",\n",
    "    \"    4. 统计超边出现频率\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    all_top_edges = []\\n\",\n",
    "    \"\\n\",\n",
    "    \"    for Ainf in Ainf_list:\\n\",\n",
    "    \"        if order not in Ainf or Ainf[order].shape[0] == 0:\\n\",\n",
    "    \"            continue\\n\",\n",
    "    \"\\n\",\n",
    "    \"        edges = Ainf[order]\\n\",\n",
    "    \"        weights = np.abs(edges[:, -1])\\n\",\n",
    "    \"\\n\",\n",
    "    \"        if threshold is not None:\\n\",\n",
    "    \"            valid = weights >= threshold\\n\",\n",
    "    \"            edges = edges[valid]\\n\",\n",
    "    \"            weights = weights[valid]\\n\",\n",
    "    \"\\n\",\n",
    "    \"        if len(weights) == 0:\\n\",\n",
    "    \"            continue\\n\",\n",
    "    \"\\n\",\n",
    "    \"        k = min(top_n, len(weights))\\n\",\n",
    "    \"        idx_top = np.argsort(weights)[-k:][::-1]\\n\",\n",
    "    \"\\n\",\n",
    "    \"        top_edges = edges[idx_top, :order]\\n\",\n",
    "    \"\\n\",\n",
    "    \"        for row in top_edges:\\n\",\n",
    "    \"            row = row.astype(int)\\n\",\n",
    "    \"\\n\",\n",
    "    \"            if order == 3:\\n\",\n",
    "    \"                target = int(row[0])\\n\",\n",
    "    \"                j, k0 = sorted([int(row[1]), int(row[2])])\\n\",\n",
    "    \"                edge = (target, j, k0)\\n\",\n",
    "    \"            else:\\n\",\n",
    "    \"                edge = tuple(row)\\n\",\n",
    "    \"\\n\",\n",
    "    \"            all_top_edges.append(edge)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    return Counter(all_top_edges)\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"def high_order_ratio(Score, n=7):\\n\",\n",
    "    \"    if torch.is_tensor(Score):\\n\",\n",
    "    \"        Score = Score.detach().cpu().numpy()\\n\",\n",
    "    \"\\n\",\n",
    "    \"    Score = np.asarray(Score).copy()\\n\",\n",
    "    \"\\n\",\n",
    "    \"    for i in range(n):\\n\",\n",
    "    \"        Score[i, i] = 0.0\\n\",\n",
    "    \"\\n\",\n",
    "    \"    higher = Score[:, n:].sum()\\n\",\n",
    "    \"    total = Score.sum()\\n\",\n",
    "    \"\\n\",\n",
    "    \"    return higher / (total + 1e-12)\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"def normalize_data(X0, norm):\\n\",\n",
    "    \"    if norm == 1:\\n\",\n",
    "    \"        scale = np.mean(np.abs(X0))\\n\",\n",
    "    \"        if scale < 1e-12:\\n\",\n",
    "    \"            return None\\n\",\n",
    "    \"        return X0 / scale\\n\",\n",
    "    \"\\n\",\n",
    "    \"    elif norm == 2:\\n\",\n",
    "    \"        return (X0 - X0.mean(axis=1, keepdims=True)) / (\\n\",\n",
    "    \"            X0.std(axis=1, keepdims=True) + 1e-12\\n\",\n",
    "    \"        )\\n\",\n",
    "    \"\\n\",\n",
    "    \"    else:\\n\",\n",
    "    \"        raise ValueError(\\\"norm must be 1 or 2\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"# =========================\\n\",\n",
    "    \"# Main search\\n\",\n",
    "    \"# =========================\\n\",\n",
    "    \"\\n\",\n",
    "    \"device = torch.device(\\\"cuda:2\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"nz = 7\\n\",\n",
    "    \"subjects = list_all_subjects(109)\\n\",\n",
    "    \"states = [\\\"01\\\", \\\"02\\\"]\\n\",\n",
    "    \"\\n\",\n",
    "    \"s = np.loadtxt(\\n\",\n",
    "    \"    f\\\"../../EEG_data/eeg-data/sensors-{nz}.csv\\\",\\n\",\n",
    "    \"    dtype=str,\\n\",\n",
    "    \"    delimiter=\\\",\\\"\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"z = np.loadtxt(\\n\",\n",
    "    \"    f\\\"../../EEG_data/eeg-data/zones-{nz}.csv\\\",\\n\",\n",
    "    \"    dtype=int,\\n\",\n",
    "    \"    delimiter=\\\",\\\"\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"s2z = {s[i]: z[i] for i in range(len(s))}\\n\",\n",
    "    \"\\n\",\n",
    "    \"valid_results = []\\n\",\n",
    "    \"all_results = []\\n\",\n",
    "    \"while len(valid_results) ==0:\\n\",\n",
    "    \"    for N_train in [500]:\\n\",\n",
    "    \"\\n\",\n",
    "    \"        for I_type in [1]:\\n\",\n",
    "    \"\\n\",\n",
    "    \"            for norm in [1,2]:\\n\",\n",
    "    \"\\n\",\n",
    "    \"                print(\\\"\\\\n\\\" + \\\"=\\\" * 100)\\n\",\n",
    "    \"                print(f\\\"Running: N_train={N_train}, I_type={I_type}, norm={norm}\\\")\\n\",\n",
    "    \"                print(\\\"=\\\" * 100)\\n\",\n",
    "    \"\\n\",\n",
    "    \"                args = argparse.Namespace(\\n\",\n",
    "    \"                    dt=1 / 160,\\n\",\n",
    "    \"                    n=7,\\n\",\n",
    "    \"                    N_train=N_train,\\n\",\n",
    "    \"                    N_test=10,\\n\",\n",
    "    \"                    N_washout=0,\\n\",\n",
    "    \"                    N_start=0,\\n\",\n",
    "    \"                    norm=norm,\\n\",\n",
    "    \"                    I_type=I_type,\\n\",\n",
    "    \"                    n_trials=100\\n\",\n",
    "    \"                )\\n\",\n",
    "    \"\\n\",\n",
    "    \"                # ========= hyperparameter search =========\\n\",\n",
    "    \"                params, Win, Wres = gridSearch_PIRC(args)\\n\",\n",
    "    \"\\n\",\n",
    "    \"                n_units = params[\\\"n_units\\\"]\\n\",\n",
    "    \"                alpha = params[\\\"alpha\\\"]\\n\",\n",
    "    \"                sigma_in = params[\\\"sigma_in\\\"]\\n\",\n",
    "    \"                rho = params[\\\"rho\\\"]\\n\",\n",
    "    \"                tikh = params[\\\"tikh\\\"]\\n\",\n",
    "    \"                option = params[\\\"option\\\"]\\n\",\n",
    "    \"                tau = params[\\\"tau\\\"]\\n\",\n",
    "    \"                method = params[\\\"method\\\"]\\n\",\n",
    "    \"                connectivity = params[\\\"connectivity\\\"]\\n\",\n",
    "    \"                mode = params[\\\"mode\\\"]\\n\",\n",
    "    \"                block_dim = params[\\\"block_dim\\\"]\\n\",\n",
    "    \"                bias = params[\\\"bias\\\"]\\n\",\n",
    "    \"\\n\",\n",
    "    \"                Win = torch.as_tensor(Win, dtype=torch.float32, device=device)\\n\",\n",
    "    \"                Wres = torch.as_tensor(Wres, dtype=torch.float32, device=device)\\n\",\n",
    "    \"\\n\",\n",
    "    \"                T_need = (\\n\",\n",
    "    \"                    args.N_train\\n\",\n",
    "    \"                    + args.N_test\\n\",\n",
    "    \"                    + args.N_washout\\n\",\n",
    "    \"                    + args.N_start\\n\",\n",
    "    \"                    + 1\\n\",\n",
    "    \"                )\\n\",\n",
    "    \"\\n\",\n",
    "    \"                Loss = []\\n\",\n",
    "    \"                Score_all = []\\n\",\n",
    "    \"                Score_01 = []\\n\",\n",
    "    \"                Score_02 = []\\n\",\n",
    "    \"\\n\",\n",
    "    \"                # ========= evaluate all subjects =========\\n\",\n",
    "    \"                for su in subjects:\\n\",\n",
    "    \"\\n\",\n",
    "    \"                    for st in states:\\n\",\n",
    "    \"\\n\",\n",
    "    \"                        key = f\\\"S{su}R{st}\\\"\\n\",\n",
    "    \"                        file = (\\n\",\n",
    "    \"                            f\\\"../../EEG_data/physionet.org/files/eegmmidb/1.0.0/\\\"\\n\",\n",
    "    \"                            f\\\"S{su}/{key}.edf\\\"\\n\",\n",
    "    \"                        )\\n\",\n",
    "    \"\\n\",\n",
    "    \"                        try:\\n\",\n",
    "    \"                            s2signal = read_eeg(file)\\n\",\n",
    "    \"                        except Exception as e:\\n\",\n",
    "    \"                            print(f\\\"[Skip] {key}: read error: {e}\\\")\\n\",\n",
    "    \"                            continue\\n\",\n",
    "    \"\\n\",\n",
    "    \"                        asig = average_over_zones(s2signal, s2z)\\n\",\n",
    "    \"\\n\",\n",
    "    \"                        tmp = np.max(np.abs(asig), axis=0)\\n\",\n",
    "    \"                        valid_idx = np.where(tmp > 1e-6)[0]\\n\",\n",
    "    \"\\n\",\n",
    "    \"                        if len(valid_idx) == 0:\\n\",\n",
    "    \"                            print(f\\\"[Skip] {key}: no valid signal\\\")\\n\",\n",
    "    \"                            continue\\n\",\n",
    "    \"\\n\",\n",
    "    \"                        start, end = valid_idx[0], valid_idx[-1]\\n\",\n",
    "    \"\\n\",\n",
    "    \"                        X0 = denoise_fourier(asig[:, start:end + 1], 100)\\n\",\n",
    "    \"\\n\",\n",
    "    \"                        if X0.shape[1] < T_need:\\n\",\n",
    "    \"                            print(\\n\",\n",
    "    \"                                f\\\"[Skip] {key}: length {X0.shape[1]} < T_need {T_need}\\\"\\n\",\n",
    "    \"                            )\\n\",\n",
    "    \"                            continue\\n\",\n",
    "    \"\\n\",\n",
    "    \"                        X0 = normalize_data(X0, norm=args.norm)\\n\",\n",
    "    \"\\n\",\n",
    "    \"                        if X0 is None:\\n\",\n",
    "    \"                            print(f\\\"[Skip] {key}: normalization failed\\\")\\n\",\n",
    "    \"                            continue\\n\",\n",
    "    \"\\n\",\n",
    "    \"                        X_np = X0[:, :T_need]\\n\",\n",
    "    \"\\n\",\n",
    "    \"                        X = torch.as_tensor(\\n\",\n",
    "    \"                            X_np,\\n\",\n",
    "    \"                            device=device,\\n\",\n",
    "    \"                            dtype=torch.float32\\n\",\n",
    "    \"                        ).T\\n\",\n",
    "    \"\\n\",\n",
    "    \"                        X_batch = torch.stack(\\n\",\n",
    "    \"                            [shift_column_to_first(X, i) for i in range(args.n)],\\n\",\n",
    "    \"                            dim=0\\n\",\n",
    "    \"                        )\\n\",\n",
    "    \"\\n\",\n",
    "    \"                        X_washout, X_train, Y_train, Y_test = split_dataset2_batch(\\n\",\n",
    "    \"                            X_batch,\\n\",\n",
    "    \"                            args.N_washout,\\n\",\n",
    "    \"                            args.N_train,\\n\",\n",
    "    \"                            args.N_test,\\n\",\n",
    "    \"                            in_dim=args.n,\\n\",\n",
    "    \"                            out_dim=args.n\\n\",\n",
    "    \"                        )\\n\",\n",
    "    \"\\n\",\n",
    "    \"                        pirc = Nonliear_PIRC(\\n\",\n",
    "    \"                            n_units=n_units,\\n\",\n",
    "    \"                            in_dim=args.n,\\n\",\n",
    "    \"                            out_dim=args.n,\\n\",\n",
    "    \"                            Win=Win.clone(),\\n\",\n",
    "    \"                            Wres=Wres.clone(),\\n\",\n",
    "    \"                            Expand=1,\\n\",\n",
    "    \"                            sigma_in=sigma_in,\\n\",\n",
    "    \"                            rho=rho,\\n\",\n",
    "    \"                            alpha=alpha,\\n\",\n",
    "    \"                            tikh=tikh,\\n\",\n",
    "    \"                            mode=mode,\\n\",\n",
    "    \"                            block_dim=block_dim,\\n\",\n",
    "    \"                            I_type=args.I_type,\\n\",\n",
    "    \"                            option=option,\\n\",\n",
    "    \"                            device=device,\\n\",\n",
    "    \"                            dt=args.dt,\\n\",\n",
    "    \"                            bias=bias\\n\",\n",
    "    \"                        )\\n\",\n",
    "    \"\\n\",\n",
    "    \"                        R, _ = pirc.train(X_washout, X_train, Y_train)\\n\",\n",
    "    \"\\n\",\n",
    "    \"                        Y_test_predict = pirc.Prediction2(\\n\",\n",
    "    \"                            R,\\n\",\n",
    "    \"                            args.N_test,\\n\",\n",
    "    \"                            Y_train,\\n\",\n",
    "    \"                            Y_test\\n\",\n",
    "    \"                        )\\n\",\n",
    "    \"\\n\",\n",
    "    \"                        base_all = Y_test_predict[0, :, :args.N_test, 0]\\n\",\n",
    "    \"                        others_all = Y_test_predict[2:, :, :args.N_test, 0]\\n\",\n",
    "    \"                        target = Y_test[:, :, 0]\\n\",\n",
    "    \"\\n\",\n",
    "    \"                        total_mse = (base_all - target).pow(2).mean()\\n\",\n",
    "    \"                        Loss.append(total_mse.item())\\n\",\n",
    "    \"\\n\",\n",
    "    \"                        base_expand = base_all.unsqueeze(0).expand_as(others_all)\\n\",\n",
    "    \"\\n\",\n",
    "    \"                        score_EN = Causal_score(\\n\",\n",
    "    \"                            others_all,\\n\",\n",
    "    \"                            base_expand,\\n\",\n",
    "    \"                            method=method,\\n\",\n",
    "    \"                            tau=tau\\n\",\n",
    "    \"                        )\\n\",\n",
    "    \"\\n\",\n",
    "    \"                        Score = score_EN.transpose(0, 1).contiguous()\\n\",\n",
    "    \"                        Score = shift_column_for_Causal_Matrix(Score)\\n\",\n",
    "    \"                        Score = Score.detach().cpu()\\n\",\n",
    "    \"\\n\",\n",
    "    \"                        Score_all.append(Score)\\n\",\n",
    "    \"\\n\",\n",
    "    \"                        if st == \\\"01\\\":\\n\",\n",
    "    \"                            Score_01.append(Score)\\n\",\n",
    "    \"                        else:\\n\",\n",
    "    \"                            Score_02.append(Score)\\n\",\n",
    "    \"\\n\",\n",
    "    \"                if len(Loss) == 0 or len(Score_all) == 0:\\n\",\n",
    "    \"                    print(\\\"[Warning] no valid results for this setting\\\")\\n\",\n",
    "    \"                    continue\\n\",\n",
    "    \"\\n\",\n",
    "    \"                mean_loss = float(np.mean(Loss))\\n\",\n",
    "    \"\\n\",\n",
    "    \"                Ainf_PIRC_list = [\\n\",\n",
    "    \"                    build_T_to_Ainf(\\n\",\n",
    "    \"                        Score.detach().cpu().numpy()\\n\",\n",
    "    \"                        if torch.is_tensor(Score)\\n\",\n",
    "    \"                        else np.asarray(Score),\\n\",\n",
    "    \"                        max_order=3\\n\",\n",
    "    \"                    )\\n\",\n",
    "    \"                    for Score in Score_all\\n\",\n",
    "    \"                ]\\n\",\n",
    "    \"\\n\",\n",
    "    \"                top_select = 10\\n\",\n",
    "    \"\\n\",\n",
    "    \"                freq_PIRC = top_freq_per_sequence(\\n\",\n",
    "    \"                    Ainf_PIRC_list,\\n\",\n",
    "    \"                    order=3,\\n\",\n",
    "    \"                    top_n=top_select,\\n\",\n",
    "    \"                    threshold=None\\n\",\n",
    "    \"                )\\n\",\n",
    "    \"\\n\",\n",
    "    \"                top5_edges = freq_PIRC.most_common(5)\\n\",\n",
    "    \"\\n\",\n",
    "    \"                rho_all = np.array([\\n\",\n",
    "    \"                    high_order_ratio(S, n=7)\\n\",\n",
    "    \"                    for S in Score_all\\n\",\n",
    "    \"                ])\\n\",\n",
    "    \"\\n\",\n",
