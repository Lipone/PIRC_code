    "    \"        plt.vlines(i, vals.min(), vals.max(), color=\\\"black\\\", linewidth=1.5, zorder=1)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    plt.xticks(range(1, len(xlabels) + 1), xlabels, fontsize=12)\\n\",\n",
    "    \"    plt.ylabel(r\\\"$\\\\rho$\\\", fontsize=14)\\n\",\n",
