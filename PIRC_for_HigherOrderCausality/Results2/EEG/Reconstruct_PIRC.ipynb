    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"from collections import Counter\\n\",\n",
    "    \"import numpy as np\\n\",\n",
    "    \"\\n\",\n",
    "    \"def top_freq_per_sequence(\\n\",\n",
    "    \"    Ainf_list,\\n\",\n",
    "    \"    threshold,\\n\",\n",
    "    \"    order=3,\\n\",\n",
    "    \"    top_n=5,\\n\",\n",
    "    \"):\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    统计每个序列中:\\n\",\n",
    "    \"        1. 去掉 |weight| < threshold 的边\\n\",\n",
    "    \"        2. 在剩余边中取 Top N\\n\",\n",
    "    \"        3. 统计出现频率\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"\\n\",\n",
    "    \"    all_top_edges = []\\n\",\n",
    "    \"\\n\",\n",
    "    \"    for Ainf in Ainf_list:\\n\",\n",
    "    \"\\n\",\n",
    "    \"        if order not in Ainf or len(Ainf[order]) == 0:\\n\",\n",
    "    \"            continue\\n\",\n",
    "    \"\\n\",\n",
    "    \"        edges = Ainf[order]\\n\",\n",
    "    \"\\n\",\n",
    "    \"        # 权重\\n\",\n",
    "    \"        weights = np.abs(edges[:, -1])\\n\",\n",
    "    \"\\n\",\n",
    "    \"        # ---------- 去掉低于阈值 ----------\\n\",\n",
    "    \"        valid = weights >= threshold\\n\",\n",
    "    \"\\n\",\n",
    "    \"        if np.sum(valid) == 0:\\n\",\n",
    "    \"            continue\\n\",\n",
    "    \"\\n\",\n",
    "    \"        edges = edges[valid]\\n\",\n",
    "    \"        weights = weights[valid]\\n\",\n",
    "    \"\\n\",\n",
    "    \"        # ---------- Top N ----------\\n\",\n",
    "    \"        k = min(top_n, len(weights))\\n\",\n",
    "    \"\\n\",\n",
    "    \"        idx_top = np.argsort(weights)[-k:][::-1]\\n\",\n",
    "    \"\\n\",\n",
    "    \"        top_edges = edges[idx_top, :order]\\n\",\n",
    "    \"\\n\",\n",
    "    \"        all_top_edges.extend(\\n\",\n",
    "    \"            [tuple(row.astype(int)) for row in top_edges]\\n\",\n",
    "    \"        )\\n\",\n",
    "    \"\\n\",\n",
    "    \"    return Counter(all_top_edges)\\n\",\n",
    "    \"\\n\",\n",
    "    \"Ainf_PIRC_list = [\\n\",\n",
    "    \"    build_T_to_Ainf(Score.detach().cpu().numpy(), 3)\\n\",\n",
    "    \"    for Score in Score_all\\n\",\n",
    "    \"]\\n\",\n",
    "    \"\\n\",\n",
    "    \"freq_PIRC = top_freq_per_sequence(\\n\",\n",
    "    \"    Ainf_PIRC_list,\\n\",\n",
    "    \"    threshold=0.1,   # KMeans得到的阈值\\n\",\n",
    "    \"    order=3,\\n\",\n",
    "    \"    top_n=5\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(freq_PIRC.most_common())\"\n",
    "   ],\n",
