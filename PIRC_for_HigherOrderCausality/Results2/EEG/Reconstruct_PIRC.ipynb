    "    \"\\n\",\n",
    "    \"    x_raw = score[mask]\\n\",\n",
    "    \"    x_raw = x_raw[np.isfinite(x_raw)]\\n\",\n",
    "    \"\\n\",\n",
    "    \"    low = np.percentile(x_raw, trim_percent)\\n\",\n",
    "    \"    high = np.percentile(x_raw, 100 - trim_percent)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    x_trim = x_raw[(x_raw >= low) & (x_raw <= high)]\\n\",\n",
    "    \"\\n\",\n",
    "    \"    km = KMeans(\\n\",\n",
    "    \"        n_clusters=2,\\n\",\n",
    "    \"        random_state=random_state,\\n\",\n",
    "    \"        n_init=20\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"\\n\",\n",
    "    \"    labels_trim = km.fit_predict(x_trim.reshape(-1, 1))\\n\",\n",
    "    \"    centers = km.cluster_centers_.flatten()\\n\",\n",
    "    \"\\n\",\n",
    "    \"    low_id, high_id = np.argsort(centers)\\n\",\n",
    "    \"    c_low, c_high = np.sort(centers)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    threshold = (c_low + c_high) / 2\\n\",\n",
    "    \"\\n\",\n",
    "    \"    no_causal = labels_trim == low_id\\n\",\n",
    "    \"    causal = labels_trim == high_id\\n\",\n",
    "    \"\\n\",\n",
    "    \"    range_left = x_trim[no_causal].max()\\n\",\n",
    "    \"    range_right = x_trim[causal].min()\\n\",\n",
    "    \"\\n\",\n",
    "    \"    rng = np.random.default_rng(random_state)\\n\",\n",
    "    \"    jitter = rng.normal(0, 1.25, size=len(x_trim))\\n\",\n",
    "    \"\\n\",\n",
    "    \"    fig, ax = plt.subplots(figsize=(5, 4), dpi=1200)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    ax.axvspan(\\n\",\n",
    "    \"        range_left,\\n\",\n",
