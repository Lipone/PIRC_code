    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"def to_numpy(x):\\n\",\n",
    "    \"    if torch.is_tensor(x):\\n\",\n",
    "    \"        return x.detach().cpu().numpy()\\n\",\n",
