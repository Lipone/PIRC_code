    "   \"source\": [\n",
    "    \"from collections import Counter\\n\",\n",
    "    \"import numpy as np\\n\",\n",
    "    \"import math\\n\",\n",
    "    \"\\n\",\n",
    "    \"def top_percent_freq_per_sequence(Ainf_list, order=3, top_percent=0.10):\\n\",\n",
    "    \"    all_top_edges = []\\n\",\n",
    "    \"\\n\",\n",
    "    \"    for seq_idx, Ainf in enumerate(Ainf_list):\\n\",\n",
    "    \"        if order not in Ainf or Ainf[order].shape[0] == 0:\\n\",\n",
    "    \"            continue\\n\",\n",
    "    \"\\n\",\n",
    "    \"        edges = Ainf[order]\\n\",\n",
    "    \"        weights = np.abs(edges[:, -1])\\n\",\n",
    "    \"\\n\",\n",
    "    \"        M = len(weights)\\n\",\n",
    "    \"        k = max(1, int(np.ceil(top_percent * M)))\\n\",\n",
    "    \"\\n\",\n",
    "    \"        idx_top = np.argsort(weights)[-k:][::-1]\\n\",\n",
    "    \"\\n\",\n",
    "    \"        for row in edges[idx_top]:\\n\",\n",
    "    \"            idx = row[:order].astype(int)\\n\",\n",
    "    \"\\n\",\n",
    "    \"            if order == 3:\\n\",\n",
    "    \"                target = int(idx[0])\\n\",\n",
    "    \"                j, k0 = sorted([int(idx[1]), int(idx[2])])\\n\",\n",
    "    \"                edge = (target, j, k0)\\n\",\n",
    "    \"            else:\\n\",\n",
    "    \"                edge = tuple(idx)\\n\",\n",
    "    \"\\n\",\n",
    "    \"            all_top_edges.append(edge)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    counter = Counter(all_top_edges)\\n\",\n",
    "    \"    return counter\\n\",\n",
    "    \"Ainf_PIRC_list = [\\n\",\n",
    "    \"    build_T_to_Ainf(Score.detach().cpu().numpy(), 3)\\n\",\n",
    "    \"    for Score in Score_all\\n\",\n",
    "    \"]\\n\",\n",
    "    \"\\n\",\n",
