    "  {\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-07-08T07:15:03.002036Z\",\n",
    "     \"start_time\": \"2026-07-08T07:14:17.096599Z\"\n",
    "    }\n",
    "   },\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"args = argparse.Namespace(\\n\",\n",
    "    \"        dt=1 / 160,\\n\",\n",
    "    \"        n=7,\\n\",\n",
    "    \"        N_train=N_train,\\n\",\n",
    "    \"        N_test=10,\\n\",\n",
    "    \"        N_washout=0,\\n\",\n",
    "    \"        N_start=0,\\n\",\n",
    "    \"        norm=norm,\\n\",\n",
    "    \"        I_type=I_type,\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"Test_results = valid_results[0]\\n\",\n",
    "    \"I_type=Test_results[\\\"I_type\\\"]\\n\",\n",
    "    \"N_train=Test_results[\\\"N_train\\\"]\\n\",\n",
    "    \"norm=Test_results[\\\"norm\\\"]\\n\",\n",
    "    \"Win=Test_results[\\\"Win\\\"]\\n\",\n",
    "    \"Win=torch.as_tensor(Win, dtype=torch.float32, device=device)\\n\",\n",
    "    \"Wres=Test_results[\\\"Wres\\\"]\\n\",\n",
    "    \"Wres=torch.as_tensor(Wres, dtype=torch.float32, device=device)\\n\",\n",
    "    \"params=Test_results[\\\"params\\\"]\\n\",\n",
    "    \"n_units = params[\\\"n_units\\\"]\\n\",\n",
    "    \"block_dim = params[\\\"block_dim\\\"]\\n\",\n",
    "    \"connectivity=params[\\\"connectivity\\\"]\\n\",\n",
    "    \"\\n\",\n",
    "    \"ExpandNodes = args.n + math.comb(args.n - 1, 2)\\n\",\n",
    "    \"# Win, Wres = Random_Win_Fixed_Wres(\\n\",\n",
    "    \"#     ExpandNodes + 1, n_units, device,\\n\",\n",
    "    \"#     block_dim=block_dim, connectivity=connectivity\\n\",\n",
    "    \"# )\\n\",\n",
    "    \"\\n\",\n",
    "    \"nz = 7  # scalp zones\\n\",\n",
    "    \"subjects = list_all_subjects(109)\\n\",\n",
    "    \"states = [\\\"01\\\", \\\"02\\\"]  # resting\\n\",\n",
    "    \"s = np.loadtxt(f\\\"../../EEG_data/eeg-data/sensors-{nz}.csv\\\", dtype=str, delimiter=\\\",\\\")\\n\",\n",
    "    \"z = np.loadtxt(f\\\"../../EEG_data/eeg-data/zones-{nz}.csv\\\", dtype=int, delimiter=\\\",\\\")\\n\",\n",
    "    \"s2z = {s[i]: z[i] for i in range(len(s))}\\n\",\n",
    "    \"Score_all=[]\\n\",\n",
    "    \"Score_01=[]\\n\",\n",
    "    \"Score_02=[]\\n\",\n",
    "    \"Loss=[]\\n\",\n",
    "    \"T_need = (\\n\",\n",
    "    \"    args.N_train\\n\",\n",
    "    \"    + args.N_test\\n\",\n",
    "    \"    + args.N_washout\\n\",\n",
    "    \"    + args.N_start\\n\",\n",
    "    \"    + 1\\n\",\n",
    "    \")\\n\",\n",
    "    \"for su in subjects:\\n\",\n",
    "    \"    for st in states:\\n\",\n",
    "    \"        key = f\\\"S{su}R{st}\\\"\\n\",\n",
    "    \"        file = f\\\"../../EEG_data/physionet.org/files/eegmmidb/1.0.0/S{su}/{key}.edf\\\"\\n\",\n",
    "    \"        s2signal = read_eeg(file)\\n\",\n",
    "    \"        asig = average_over_zones(s2signal, s2z)\\n\",\n",
    "    \"\\n\",\n",
    "    \"        tmp = np.max(np.abs(asig), axis=0)\\n\",\n",
    "    \"        valid_idx = np.where(tmp > 1e-6)[0]\\n\",\n",
    "    \"        if len(valid_idx) == 0:\\n\",\n",
    "    \"            continue\\n\",\n",
    "    \"        if np.all(np.diff(valid_idx) == 1):\\n\",\n",
    "    \"            pass\\n\",\n",
    "    \"        else:\\n\",\n",
    "    \"            print(\\\"不连续\\\")\\n\",\n",
    "    \"        start, end = valid_idx[0], valid_idx[-1]\\n\",\n",
    "    \"\\n\",\n",
    "    \"        X0 = denoise_fourier(asig[:, start:end + 1], 100)\\n\",\n",
    "    \"        # X0 = X0 / np.mean(np.abs(X0))\\n\",\n",
    "    \"        X0 = normalize_data(X0, norm=args.norm)\\n\",\n",
    "    \"        X_np = X0[:, :T_need]\\n\",\n",
    "    \"\\n\",\n",
    "    \"        X = torch.as_tensor(\\n\",\n",
    "    \"            X_np,\\n\",\n",
    "    \"            device=device,\\n\",\n",
    "    \"            dtype=torch.float32\\n\",\n",
    "    \"        ).T\\n\",\n",
    "    \"\\n\",\n",
    "    \"        X_batch = torch.stack(\\n\",\n",
    "    \"            [shift_column_to_first(X, i) for i in range(args.n)],\\n\",\n",
    "    \"            dim=0\\n\",\n",
    "    \"        )\\n\",\n",
    "    \"\\n\",\n",
    "    \"        X_washout, X_train, Y_train, Y_test = split_dataset2_batch(\\n\",\n",
    "    \"            X_batch,\\n\",\n",
    "    \"            args.N_washout,\\n\",\n",
    "    \"            args.N_train,\\n\",\n",
    "    \"            args.N_test,\\n\",\n",
    "    \"            in_dim=args.n,\\n\",\n",
    "    \"            out_dim=args.n\\n\",\n",
    "    \"        )\\n\",\n",
    "    \"\\n\",\n",
    "    \"        pirc = Nonliear_PIRC(\\n\",\n",
    "    \"            n_units=params[\\\"n_units\\\"],\\n\",\n",
    "    \"            in_dim=args.n,\\n\",\n",
    "    \"            out_dim=args.n,\\n\",\n",
    "    \"            Win=Win,\\n\",\n",
    "    \"            Wres=Wres,\\n\",\n",
    "    \"            Expand=1,\\n\",\n",
    "    \"            sigma_in=params[\\\"sigma_in\\\"],\\n\",\n",
    "    \"            rho=params[\\\"rho\\\"],\\n\",\n",
    "    \"            alpha=params[\\\"alpha\\\"],\\n\",\n",
    "    \"            tikh=params[\\\"tikh\\\"],\\n\",\n",
    "    \"            mode=params[\\\"mode\\\"],\\n\",\n",
    "    \"            block_dim=params[\\\"block_dim\\\"],\\n\",\n",
    "    \"            I_type=args.I_type,\\n\",\n",
    "    \"            option=params[\\\"option\\\"],\\n\",\n",
    "    \"            device=device,\\n\",\n",
    "    \"            dt= args.dt,\\n\",\n",
    "    \"            bias=params[\\\"bias\\\"],\\n\",\n",
    "    \"        )\\n\",\n",
    "    \"        R, _ = pirc.train(X_washout, X_train, Y_train)\\n\",\n",
    "    \"        if params[\\\"mode\\\"] == 1:\\n\",\n",
    "    \"            Y_test_predict = pirc.Prediction(R, args.N_test, Y_train, Y_test)\\n\",\n",
    "    \"        else:\\n\",\n",
    "    \"            Y_test_predict = pirc.Prediction2(R, args.N_test, Y_train, Y_test)\\n\",\n",
    "    \"        base_all = Y_test_predict[0, :, :args.N_test, 0]  # (B, T_test)\\n\",\n",
    "    \"        others_all = Y_test_predict[2: , :, :args.N_test, 0]  # others: (E, B, T)\\n\",\n",
    "    \"        target = Y_test[:, :, 0]\\n\",\n",
    "    \"        total_mse = (base_all - target).pow(2).mean()\\n\",\n",
    "    \"        Loss.append(total_mse.item())\\n\",\n",
    "    \"\\n\",\n",
    "    \"        base_expand = base_all.unsqueeze(0).expand_as(others_all)\\n\",\n",
    "    \"        score_EN = score_0_1_torch(\\n\",\n",
    "    \"        others_all,\\n\",\n",
    "    \"        base_expand,\\n\",\n",
    "    \"        method=params[\\\"method\\\"],\\n\",\n",
    "    \"        tau=params[\\\"tau\\\"])# (E, B, T)\\n\",\n",
    "    \"        Score = score_EN.transpose(0, 1).contiguous()  # (B, E)\\n\",\n",
    "    \"        Score = shift_column_for_Causal_Matrix(Score)\\n\",\n",
    "    \"        Score = Score.detach().cpu()\\n\",\n",
    "    \"        Score_all.append(Score)\\n\",\n",
    "    \"        if st == \\\"01\\\":\\n\",\n",
    "    \"            Score_01.append(Score)\\n\",\n",
    "    \"        else:\\n\",\n",
    "    \"            Score_02.append(Score)\\n\",\n",
    "    \"\\n\",\n",
    "    \"mean_loss = np.mean(Loss)\\n\",\n",
    "    \"print(f\\\"Average Loss: {mean_loss:.6f}\\\")\\n\",\n",
    "    \"mean_loss = float(np.mean(Loss))\\n\",\n",
    "    \"\\n\",\n",
    "    \"Ainf_PIRC_list = [\\n\",\n",
    "    \"    build_T_to_Ainf(\\n\",\n",
    "    \"        Score.detach().cpu().numpy()\\n\",\n",
    "    \"        if torch.is_tensor(Score)\\n\",\n",
    "    \"        else np.asarray(Score),\\n\",\n",
    "    \"        max_order=3\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"    for Score in Score_all\\n\",\n",
    "    \"]\\n\",\n",
    "    \"\\n\",\n",
    "    \"top_select = 5\\n\",\n",
    "    \"\\n\",\n",
    "    \"freq_PIRC = top_freq_per_sequence(\\n\",\n",
    "    \"    Ainf_PIRC_list,\\n\",\n",
    "    \"    order=3,\\n\",\n",
    "    \"    top_n=top_select,\\n\",\n",
    "    \"    threshold=None\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"top5_edges = freq_PIRC.most_common(5)\\n\",\n",
    "    \"\\n\",\n",
    "    \"rho_all = np.array([\\n\",\n",
    "    \"    high_order_ratio(S, n=7)\\n\",\n",
    "    \"    for S in Score_all\\n\",\n",
    "    \"])\\n\",\n",
    "    \"\\n\",\n",
    "    \"rho_mean = float(rho_all.mean())\\n\",\n",
    "    \"rho_std = float(rho_all.std())\\n\",\n",
    "    \"\\n\",\n",
    "    \"top5_all_target0 = (\\n\",\n",
    "    \"    len(top5_edges) >= 5\\n\",\n",
    "    \"    and all(edge[0] == 0 for edge, count in top5_edges)\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(f\\\"Average Loss: {mean_loss:.6f}\\\")\\n\",\n",
    "    \"print(f\\\"rho_all: {rho_mean:.4f} ± {rho_std:.4f}\\\")\\n\",\n",
    "    \"print(\\\"Top5:\\\", top5_edges)\\n\",\n",
    "    \"print(\\\"Top5 all target 0:\\\", top5_all_target0)\\n\",\n",
    "    \"\\n\",\n",
    "    \"save_dict = {\\n\",\n",
    "    \"    \\\"rho_all\\\": rho_all,\\n\",\n",
    "    \"    \\\"rho_mean\\\": rho_mean,\\n\",\n",
    "    \"    \\\"rho_std\\\": rho_std,\\n\",\n",
    "    \"    \\\"Score_all\\\":Score_all\\n\",\n",
    "    \"}\\n\",\n",
    "    \"\\n\",\n",
    "    \"with open(\\\"PIRC_result.pkl\\\", \\\"wb\\\") as f:\\n\",\n",
    "    \"    pickle.dump(save_dict, f)\\n\",\n",
    "    \"print(\\\"Saved to PIRC_result.pkl\\\")\"\n",
    "   ],\n",
