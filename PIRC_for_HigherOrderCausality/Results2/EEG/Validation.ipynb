    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"with open(\\\"search_target0_results.pkl\\\", \\\"rb\\\") as f:\\n\",\n",
    "    \"    data = pickle.load(f)\\n\",\n",
    "    \"device = torch.device(\\\"cuda:2\\\")\\n\",\n",
    "    \"all_results = data[\\\"all_results\\\"]\\n\",\n",
    "    \"valid_results = data[\\\"valid_results\\\"]\"\n",
    "   ],\n",
