    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"import numpy as np\\n\",\n",
    "    \"import torch\\n\",\n",
    "    \"import matplotlib.pyplot as plt\\n\",\n",
    "    \"\\n\",\n",
    "    \"def to_numpy(x):\\n\",\n",
    "    \"    if isinstance(x, torch.Tensor):\\n\",\n",
    "    \"        return x.detach().cpu().numpy()\\n\",\n",
    "    \"    return np.asarray(x)\\n\",\n",
    "    \"\\n\",\n",
    "    \"def row_high_order_ratio(Score, n=7, ignore_diag=True):\\n\",\n",
    "    \"    S = to_numpy(Score).copy()\\n\",\n",
    "    \"\\n\",\n",
    "    \"    if ignore_diag:\\n\",\n",
    "    \"        np.fill_diagonal(S[:, :n], 0)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    pair = S[:, :n].sum(axis=1)\\n\",\n",
    "    \"    higher = S[:, n:].sum(axis=1)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    return higher / (pair + higher + 1e-12)\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"def plot_scoreall_percentile_box(Score_all, labels=None, n=7):\\n\",\n",
    "    \"\\n\",\n",
    "    \"    rho_list = [row_high_order_ratio(S, n=n) for S in Score_all]\\n\",\n",
    "    \"\\n\",\n",
    "    \"    rho_all = np.concatenate(rho_list)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    medians = np.array([np.median(rho) for rho in rho_list])\\n\",\n",
    "    \"\\n\",\n",
    "    \"    percentiles = [5, 35, 65, 95]\\n\",\n",
    "    \"    selected_idx = []\\n\",\n",
    "    \"\\n\",\n",
    "    \"    for p in percentiles:\\n\",\n",
    "    \"        target = np.percentile(medians, p)\\n\",\n",
    "    \"        idx = np.argmin(np.abs(medians - target))\\n\",\n",
    "    \"        selected_idx.append(idx)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    data_plot = [rho_all] + [rho_list[idx] for idx in selected_idx]\\n\",\n",
    "    \"    xlabels = [\\\"All\\\"] + [f\\\"{p}%\\\" for p in percentiles]\\n\",\n",
    "    \"\\n\",\n",
    "    \"    colors = [\\\"#3E3A5E\\\", \\\"#C65392\\\", \\\"#EF5C82\\\", \\\"#FF7F73\\\", \\\"#F4A272\\\"]\\n\",\n",
    "    \"\\n\",\n",
    "    \"    fig, ax = plt.subplots(figsize=(8, 4))\\n\",\n",
    "    \"\\n\",\n",
    "    \"    bp = ax.boxplot(\\n\",\n",
    "    \"        data_plot,\\n\",\n",
    "    \"        patch_artist=True,\\n\",\n",
    "    \"        widths=0.55,\\n\",\n",
    "    \"        showfliers=False,\\n\",\n",
    "    \"        showmeans=True,\\n\",\n",
    "    \"        meanprops=dict(\\n\",\n",
    "    \"            marker='o',\\n\",\n",
    "    \"            markerfacecolor='black',\\n\",\n",
    "    \"            markeredgecolor='black',\\n\",\n",
    "    \"            markersize=5\\n\",\n",
    "    \"        ),\\n\",\n",
    "    \"        medianprops=dict(color='black', linewidth=2),\\n\",\n",
    "    \"        whiskerprops=dict(color='black', linewidth=1.3),\\n\",\n",
    "    \"        capprops=dict(color='black', linewidth=1.3),\\n\",\n",
    "    \"        boxprops=dict(edgecolor='black', linewidth=1.3)\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"\\n\",\n",
    "    \"    for patch, c in zip(bp[\\\"boxes\\\"], colors):\\n\",\n",
    "    \"        patch.set_facecolor(c)\\n\",\n",
    "    \"        patch.set_alpha(0.9)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    ax.set_xticks(range(1, len(xlabels) + 1))\\n\",\n",
    "    \"    ax.set_xticklabels(xlabels, fontsize=12)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    ax.set_ylabel(r\\\"$\\\\rho$\\\", fontsize=14)\\n\",\n",
    "    \"    ax.set_xlabel(\\\"Percentile\\\", fontsize=14)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    ax.set_ylim(0, 1.05)\\n\",\n",
    "    \"    ax.grid(axis=\\\"y\\\", alpha=0.25)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    if labels is not None:\\n\",\n",
    "    \"        for xpos, idx in enumerate(selected_idx, start=2):\\n\",\n",
    "    \"            ax.text(\\n\",\n",
    "    \"                xpos,\\n\",\n",
    "    \"                1.02,\\n\",\n",
    "    \"                labels[idx],\\n\",\n",
    "    \"                ha=\\\"center\\\",\\n\",\n",
    "    \"                va=\\\"bottom\\\",\\n\",\n",
    "    \"                fontsize=9\\n\",\n",
    "    \"            )\\n\",\n",
    "    \"\\n\",\n",
    "    \"    plt.tight_layout()\\n\",\n",
    "    \"    plt.show()\\n\",\n",
    "    \"\\n\",\n",
    "    \"    return {\\n\",\n",
    "    \"        \\\"rho_list\\\": rho_list,\\n\",\n",
    "    \"        \\\"rho_all\\\": rho_all,\\n\",\n",
    "    \"        \\\"medians\\\": medians,\\n\",\n",
    "    \"        \\\"selected_idx\\\": selected_idx,\\n\",\n",
    "    \"        \\\"selected_percentiles\\\": percentiles,\\n\",\n",
    "    \"    }\\n\",\n",
    "    \"\\n\",\n",
    "    \"out = plot_scoreall_percentile_box(\\n\",\n",
    "    \"    Score_all,\\n\",\n",
    "    \"    labels=None,\\n\",\n",
    "    \"    n=7\\n\",\n",
    "    \")\"\n",
    "   ],\n",
