    "  {\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-08-25T05:18:17.514015Z\",\n",
    "     \"start_time\": \"2026-08-25T05:18:17.492934Z\"\n",
    "    }\n",
    "   },\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"# =========================\\n\",\n",
    "    \"# Tools\\n\",\n",
    "    \"# =========================\\n\",\n",
    "    \"\\n\",\n",
    "    \"def build_T_to_Ainf(T_from_Ainf, max_order=3):\\n\",\n",
    "    \"    T_to_Ainf = {o: [] for o in range(2, max_order + 1)}\\n\",\n",
    "    \"\\n\",\n",
    "    \"    row, col = T_from_Ainf.shape\\n\",\n",
    "    \"    node_num = row\\n\",\n",
    "    \"\\n\",\n",
    "    \"    for i in range(row):\\n\",\n",
    "    \"        for j in range(col):\\n\",\n",
    "    \"            val = T_from_Ainf[i, j]\\n\",\n",
    "    \"\\n\",\n",
    "    \"            if val == 0:\\n\",\n",
    "    \"                continue\\n\",\n",
    "    \"\\n\",\n",
    "    \"            if j < node_num:\\n\",\n",
    "    \"                if j != i:\\n\",\n",
    "    \"                    T_to_Ainf[2].append([i, j, val])\\n\",\n",
    "    \"\\n\",\n",
    "    \"            elif j < node_num + math.comb(node_num - 1, 2):\\n\",\n",
    "    \"                idx = j - node_num\\n\",\n",
    "    \"                others = [x for x in range(node_num) if x != i]\\n\",\n",
    "    \"                comb_list = list(combinations(others, 2))\\n\",\n",
    "    \"                j0, k0 = comb_list[idx]\\n\",\n",
    "    \"                T_to_Ainf[3].append([i, j0, k0, val])\\n\",\n",
    "    \"\\n\",\n",
    "    \"            elif max_order == 4:\\n\",\n",
    "    \"                idx = j - node_num - math.comb(node_num - 1, 2)\\n\",\n",
    "    \"                others = [x for x in range(node_num) if x != i]\\n\",\n",
    "    \"                comb_list = list(combinations(others, 3))\\n\",\n",
    "    \"                j0, k0, l0 = comb_list[idx]\\n\",\n",
    "    \"                T_to_Ainf[4].append([i, j0, k0, l0, val])\\n\",\n",
    "    \"\\n\",\n",
    "    \"    for o in T_to_Ainf:\\n\",\n",
    "    \"        T_to_Ainf[o] = (\\n\",\n",
    "    \"            np.array(T_to_Ainf[o])\\n\",\n",
    "    \"            if len(T_to_Ainf[o]) > 0\\n\",\n",
    "    \"            else np.zeros((0, o + 1))\\n\",\n",
    "    \"        )\\n\",\n",
    "    \"\\n\",\n",
    "    \"    return T_to_Ainf\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"def top_freq_per_sequence(Ainf_list, order=3, top_n=5, threshold=None):\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    每个序列：\\n\",\n",
    "    \"    1. 可选：剔除 |weight| < threshold 的边\\n\",\n",
    "    \"    2. 按 |weight| 从大到小排序\\n\",\n",
    "    \"    3. 取 top_n\\n\",\n",
    "    \"    4. 统计超边出现频率\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    all_top_edges = []\\n\",\n",
    "    \"\\n\",\n",
    "    \"    for Ainf in Ainf_list:\\n\",\n",
    "    \"        if order not in Ainf or Ainf[order].shape[0] == 0:\\n\",\n",
    "    \"            continue\\n\",\n",
    "    \"\\n\",\n",
    "    \"        edges = Ainf[order]\\n\",\n",
    "    \"        weights = np.abs(edges[:, -1])\\n\",\n",
    "    \"\\n\",\n",
    "    \"        if threshold is not None:\\n\",\n",
    "    \"            valid = weights >= threshold\\n\",\n",
    "    \"            edges = edges[valid]\\n\",\n",
    "    \"            weights = weights[valid]\\n\",\n",
    "    \"\\n\",\n",
    "    \"        if len(weights) == 0:\\n\",\n",
    "    \"            continue\\n\",\n",
    "    \"\\n\",\n",
    "    \"        k = min(top_n, len(weights))\\n\",\n",
    "    \"        idx_top = np.argsort(weights)[-k:][::-1]\\n\",\n",
    "    \"\\n\",\n",
    "    \"        top_edges = edges[idx_top, :order]\\n\",\n",
    "    \"\\n\",\n",
    "    \"        for row in top_edges:\\n\",\n",
    "    \"            row = row.astype(int)\\n\",\n",
    "    \"\\n\",\n",
    "    \"            if order == 3:\\n\",\n",
    "    \"                target = int(row[0])\\n\",\n",
    "    \"                j, k0 = sorted([int(row[1]), int(row[2])])\\n\",\n",
    "    \"                edge = (target, j, k0)\\n\",\n",
    "    \"            else:\\n\",\n",
    "    \"                edge = tuple(row)\\n\",\n",
    "    \"\\n\",\n",
    "    \"            all_top_edges.append(edge)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    return Counter(all_top_edges)\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"def high_order_ratio(Score, n=7):\\n\",\n",
    "    \"    if torch.is_tensor(Score):\\n\",\n",
    "    \"        Score = Score.detach().cpu().numpy()\\n\",\n",
    "    \"\\n\",\n",
    "    \"    Score = np.asarray(Score).copy()\\n\",\n",
    "    \"\\n\",\n",
    "    \"    for i in range(n):\\n\",\n",
    "    \"        Score[i, i] = 0.0\\n\",\n",
    "    \"\\n\",\n",
    "    \"    higher = Score[:, n:].sum()\\n\",\n",
    "    \"    total = Score.sum()\\n\",\n",
    "    \"\\n\",\n",
    "    \"    return higher / (total + 1e-12)\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"def normalize_data(X0, norm):\\n\",\n",
    "    \"    if norm == 1:\\n\",\n",
    "    \"        scale = np.mean(np.abs(X0))\\n\",\n",
    "    \"        if scale < 1e-12:\\n\",\n",
    "    \"            return None\\n\",\n",
    "    \"        return X0 / scale\\n\",\n",
    "    \"\\n\",\n",
    "    \"    elif norm == 2:\\n\",\n",
    "    \"        return (X0 - X0.mean(axis=1, keepdims=True)) / (\\n\",\n",
    "    \"            X0.std(axis=1, keepdims=True) + 1e-12\\n\",\n",
    "    \"        )\\n\",\n",
    "    \"\\n\",\n",
    "    \"    else:\\n\",\n",
    "    \"        raise ValueError(\\\"norm must be 1 or 2\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"def Causal_score(y_pred, y_true, method=\\\"exp\\\", tau=2, eps=1e-12):\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # 转成 tensor\\n\",\n",
    "    \"    y_pred = torch.as_tensor(y_pred)\\n\",\n",
    "    \"    y_true = torch.as_tensor(y_true)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # mse over time dimension only\\n\",\n",
    "    \"    mse = (y_pred - y_true).pow(2).mean(dim=-1).abs()         # (...,)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # scale: mean over time of y_true (同你原实现)\\n\",\n",
    "    \"    # scale = y_true.mean(dim=-1).abs().clamp_min(eps)          # (...,)\\n\",\n",
    "    \"    scale1 = y_true.pow(2).mean(dim=-1).abs()\\n\",\n",
    "    \"    scale2 = y_true.var(dim=-1, correction=0)# (...,)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    return torch.sqrt(mse / scale1)\\n\",\n",
    "    \"    return torch.sqrt(mse / scale2)\"\n",
    "   ],\n",
