    "   },\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"args = argparse.Namespace(\\n\",\n",
    "    \"    node_num=10,\\n\",\n",
    "    \"    N_train=1000,\\n\",\n",
    "    \"    N_test=10,\\n\",\n",
    "    \"    N_washout=0,\\n\",\n",
    "    \"    N_start=0,\\n\",\n",
    "    \"    dt=0.08,\\n\",\n",
    "    \"    P_probability=0.05,\\n\",\n",
    "    \"    T_probability=0.01,\\n\",\n",
    "    \"    Pair_strength=0.4,\\n\",\n",
    "    \"    Tri_strength=0.4,\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"ExpandNodes = args.node_num + math.comb(args.node_num - 1, 2)\\n\",\n",
    "    \"\\n\",\n",
    "    \"data_list = []\\n\",\n",
    "    \"set_seed(42)\\n\",\n",
    "    \"\\n\",\n",
    "    \"num_required = 10\\n\",\n",
    "    \"max_attempts = 100\\n\",\n",
    "    \"attempt = 0\\n\",\n",
    "    \"\\n\",\n",
    "    \"a2_list = []\\n\",\n",
    "    \"a3_list = []\\n\",\n",
    "    \"T_list = []\\n\",\n",
    "    \"\\n\",\n",
    "    \"while len(data_list) < num_required and attempt < max_attempts:\\n\",\n",
    "    \"    attempt += 1\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # if attempt == 1:\\n\",\n",
    "    \"    #     data, a2, a3 = load_or_generate_kuramoto(args)\\n\",\n",
    "    \"    #     a2_list.append(a2)\\n\",\n",
    "    \"    #     a3_list.append(a3)\\n\",\n",
    "    \"    # else:\\n\",\n",
    "    \"    a2,a3,data = generate_kuramoto_data_fast(\\n\",\n",
    "    \"        n=args.node_num,\\n\",\n",
    "    \"        dt=args.dt,\\n\",\n",
    "    \"        steps=(\\n\",\n",
    "    \"            args.N_start\\n\",\n",
    "    \"            + args.N_washout\\n\",\n",
    "    \"            + args.N_train\\n\",\n",
    "    \"            + args.N_test\\n\",\n",
    "    \"            + 1\\n\",\n",
    "    \"        ),\\n\",\n",
    "    \"        Pair_strength=args.Pair_strength,\\n\",\n",
    "    \"        Tri_strength=args.Tri_strength,\\n\",\n",
    "    \"        a2=None,\\n\",\n",
    "    \"        a3=None,\\n\",\n",
    "    \"        P_probability=args.P_probability,\\n\",\n",
    "    \"        T_probability=args.T_probability,\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"    theta = np.asarray(data)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    if theta.ndim != 2:\\n\",\n",
    "    \"        raise ValueError(\\n\",\n",
    "    \"            f\\\"Expected theta with shape (T, N), but got {theta.shape}\\\"\\n\",\n",
    "    \"        )\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # 只检查实际用于训练的区间更合理\\n\",\n",
    "    \"    train_start = args.N_start + args.N_washout\\n\",\n",
    "    \"    train_end = train_start + args.N_train\\n\",\n",
    "    \"    theta_train = theta[train_start:train_end]\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # 取训练区间后半段\\n\",\n",
    "    \"    theta_tail = theta_train[len(theta_train) // 2:]\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Kuramoto order parameter\\n\",\n",
    "    \"    R_tail = np.abs(\\n\",\n",
    "    \"        np.mean(np.exp(1j * theta_tail), axis=1)\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"\\n\",\n",
    "    \"    mean_R = np.mean(R_tail)\\n\",\n",
    "    \"    std_R = np.std(R_tail)\\n\",\n",
    "    \"    min_R = np.min(R_tail)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Pairwise phase differences\\n\",\n",
    "    \"    dtheta = (\\n\",\n",
    "    \"        theta_tail[:, :, None]\\n\",\n",
    "    \"        - theta_tail[:, None, :]\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # 用 PLV 比 wrapped angle 的普通标准差更稳健\\n\",\n",
    "    \"    pairwise_plv = np.abs(\\n\",\n",
    "    \"        np.mean(np.exp(1j * dtheta), axis=0)\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"\\n\",\n",
    "    \"    N = theta.shape[1]\\n\",\n",
    "    \"    off_diag = ~np.eye(N, dtype=bool)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    mean_plv = np.mean(pairwise_plv[off_diag])\\n\",\n",
    "    \"    min_plv = np.min(pairwise_plv[off_diag])\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # 完全/近完全同步判据\\n\",\n",
    "    \"    is_synchronized = (\\n\",\n",
    "    \"        (mean_R > 0.95 and min_R > 0.90)\\n\",\n",
    "    \"        or mean_plv > 0.98\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"\\n\",\n",
    "    \"    print(\\n\",\n",
    "    \"        f\\\"Attempt {attempt:03d}: \\\"\\n\",\n",
    "    \"        f\\\"mean_R={mean_R:.4f}, \\\"\\n\",\n",
    "    \"        f\\\"std_R={std_R:.4f}, \\\"\\n\",\n",
    "    \"        f\\\"min_R={min_R:.4f}, \\\"\\n\",\n",
    "    \"        f\\\"mean_PLV={mean_plv:.4f}, \\\"\\n\",\n",
    "    \"        f\\\"min_PLV={min_plv:.4f}, \\\"\\n\",\n",
    "    \"        f\\\"{'rejected' if is_synchronized else 'accepted'}\\\"\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"\\n\",\n",
    "    \"    if is_synchronized:\\n\",\n",
    "    \"        continue\\n\",\n",
    "    \"\\n\",\n",
    "    \"    data_list.append(data)\\n\",\n",
    "    \"    a2_list.append(a2)\\n\",\n",
    "    \"    a3_list.append(a3)\\n\",\n",
    "    \"    T_Matrix=np.zeros((args.node_num, ExpandNodes))\\n\",\n",
    "    \"    T_Matrix[:, :args.node_num] = (a2 != 0).astype(int)\\n\",\n",
    "    \"    for i in range(args.node_num):\\n\",\n",
    "    \"        com_list=list(combinations([x for x in range(args.node_num) if x != i], 2))\\n\",\n",
    "    \"        for index,(j,k) in enumerate(com_list):\\n\",\n",
    "    \"            T_Matrix[i, args.node_num+index] = int(a3[i][j][k] != 0)\\n\",\n",
    "    \"    count_Pair = np.count_nonzero(T_Matrix[:, :args.node_num])\\n\",\n",
    "    \"    count_Tri = np.count_nonzero(T_Matrix[:, args.node_num:])\\n\",\n",
    "    \"    print(\\\"pair:\\\", count_Pair)\\n\",\n",
    "    \"    print(\\\"Tri:\\\", count_Tri)\\n\",\n",
    "    \"    T_list.append(T_Matrix)\\n\",\n",
    "    \"\\n\",\n",
    "    \"if len(data_list) < num_required:\\n\",\n",
    "    \"    raise RuntimeError(\\n\",\n",
    "    \"        f\\\"Only collected {len(data_list)} valid trajectories \\\"\\n\",\n",
    "    \"        f\\\"after {max_attempts} attempts.\\\"\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\n\",\n",
    "    \"    f\\\"Collected {len(data_list)} trajectories \\\"\\n\",\n",
    "    \"    f\\\"from {attempt} attempts.\\\"\\n\",\n",
    "    \")\"\n",
    "   ],\n",
