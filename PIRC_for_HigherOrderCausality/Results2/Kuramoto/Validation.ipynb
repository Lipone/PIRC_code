    "   \"metadata\": {},\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"AUC_list = []\\n\",\n",
    "    \"for data in data_list:\\n\",\n",
    "    \"    noise_level = 0   # 5%\\n\",\n",
    "    \"\\n\",\n",
    "    \"    sigma = np.std(data, axis=0, keepdims=True)\\n\",\n",
    "    \"    noise = noise_level * sigma * np.random.randn(*data.shape)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    data_noisy = data + noise\\n\",\n",
    "    \"\\n\",\n",
    "    \"    X = torch.as_tensor(data_noisy, dtype=torch.float32, device=device)\\n\",\n",
    "    \"    X_batch = torch.stack(\\n\",\n",
    "    \"        [shift_column_to_first(X, i) for i in range(args.node_num)],\\n\",\n",
    "    \"        dim=0\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"    X_washout, X_train, Y_train, Y_test = split_dataset2_batch(\\n\",\n",
    "    \"        X_batch,\\n\",\n",
    "    \"        args.N_washout,\\n\",\n",
    "    \"        args.N_train,\\n\",\n",
    "    \"        args.N_test,\\n\",\n",
    "    \"        in_dim=args.node_num,\\n\",\n",
    "    \"        out_dim=args.node_num\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"\\n\",\n",
    "    \"    T_tensor = torch.as_tensor(T_Matrix, dtype=torch.float32, device=device)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    pirc = Nonliear_PIRC(\\n\",\n",
    "    \"        n_units=n_units, in_dim=args.node_num, out_dim=args.node_num,\\n\",\n",
    "    \"        Win=Win, Wres=Wres,\\n\",\n",
    "    \"        sigma_in=sigma_in, rho=rho, alpha=alpha, tikh=tikh, mode=mode, bias=bias, dt=args.dt,\\n\",\n",
    "    \"        device=device, block_dim=block_dim, I_type=I_type, option=option\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"\\n\",\n",
    "    \"    R,rmse,rrmse = pirc.train(X_washout, X_train, Y_train)\\n\",\n",
    "    \"    print(\\\"mean RMSE:\\\", np.mean(rmse))\\n\",\n",
    "    \"    Y_test_predict = pirc.Prediction2(R, args.N_test, Y_train, Y_test)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # ====== Score and AUC computation ======\\n\",\n",
    "    \"    base_all = Y_test_predict[0, :, :args.N_test, 0]  # base: (B, T)\\n\",\n",
    "    \"    others_all = Y_test_predict[2: , :, :args.N_test, 0]  # others: (E, B, T)\\n\",\n",
    "    \"    base_expand = base_all.unsqueeze(0).expand_as(others_all)  # (E, B, T)\\n\",\n",
    "    \"    score_EN = score_0_1_torch(\\n\",\n",
    "    \"        others_all,\\n\",\n",
    "    \"        base_expand,\\n\",\n",
    "    \"        method=method,\\n\",\n",
    "    \"        tau=tau\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"    Score = score_EN.transpose(0, 1).contiguous()  # (B, E)\\n\",\n",
    "    \"    Score = shift_column_for_Causal_Matrix(Score)\\n\",\n",
    "    \"    Score.fill_diagonal_(1.0)\\n\",\n",
    "    \"    AUC = ranking_auc_ALL(Score, T_tensor)\\n\",\n",
    "    \"    AUC_list.append(AUC)\\n\",\n",
    "    \"    print(\\\"AUC:\\\", AUC)\"\n",
    "   ],\n",
