    "    \"rho = best_params[\\\"rho\\\"]\\n\",\n",
    "    \"tikh = 0.1\\n\",\n",
    "    \"bias = best_params[\\\"bias\\\"]\\n\",\n",
    "    \"option = best_params[\\\"option\\\"]\\n\",\n",
    "    \"tau = best_params[\\\"tau\\\"]\\n\",\n",
    "    \"method = best_params[\\\"method\\\"]\\n\",\n",
    "    \"connectivity = best_params[\\\"connectivity\\\"]\\n\",\n",
    "    \"I_type = best_params[\\\"I_type\\\"]\\n\",\n",
    "    \"mode = best_params[\\\"mode\\\"]\\n\",\n",
