    "   \"source\": [\n",
    "    \"device = torch.device(\\\"cuda:2\\\")\\n\",\n",
    "    \"with open(\\\"results/PIRC_result.pkl\\\", \\\"rb\\\") as f:\\n\",\n",
    "    \"    result = pickle.load(f)\\n\",\n",
    "    \"best_params = result[\\\"best_params\\\"]\\n\",\n",
    "    \"best_auc = result[\\\"best_auc\\\"]\\n\",\n",
    "    \"Score = result[\\\"Score\\\"]\\n\",\n",
    "    \"Win = result[\\\"Win\\\"]\\n\",\n",
    "    \"Wres = result[\\\"Wres\\\"]\\n\",\n",
    "    \"Win = torch.as_tensor(Win, dtype=torch.float32, device=device)\\n\",\n",
    "    \"Wres = torch.as_tensor(Wres, dtype=torch.float32, device=device)\\n\",\n",
    "    \"n_units = best_params[\\\"n_units\\\"]\\n\",\n",
