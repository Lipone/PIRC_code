    "   \"source\": [\n",
    "    \"import sys\\n\",\n",
    "    \"sys.path.append('/home/caoren/tmp/PIRC_for_HigherOrderCausality')\\n\",\n",
    "    \"import os\\n\",\n",
    "    \"os.chdir(\\\"/home/caoren/tmp/PIRC_for_HigherOrderCausality/Results/Kuramoto\\\")\\n\",\n",
    "    \"from Torch_Library import *\\n\",\n",
    "    \"from PIRC import PIRC_flatten as Nonliear_PIRC\\n\",\n",
    "    \"from DateGen_kuramoto import load_or_generate_kuramoto,generate_kuramoto_data_fast\\n\",\n",
    "    \"import argparse\\n\",\n",
    "    \"import numpy as np\\n\",\n",
