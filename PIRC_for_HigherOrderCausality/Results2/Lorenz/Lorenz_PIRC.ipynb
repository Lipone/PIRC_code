    "   \"source\": [\n",
    "    \"# def Win_Fixed_Wres(\\n\",\n",
    "    \"#     ExpandNodes,\\n\",\n",
    "    \"#     n_units,\\n\",\n",
    "    \"#     device,\\n\",\n",
