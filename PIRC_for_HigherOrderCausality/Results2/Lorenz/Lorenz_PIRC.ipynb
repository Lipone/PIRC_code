    "    \"#     if connectivity == 1.0:\\n\",\n",
    "    \"#         Win = 2 * torch.rand(\\n\",\n",
    "    \"#             ExpandNodes, block_dim, n_units,\\n\",\n",
    "    \"#             device=device\\n\",\n",
    "    \"#         ) - 1\\n\",\n",
    "    \"#\\n\",\n",
    "    \"#         Wres = torch.empty(\\n\",\n",
    "    \"#             n_units, n_units,\\n\",\n",
    "    \"#             device=device\\n\",\n",
    "    \"#         ).uniform_(-1, 1)\\n\",\n",
    "    \"#     elif connectivity == 0.5:\\n\",\n",
    "    \"#         n1 = n_units // 2\\n\",\n",
    "    \"#         Wres = torch.zeros(\\n\",\n",
    "    \"#             n_units, n_units,\\n\",\n",
    "    \"#             device=device\\n\",\n",
    "    \"#         )\\n\",\n",
    "    \"#         Wres[:n1, :n1].uniform_(-1, 1)\\n\",\n",
    "    \"#         Wres[n1:, n1:].uniform_(-1, 1)\\n\",\n",
    "    \"#         d1 = block_dim // 2\\n\",\n",
    "    \"#         Win = torch.zeros(\\n\",\n",
    "    \"#             ExpandNodes, block_dim, n_units,\\n\",\n",
    "    \"#             device=device\\n\",\n",
    "    \"#         )\\n\",\n",
    "    \"#         Win[:, :d1, :n1].uniform_(-1, 1)\\n\",\n",
    "    \"#         Win[:, d1:, n1:].uniform_(-1, 1)\\n\",\n",
    "    \"#     return Win, Wres\\n\",\n",
    "    \"def Win_Fixed_Wres(\\n\",\n",
    "    \"    ExpandNodes,\\n\",\n",
    "    \"    n_units,\\n\",\n",
    "    \"    device,\\n\",\n",
    "    \"    block_dim=1,\\n\",\n",
    "    \"    connectivity=1.0\\n\",\n",
    "    \"):\\n\",\n",
    "    \"    if connectivity == 1.0:\\n\",\n",
    "    \"        Win = torch.zeros(\\n\",\n",
    "    \"            ExpandNodes, block_dim, n_units,\\n\",\n",
    "    \"            device=device\\n\",\n",
    "    \"        )\\n\",\n",
    "    \"        # 只生成一套非零位置\\n\",\n",
    "    \"        idx = torch.randint(\\n\",\n",
    "    \"            0, block_dim,\\n\",\n",
    "    \"            (1, 1, n_units),\\n\",\n",
    "    \"            device=device\\n\",\n",
    "    \"        )\\n\",\n",
    "    \"        # 所有 ExpandNodes 使用相同位置\\n\",\n",
    "    \"        idx = idx.expand(ExpandNodes, -1, -1)\\n\",\n",
    "    \"        # 但非零值可以各自随机\\n\",\n",
    "    \"        values = 2 * torch.rand(\\n\",\n",
    "    \"            ExpandNodes, 1, n_units,\\n\",\n",
    "    \"            device=device\\n\",\n",
    "    \"        ) - 1\\n\",\n",
    "    \"        Win.scatter_(1, idx, values)\\n\",\n",
    "    \"        Wres = torch.empty(\\n\",\n",
    "    \"            n_units, n_units,\\n\",\n",
    "    \"            device=device\\n\",\n",
    "    \"        ).uniform_(-1, 1)\\n\",\n",
    "    \"    if connectivity == -1.0:\\n\",\n",
    "    \"        Win = torch.zeros(\\n\",\n",
    "    \"            ExpandNodes, block_dim, n_units,\\n\",\n",
    "    \"            device=device\\n\",\n",
    "    \"        )\\n\",\n",
    "    \"\\n\",\n",
    "    \"        # 每一列随机选择一个非零位置\\n\",\n",
    "    \"        idx = torch.randint(\\n\",\n",
    "    \"            0, block_dim,\\n\",\n",
    "    \"            (ExpandNodes, 1, n_units),\\n\",\n",
    "    \"            device=device\\n\",\n",
    "    \"        )\\n\",\n",
    "    \"\\n\",\n",
    "    \"        # 非零值随机取自 [-1, 1]\\n\",\n",
    "    \"        values = 2 * torch.rand(\\n\",\n",
    "    \"            ExpandNodes, 1, n_units,\\n\",\n",
    "    \"            device=device\\n\",\n",
    "    \"        ) - 1\\n\",\n",
    "    \"\\n\",\n",
    "    \"        Win.scatter_(1, idx, values)\\n\",\n",
    "    \"\\n\",\n",
    "    \"        Wres = torch.empty(\\n\",\n",
    "    \"            n_units, n_units,\\n\",\n",
    "    \"            device=device\\n\",\n",
    "    \"        ).uniform_(-1, 1)\\n\",\n",
    "    \"    elif connectivity == 0.5:\\n\",\n",
    "    \"        n1 = n_units // 2\\n\",\n",
    "    \"        Wres = torch.zeros(\\n\",\n",
    "    \"            n_units, n_units,\\n\",\n",
    "    \"            device=device\\n\",\n",
    "    \"        )\\n\",\n",
    "    \"        Wres[:, :].uniform_(-1, 1)\\n\",\n",
    "    \"        d1 = block_dim // 2\\n\",\n",
    "    \"        Win = torch.zeros(\\n\",\n",
    "    \"            ExpandNodes, block_dim, n_units,\\n\",\n",
    "    \"            device=device\\n\",\n",
    "    \"        )\\n\",\n",
    "    \"        Win[:, :d1, :n1].uniform_(-1, 1)\\n\",\n",
    "    \"        Win[:, d1:, n1:].uniform_(-1, 1)\\n\",\n",
    "    \"    elif connectivity == 0.25:\\n\",\n",
    "    \"        # n1 = n_units // 2\\n\",\n",
    "    \"        Wres = torch.zeros(\\n\",\n",
    "    \"            n_units, n_units,\\n\",\n",
    "    \"            device=device\\n\",\n",
    "    \"        )\\n\",\n",
    "    \"        Wres[:, :].uniform_(-1, 1)\\n\",\n",
    "    \"        # Wres[n1:, n1:].uniform_(-1, 1)\\n\",\n",
    "    \"        d1 = block_dim // 2\\n\",\n",
    "    \"        Win = torch.zeros(\\n\",\n",
    "    \"            ExpandNodes, block_dim, n_units,\\n\",\n",
    "    \"            device=device\\n\",\n",
    "    \"        )\\n\",\n",
    "    \"        # Win[:, :d1, :n1].uniform_(-1, 1)\\n\",\n",
    "    \"        Win[:, d1:, :].uniform_(-1, 1)\\n\",\n",
    "    \"    elif connectivity == 0.75:\\n\",\n",
    "    \"        # n1 = n_units // 2\\n\",\n",
    "    \"        Wres = torch.zeros(\\n\",\n",
    "    \"            n_units, n_units,\\n\",\n",
    "    \"            device=device\\n\",\n",
    "    \"        )\\n\",\n",
    "    \"        Wres[:, :].uniform_(-1, 1)\\n\",\n",
    "    \"        # Wres[n1:, n1:].uniform_(-1, 1)\\n\",\n",
    "    \"        d1 = block_dim // 2\\n\",\n",
    "    \"        Win = torch.zeros(\\n\",\n",
    "    \"            ExpandNodes, block_dim, n_units,\\n\",\n",
    "    \"            device=device\\n\",\n",
    "    \"        )\\n\",\n",
    "    \"        Win[:, :d1, :].uniform_(-1, 1)\\n\",\n",
    "    \"        # Win[:, d1:, n1:].uniform_(-1, 1)\\n\",\n",
    "    \"    return Win, Wres\\n\",\n",
    "    \"\\n\",\n",
    "    \"def Causal_score(y_pred, y_true, method=\\\"exp\\\", tau=2, eps=1e-12):\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # 转成 tensor\\n\",\n",
    "    \"    y_pred = torch.as_tensor(y_pred)\\n\",\n",
    "    \"    y_true = torch.as_tensor(y_true)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # mse over time dimension only\\n\",\n",
    "    \"    mse = (y_pred - y_true).pow(2).mean(dim=-1).abs()         # (...,)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # scale: mean over time of y_true (同你原实现)\\n\",\n",
    "    \"    # scale = y_true.mean(dim=-1).abs().clamp_min(eps)          # (...,)\\n\",\n",
    "    \"    scale1 = y_true.pow(2).mean(dim=-1).abs()\\n\",\n",
    "    \"    scale2 = y_true.var(dim=-1, correction=0)# (...,)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    return torch.sqrt(mse / scale1)\\n\",\n",
    "    \"    return torch.sqrt(mse / scale2)\\n\"\n",
    "   ],\n",
