    "   },\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"import numpy as np\\n\",\n",
    "    \"import torch\\n\",\n",
    "    \"import matplotlib.pyplot as plt\\n\",\n",
    "    \"import matplotlib.ticker as ticker\\n\",\n",
    "    \"from sklearn.cluster import KMeans\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"def plot_kmeans_threshold_jitter(\\n\",\n",
    "    \"    Score,\\n\",\n",
    "    \"    save_path=\\\"KMeans_threshold_jitter.png\\\",\\n\",\n",
    "    \"    remove_diag=True,\\n\",\n",
    "    \"    random_state=0,\\n\",\n",
    "    \"    threshold_range=\\\"between_centers\\\",  # or \\\"quantile\\\"\\n\",\n",
    "    \"):\\n\",\n",
    "    \"    if torch.is_tensor(Score):\\n\",\n",
    "    \"        score = Score.detach().cpu().numpy()\\n\",\n",
    "    \"    else:\\n\",\n",
    "    \"        score = np.asarray(Score)\\n\",\n",
    "    \"    B, E = score.shape\\n\",\n",
    "    \"    mask = np.ones_like(score, dtype=bool)\\n\",\n",
    "    \"    if remove_diag:\\n\",\n",
    "    \"        d = min(B, E)\\n\",\n",
    "    \"        mask[np.arange(d), np.arange(d)] = False\\n\",\n",
    "    \"    x = score[mask].reshape(-1, 1)\\n\",\n",
    "    \"    km = KMeans(n_clusters=2, random_state=random_state, n_init=20)\\n\",\n",
    "    \"    labels = km.fit_predict(x)\\n\",\n",
    "    \"    centers = km.cluster_centers_.flatten()\\n\",\n",
    "    \"    low_id, high_id = np.argsort(centers)\\n\",\n",
    "    \"    no_causal = labels == low_id\\n\",\n",
    "    \"    causal = labels == high_id\\n\",\n",
    "    \"    c_low, c_high = np.sort(centers)\\n\",\n",
    "    \"    threshold = (c_low + c_high) / 2\\n\",\n",
    "    \"    # 阴影阈值范围\\n\",\n",
    "    \"    range_left = np.percentile(x[no_causal], 100)\\n\",\n",
    "    \"    range_right = np.percentile(x[causal], 0)\\n\",\n",
    "    \"    rng = np.random.default_rng(random_state)\\n\",\n",
    "    \"    jitter = rng.normal(0, 1.25, size=len(x))\\n\",\n",
    "    \"    x = x.flatten()\\n\",\n",
    "    \"    fig, ax = plt.subplots(figsize=(5, 4), dpi=1200)\\n\",\n",
    "    \"    ax.axvspan(\\n\",\n",
    "    \"        range_left+2e-5,\\n\",\n",
    "    \"        range_right-2e-5,\\n\",\n",
    "    \"        color=\\\"#f4a340\\\",\\n\",\n",
    "    \"        alpha=0.18,\\n\",\n",
    "    \"        linestyle=\\\"--\\\",\\n\",\n",
    "    \"        linewidth=1.5,\\n\",\n",
    "    \"        edgecolor=\\\"#f4a340\\\",\\n\",\n",
    "    \"        label=\\\"Feasible threshold range\\\"\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"    ax.scatter(\\n\",\n",
    "    \"        x[no_causal],\\n\",\n",
    "    \"        jitter[no_causal],\\n\",\n",
    "    \"        s=60,\\n\",\n",
    "    \"        facecolors=\\\"white\\\",\\n\",\n",
    "    \"        edgecolors=\\\"0.72\\\",\\n\",\n",
    "    \"        linewidths=1.4,\\n\",\n",
    "    \"        alpha=0.95,\\n\",\n",
    "    \"        label=\\\"No causal effect\\\"\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"    ax.scatter(\\n\",\n",
    "    \"        x[causal],\\n\",\n",
    "    \"        jitter[causal],\\n\",\n",
    "    \"        s=60,\\n\",\n",
    "    \"        color=\\\"#1f77b4\\\",\\n\",\n",
    "    \"        edgecolors=\\\"#1f77b4\\\",\\n\",\n",
    "    \"        linewidths=0.8,\\n\",\n",
    "    \"        alpha=0.95,\\n\",\n",
    "    \"        label=\\\"Causal effect exists\\\"\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"    ax.axvline(\\n\",\n",
    "    \"        threshold,\\n\",\n",
    "    \"        color=\\\"red\\\",\\n\",\n",
    "    \"        linestyle=\\\"--\\\",\\n\",\n",
    "    \"        linewidth=2.2,\\n\",\n",
    "    \"        label=\\\"K-means threshold\\\"\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"    formatter = ticker.ScalarFormatter(useMathText=True)\\n\",\n",
    "    \"    formatter.set_scientific(True)\\n\",\n",
    "    \"    formatter.set_powerlimits((0, 0))\\n\",\n",
    "    \"    ax.xaxis.set_major_formatter(formatter)\\n\",\n",
    "    \"    ax.xaxis.get_offset_text().set_size(13)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    ax.set_xlabel(\\\"CI\\\", fontsize=16)\\n\",\n",
    "    \"    ax.grid(False)\\n\",\n",
    "    \"    ax.set_yticks([])\\n\",\n",
    "    \"    ax.tick_params(axis=\\\"both\\\", labelsize=13, width=1.3, length=6)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    for spine in ax.spines.values():\\n\",\n",
    "    \"        spine.set_linewidth(1.3)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    handles, labels_ = ax.get_legend_handles_labels()\\n\",\n",
    "    \"    order = [\\n\",\n",
    "    \"        labels_.index(\\\"No causal effect\\\"),\\n\",\n",
    "    \"        labels_.index(\\\"Causal effect exists\\\"),\\n\",\n",
    "    \"        labels_.index(\\\"K-means threshold\\\"),\\n\",\n",
    "    \"        labels_.index(\\\"Feasible threshold range\\\"),\\n\",\n",
    "    \"    ]\\n\",\n",
    "    \"    ax.legend(\\n\",\n",
    "    \"        [handles[i] for i in order],\\n\",\n",
    "    \"        [labels_[i] for i in order],\\n\",\n",
    "    \"        fontsize=12,\\n\",\n",
    "    \"        frameon=True,\\n\",\n",
    "    \"        loc=\\\"upper right\\\"\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"    ax.spines['top'].set_visible(False)\\n\",\n",
    "    \"    ax.spines['right'].set_visible(False)\\n\",\n",
    "    \"    for spine in ['left', 'bottom']:\\n\",\n",
    "    \"            ax.spines[spine].set_color('black')\\n\",\n",
    "    \"            ax.spines[spine].set_linewidth(1)\\n\",\n",
    "    \"    from matplotlib.ticker import FormatStrFormatter\\n\",\n",
    "    \"    ax.yaxis.set_major_formatter(FormatStrFormatter('%.2f'))\\n\",\n",
    "    \"    plt.tight_layout()\\n\",\n",
    "    \"    mpl.rcParams['svg.fonttype'] = 'none'\\n\",\n",
    "    \"    plt.savefig(save_path, dpi=1000, bbox_inches=\\\"tight\\\")\\n\",\n",
    "    \"    plt.show()\\n\",\n",
    "    \"\\n\",\n",
    "    \"    print(\\\"Cluster centers:\\\", np.sort(centers))\\n\",\n",
    "    \"    print(f\\\"K-means threshold: {threshold:.6e}\\\")\\n\",\n",
    "    \"    print(f\\\"Feasible threshold range: [{range_left:.6e}, {range_right:.6e}]\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"    return threshold, (range_left, range_right), labels\"\n",
    "   ],\n",
