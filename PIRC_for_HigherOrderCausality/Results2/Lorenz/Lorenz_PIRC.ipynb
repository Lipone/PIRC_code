    "    }\n",
    "   },\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"node_num=3\\n\",\n",
    "    \"N_train=1000\\n\",\n",
    "    \"N_test=100\\n\",\n",
    "    \"N_washout=0\\n\",\n",
    "    \"N_start=0\\n\",\n",
    "    \"dt=0.001\\n\",\n",
    "    \"device = torch.device(\\\"cuda:3\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"ExpandNodes = node_num + math.comb(node_num - 1, 2)\\n\",\n",
    "    \"set_seed(42)\\n\",\n",
    "    \"t_all=(N_train+N_test+N_washout+N_start+1)*dt\\n\",\n",
    "    \"\\n\",\n",
    "    \"# data generation\\n\",\n",
    "    \"t, xyz = generate_lorenz_data(\\n\",\n",
    "    \"    t_span=(0, t_all),\\n\",\n",
    "    \"    dt=dt,\\n\",\n",
    "    \"    initial_state=(1.0, 1.0, 1.0),\\n\",\n",
    "    \"    sigma=10.0,\\n\",\n",
    "    \"    rho=28.0,\\n\",\n",
    "    \"    beta=8 / 3\\n\",\n",
    "    \")\\n\",\n",
    "    \"X = xyz.T  # (N, 3)\\n\",\n",
    "    \"X = (X - np.mean(X, axis=0)) / np.std(X, axis=0)  # normalization\\n\",\n",
    "    \"data=X\\n\",\n",
    "    \"\\n\",\n",
    "    \"#ground Truth matrix\\n\",\n",
    "    \"T_Matrix=[\\n\",\n",
    "    \"    [1,1,0,0],\\n\",\n",
    "    \"    [1,1,0,1],\\n\",\n",
    "    \"    [0,0,1,1]\\n\",\n",
    "    \"]\\n\",\n",
    "    \"ExpandNodes = (node_num + math.comb(node_num - 1, 2)+1)\\n\",\n",
    "    \"n_units=5\\n\",\n",
    "    \"alpha=0.3\\n\",\n",
    "    \"sigma_in=0.4\\n\",\n",
    "    \"rho=0.7\\n\",\n",
    "    \"tikh=1.0\\n\",\n",
    "    \"option=3\\n\",\n",
    "    \"tau=2\\n\",\n",
    "    \"method='Logistic'\\n\",\n",
    "    \"connectivity=0.75\\n\",\n",
    "    \"I_type=1\\n\",\n",
    "    \"mode=2\\n\",\n",
    "    \"block_dim=2\\n\",\n",
    "    \"Base='prediction'\\n\",\n",
    "    \"set_seed(42)\\n\",\n",
    "    \"\\n\",\n",
    "    \"Win, Wres = Win_Fixed_Wres(\\n\",\n",
    "    \"        ExpandNodes, n_units, device,\\n\",\n",
    "    \"        block_dim=block_dim, connectivity=connectivity\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"X = torch.as_tensor(data, dtype=torch.float32, device=device)\\n\",\n",
    "    \"X_batch = torch.stack(\\n\",\n",
    "    \"    [shift_column_to_first(X, i) for i in range(node_num)],\\n\",\n",
    "    \"    dim=0\\n\",\n",
    "    \")\\n\",\n",
    "    \"X_washout, X_train, Y_train, Y_test = split_dataset2_batch(\\n\",\n",
    "    \"    X_batch,\\n\",\n",
    "    \"    N_washout,\\n\",\n",
    "    \"    N_train,\\n\",\n",
    "    \"    N_test,\\n\",\n",
    "    \"    in_dim=node_num,\\n\",\n",
    "    \"    out_dim=node_num\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"T_tensor = torch.as_tensor(T_Matrix, dtype=torch.float32, device=device)\\n\",\n",
    "    \"\\n\",\n",
    "    \"pirc = Nonliear_PIRC(\\n\",\n",
    "    \"        n_units=n_units, in_dim=node_num, out_dim=node_num,\\n\",\n",
    "    \"        Win=Win, Wres=Wres,\\n\",\n",
    "    \"        sigma_in=sigma_in, rho=rho, alpha=alpha, tikh=tikh, mode=mode, bias=0, dt=dt,\\n\",\n",
    "    \"        device=device, block_dim=block_dim, I_type=I_type, option=option\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"\\n\",\n",
    "    \"R, _ = pirc.train(X_washout, X_train, Y_train)\\n\",\n",
    "    \"Y_test_predict = pirc.Prediction2(R, N_test, Y_train, Y_test)\\n\",\n",
    "    \"\\n\",\n",
    "    \"base_all = Y_test_predict[0, :, :N_test, 0]  # base: (B, T)\\n\",\n",
    "    \"others_all = Y_test_predict[2: , :, :N_test, 0]  # others: (E, B, T)\\n\",\n",
    "    \"total_mse =  ((Y_test[0,:,:].T-base_all).pow(2).sum())/(base_all.shape[0]*base_all.shape[1])\\n\",\n",
    "    \"base_expand = base_all.unsqueeze(0).expand_as(others_all)  # (E, B, T)\\n\",\n",
    "    \"score_EN = Causal_score(\\n\",\n",
    "    \"    others_all,\\n\",\n",
    "    \"    base_expand,\\n\",\n",
    "    \"    method=method,\\n\",\n",
    "    \"    tau=tau\\n\",\n",
    "    \")\\n\",\n",
    "    \"Score = score_EN.transpose(0, 1).contiguous()  # (B, E)\\n\",\n",
    "    \"print(score_EN)\\n\",\n",
    "    \"print(f\\\"Score:{Score}\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"Score = shift_column_for_Causal_Matrix(Score)\\n\",\n",
    "    \"print(f\\\"Shif_Score:{Score}, \\\\nT_tensor:{T_tensor}\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"Score.fill_diagonal_(1.0)\\n\",\n",
    "    \"AUC = ranking_auc_ALL(Score, T_tensor)\\n\",\n",
    "    \"Loss=1-AUC+total_mse\\n\",\n",
    "    \"print(f\\\"AUC: { AUC}, MSE: {total_mse}, Loss:{Loss}\\\")\"\n",
    "   ],\n",
