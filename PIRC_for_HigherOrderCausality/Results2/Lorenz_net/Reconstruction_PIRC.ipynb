    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"data = data[2000:,:]\\n\",\n",
    "    \"mean = data.mean(axis=0, keepdims=True)\\n\",\n",
    "    \"std = data.std(axis=0, keepdims=True)\\n\",\n",
    "    \"std[std < 1e-12] = 1.0\\n\",\n",
    "    \"data = (data - mean) / std\\n\",\n",
    "    \"\\n\",\n",
    "    \"ExpandNodes = args.node_num + math.comb(args.node_num - 1, 2)\\n\",\n",
    "    \"T_Matrix = np.zeros((args.node_num, ExpandNodes))\\n\",\n",
    "    \"T_Matrix[:, :args.node_num] = (a2 != 0).astype(int)\\n\",\n",
    "    \"for i in range(args.node_num):\\n\",\n",
    "    \"    com_list = list(combinations([x for x in range(args.node_num) if x != i], 2))\\n\",\n",
    "    \"    for index, (j, k) in enumerate(com_list):\\n\",\n",
    "    \"        T_Matrix[i, args.node_num + index] = int(a3[i][j][k] != 0)\\n\",\n",
    "    \"print(\\\"ground_truth\\\", T_Matrix)\\n\",\n",
    "    \"count_Pair = np.count_nonzero(T_Matrix[:, :args.node_num])\\n\",\n",
    "    \"count_Tri = np.count_nonzero(T_Matrix[:, args.node_num:])\\n\",\n",
    "    \"print(\\\"pair:\\\", count_Pair)\\n\",\n",
    "    \"print(\\\"Tri:\\\", count_Tri)\\n\",\n",
    "    \"\\n\",\n",
    "    \"def groundtruth_to_edges(T_Matrix):\\n\",\n",
    "    \"    T_Matrix = np.asarray(T_Matrix)\\n\",\n",
    "    \"    N = T_Matrix.shape[0]\\n\",\n",
    "    \"    pair_edges = []\\n\",\n",
    "    \"    hyperedges = []\\n\",\n",
    "    \"    for target in range(N):\\n\",\n",
    "    \"        # pairwise: source -> target\\n\",\n",
    "    \"        for source in range(N):\\n\",\n",
    "    \"            if T_Matrix[target, source] != 0:\\n\",\n",
    "    \"                pair_edges.append((source, target))\\n\",\n",
    "    \"        # triadic: {source1, source2} -> target\\n\",\n",
    "    \"        other_nodes = [j for j in range(N) if j != target]\\n\",\n",
    "    \"        tri_combs = list(combinations(other_nodes, 2))\\n\",\n",
    "    \"        for col_offset, (s1, s2) in enumerate(tri_combs):\\n\",\n",
    "    \"            col = N + col_offset\\n\",\n",
    "    \"            if T_Matrix[target, col] != 0:\\n\",\n",
    "    \"                hyperedges.append((s1, s2, target))\\n\",\n",
    "    \"    return pair_edges, hyperedges\\n\",\n",
    "    \"pair_edges, hyperedges = groundtruth_to_edges(T_Matrix)\\n\",\n",
    "    \"print(\\\"pair_edges =\\\", pair_edges)\\n\",\n",
    "    \"print(\\\"hyperedges =\\\", hyperedges)\"\n",
    "   ],\n",
