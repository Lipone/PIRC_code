    "    \"    mpl.rcParams[\\\"mathtext.fontset\\\"] = \\\"stix\\\"\\n\",\n",
    "    \"    Ts = sorted(results.keys(), reverse=True)\\n\",\n",
    "    \"#     colors = [\\n\",\n",
    "    \"#     \\\"#8B1E3F\\\",\\n\",\n",
    "    \"#     \\\"#123B73\\\",\\n\",\n",
    "    \"#     \\\"#6E7480\\\",\\n\",\n",
    "    \"#     \\\"#9C8F73\\\",\\n\",\n",
    "    \"#     \\\"#B9AC63\\\",\\n\",\n",
    "    \"# ]\\n\",\n",
    "    \"    colors = plt.cm.Blues(np.linspace(1.0, 0.5, 5))\\n\",\n",
    "    \"\\n\",\n",
    "    \"    fig, ax = plt.subplots(figsize=(5, 4), dpi=1000)\\n\",\n",
    "    \"    for idx, T in enumerate(Ts):\\n\",\n",
    "    \"        Score = np.asarray(results[T][\\\"Score\\\"])\\n\",\n",
    "    \"        T_Matrix = np.asarray(results[T][\\\"T_Matrix\\\"])\\n\",\n",
    "    \"        N = T_Matrix.shape[0]\\n\",\n",
    "    \"        mask = np.ones_like(T_Matrix, dtype=bool)\\n\",\n",
    "    \"        np.fill_diagonal(mask, False)\\n\",\n",
    "    \"        y_true = T_Matrix[mask].astype(int)\\n\",\n",
    "    \"        y_score = Score[mask]\\n\",\n",
    "    \"        fpr, tpr, _ = roc_curve(y_true, y_score)\\n\",\n",
    "    \"        roc_auc = auc(fpr, tpr)\\n\",\n",
    "    \"        ax.plot(\\n\",\n",
    "    \"            fpr,\\n\",\n",
    "    \"            tpr,\\n\",\n",
    "    \"            linewidth=2.2,\\n\",\n",
    "    \"            color=colors[idx % len(colors)],\\n\",\n",
    "    \"            label=f\\\"AUC={roc_auc:.3f}\\\"\\n\",\n",
    "    \"        )\\n\",\n",
    "    \"    # Random guess\\n\",\n",
    "    \"    ax.plot([0, 1], [0, 1], \\\"--\\\", linewidth=1.2,\\n\",\n",
    "    \"            color=\\\"gray\\\", alpha=0.7)\\n\",\n",
    "    \"    # Labels\\n\",\n",
    "    \"    # ax.set_xlabel(\\\"False Positive Rate\\\", fontsize=20)\\n\",\n",
    "    \"    # ax.set_ylabel(\\\"True Positive Rate\\\", fontsize=20)\\n\",\n",
    "    \"    mpl.rcParams[\\\"svg.fonttype\\\"] = \\\"none\\\"   # 文字保留为 text，不转 path\\n\",\n",
    "    \"    mpl.rcParams[\\\"pdf.fonttype\\\"] = 42\\n\",\n",
    "    \"    mpl.rcParams[\\\"ps.fonttype\\\"] = 42\\n\",\n",
    "    \"\\n\",\n",
    "    \"    mpl.rcParams[\\\"font.family\\\"] = \\\"DejaVu Serif\\\"\\n\",\n",
    "    \"    mpl.rcParams[\\\"mathtext.fontset\\\"] = \\\"stix\\\"\\n\",\n",
    "    \"    ax.set_xlim(-0.05, 1.05)\\n\",\n",
    "    \"    ax.set_ylim(-0.05, 1.05)\\n\",\n",
    "    \"    ax.tick_params(labelsize=12)\\n\",\n",
    "    \"    for label in ax.get_xticklabels():\\n\",\n",
    "    \"        label.set_fontweight(\\\"bold\\\")\\n\",\n",
    "    \"    for label in ax.get_yticklabels():\\n\",\n",
    "    \"        label.set_fontweight(\\\"bold\\\")\\n\",\n",
    "    \"    # ===== 去掉网格 =====\\n\",\n",
    "    \"    ax.grid(False)\\n\",\n",
    "    \"    # ===== 去掉上、右边框 =====\\n\",\n",
    "    \"    ax.spines[\\\"top\\\"].set_visible(False)\\n\",\n",
    "    \"    ax.spines[\\\"right\\\"].set_visible(False)\\n\",\n",
    "    \"    ax.legend(frameon=False, fontsize=12, loc=\\\"lower right\\\")\\n\",\n",
    "    \"    plt.tight_layout()\\n\",\n",
    "    \"    # ===== 保存 SVG =====\\n\",\n",
    "    \"    plt.savefig(save_path, format=\\\"svg\\\", bbox_inches=\\\"tight\\\")\\n\",\n",
    "    \"    plt.show()\\n\",\n",
    "    \"import pickle\\n\",\n",
    "    \"filename = \\\"ARNI_light_1_params.pkl\\\"\\n\",\n",
    "    \"with open(filename, \\\"rb\\\") as f:\\n\",\n",
    "    \"    save_dict = pickle.load(f)\\n\",\n",
    "    \"results_base = save_dict[\\\"results\\\"]\\n\",\n",
    "    \"plot_roc_results(results_base,name=\\\"ARNI1\\\",save_path=\\\"ARNI1.svg\\\")\"\n",
