    "    \"})\\n\",\n",
    "    \"\\n\",\n",
    "    \"def plot_roc_results(results, name='PIRC', save_path=\\\"ROC.svg\\\"):\\n\",\n",
    "    \"    import matplotlib as mpl\\n\",\n",
    "    \"\\n\",\n",
    "    \"    mpl.rcParams[\\\"svg.fonttype\\\"] = \\\"none\\\"   # 文字保留为 text，不转 path\\n\",\n",
