    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"import time\\n\",\n",
    "    \"import numpy as np\\n\",\n",
    "    \"import matplotlib.pyplot as plt\\n\",\n",
    "    \"\\n\",\n",
    "    \"T_L = [100]\\n\",\n",
    "    \"\\n\",\n",
    "    \"time_mean = []\\n\",\n",
    "    \"time_std = []\\n\",\n",
    "    \"time_all = {}\\n\",\n",
    "    \"args.n=120\\n\",\n",
    "    \"node_num=120\\n\",\n",
    "    \"for T in T_L:\\n\",\n",
    "    \"    X = torch.as_tensor(data[:T+args.N_test+args.N_washout+1,:node_num], dtype=torch.float32, device=device)\\n\",\n",
    "    \"    X_batch = torch.stack(\\n\",\n",
    "    \"        [shift_column_to_first(X, i) for i in range(node_num)],\\n\",\n",
    "    \"        dim=0\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"    args.n = node_num\\n\",\n",
    "    \"    args.N_train=T\\n\",\n",
    "    \"    ExpandNodes = args.n + math.comb(args.n - 1, 2)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    X_washout, X_train, Y_train, Y_test = split_dataset2_batch(\\n\",\n",
    "    \"        X_batch,\\n\",\n",
    "    \"        args.N_washout,\\n\",\n",
    "    \"        args.N_train,\\n\",\n",
    "    \"        args.N_test,\\n\",\n",
    "    \"        in_dim=args.n,\\n\",\n",
    "    \"        out_dim=args.n\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"\\n\",\n",
    "    \"    Win, Wres = Random_Win_Fixed_Wres(\\n\",\n",
    "    \"        ExpandNodes + 1,\\n\",\n",
    "    \"        n_units,\\n\",\n",
    "    \"        device,\\n\",\n",
    "    \"        block_dim=block_dim,\\n\",\n",
    "    \"        connectivity=connectivity\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"\\n\",\n",
    "    \"    node_times = []\\n\",\n",
    "    \"\\n\",\n",
    "    \"    for i in range(node_num):\\n\",\n",
    "    \"        torch.cuda.synchronize() if device.type == \\\"cuda\\\" else None\\n\",\n",
    "    \"        t0 = time.perf_counter()\\n\",\n",
    "    \"\\n\",\n",
    "    \"        pirc = Nonliear_PIRC(\\n\",\n",
    "    \"            n_units=n_units,\\n\",\n",
    "    \"            in_dim=args.n,\\n\",\n",
    "    \"            out_dim=args.n,\\n\",\n",
    "    \"            Win=Win,\\n\",\n",
    "    \"            Wres=Wres,\\n\",\n",
    "    \"            Expand=1,\\n\",\n",
    "    \"            sigma_in=sigma_in,\\n\",\n",
    "    \"            rho=rho,\\n\",\n",
    "    \"            alpha=alpha,\\n\",\n",
    "    \"            tikh=tikh,\\n\",\n",
    "    \"            mode=mode,\\n\",\n",
    "    \"            block_dim=block_dim,\\n\",\n",
    "    \"            I_type=I_type,\\n\",\n",
    "    \"            option=option,\\n\",\n",
    "    \"            device=device,\\n\",\n",
    "    \"            dt=args.dt,\\n\",\n",
    "    \"            bias=bias\\n\",\n",
    "    \"        )\\n\",\n",
    "    \"\\n\",\n",
    "    \"        R, rmse, rrmse = pirc.train(\\n\",\n",
    "    \"            X_washout[i:i + 1, :, :],\\n\",\n",
    "    \"            X_train[i:i + 1, :, :],\\n\",\n",
    "    \"            Y_train[i:i + 1, :, :]\\n\",\n",
    "    \"        )\\n\",\n",
    "    \"\\n\",\n",
    "    \"        Y_test_predict = pirc.Prediction2(\\n\",\n",
    "    \"            R,\\n\",\n",
    "    \"            args.N_test,\\n\",\n",
    "    \"            Y_train[i:i + 1, :, :],\\n\",\n",
    "    \"            Y_test[i:i + 1, :, :]\\n\",\n",
    "    \"        )\\n\",\n",
    "    \"\\n\",\n",
    "    \"        torch.cuda.synchronize() if device.type == \\\"cuda\\\" else None\\n\",\n",
    "    \"        t1 = time.perf_counter()\\n\",\n",
    "    \"        node_times.append(t1 - t0)\\n\",\n",
    "    \"\\n\",\n",
    "    \"        del pirc, R, rmse, rrmse, Y_test_predict\\n\",\n",
    "    \"        torch.cuda.empty_cache()\\n\",\n",
    "    \"\\n\",\n",
    "    \"    node_times = np.array(node_times)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    time_all[T] = node_times\\n\",\n",
    "    \"    time_mean.append(node_times.mean())\\n\",\n",
    "    \"    time_std.append(node_times.std())\\n\",\n",
    "    \"\\n\",\n",
    "    \"    print(\\n\",\n",
    "    \"        f\\\"T={T:3d} | \\\"\\n\",\n",
    "    \"        f\\\"time per node = {node_times.mean():.4f} ± {node_times.std():.4f} s\\\"\\n\",\n",
    "    \"    )\"\n",
