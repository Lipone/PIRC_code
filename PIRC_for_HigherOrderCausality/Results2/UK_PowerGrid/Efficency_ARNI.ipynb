    "   },\n",
    "   \"source\": [\n",
    "    \"import sys\\n\",\n",
    "    \"sys.path.append('/home/caoren/tmp/PIRC_for_HigherOrderCausality')\\n\",\n",
    "    \"import os\\n\",\n",
    "    \"os.chdir(\\\"/home/caoren/tmp/PIRC_for_HigherOrderCausality/Results2/UK_PowerGrid\\\")\\n\",\n",
    "    \"from Torch_Library import *\\n\",\n",
    "    \"# from DateGen_kuramoto import load_or_generate_kuramoto\\n\",\n",
    "    \"from Model.ARNI import ARNI, expand_nodes, basis_expansion\\n\",\n",
    "    \"from sklearn.metrics import roc_curve, auc\\n\",\n",
    "    \"from tqdm import tqdm\\n\",\n",
    "    \"from joblib import Parallel, delayed\\n\",\n",
    "    \"import pandas as pd\\n\",\n",
    "    \"import pickle\\n\",\n",
    "    \"import time\\n\",\n",
    "    \"import numpy as np\\n\",\n",
    "    \"import argparse\"\n",
    "   ],\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": 4\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-08-24T09:05:01.302414Z\",\n",
    "     \"start_time\": \"2026-08-24T09:05:01.265584Z\"\n",
    "    }\n",
    "   },\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"def read_data(args):\\n\",\n",
    "    \"    the = pd.read_csv(\\\"./dataset/data/theta.csv\\\").values[:, 1:].transpose()\\n\",\n",
    "    \"    theta = np.zeros((args.N, args.n, args.T, 1))\\n\",\n",
    "    \"    theta[0, :, :, 0] = the\\n\",\n",
    "    \"    Sd = pd.read_csv(\\\"./dataset/data/Sd.csv\\\").values[:, 1:]\\n\",\n",
    "    \"    Xs = pd.read_csv(\\\"./dataset/data/trajectory.csv\\\").values[:, 1:].transpose()\\n\",\n",
    "    \"    Xss = np.zeros((args.n, args.N * args.T, args.V))\\n\",\n",
    "    \"    Xsn = np.zeros((args.N, args.n, args.T, args.V))\\n\",\n",
    "    \"    for i in range(args.V):\\n\",\n",
    "    \"        Xss[:, :, i] = Xs[:, i * args.N * args.T:(i + 1) * args.N * args.T]\\n\",\n",
    "    \"    for i in range(args.N):\\n\",\n",
    "    \"        Xsn[i, :, :, :] = Xss[:, i * args.T:(i + 1) * args.T, :]\\n\",\n",
    "    \"    time_point = pd.read_csv(\\\"./dataset/data/time_point.csv\\\").values[:, 1:]\\n\",\n",
    "    \"    edges_out = pd.read_csv(\\\"./dataset/data/edges.csv\\\").values[:, 1:]\\n\",\n",
    "    \"    Xsn = torch.tensor(Xsn).float()\\n\",\n",
    "    \"    return (Xsn, theta, time_point, edges_out, Sd)\\n\",\n",
    "    \"\\n\",\n",
    "    \"def run_node(NODE, typ, base, order, X, Y_T, th=1e-4):\\n\",\n",
    "    \"    start_time=time.perf_counter()\\n\",\n",
    "    \"    try:\\n\",\n",
    "    \"        X_expanded = expand_nodes(\\n\",\n",
    "    \"            X.copy(),\\n\",\n",
    "    \"            NODE,\\n\",\n",
    "    \"            type=typ\\n\",\n",
    "    \"        )\\n\",\n",
    "    \"\\n\",\n",
    "    \"        llist, cost, vec = ARNI(\\n\",\n",
    "    \"            X_expanded.T,\\n\",\n",
    "    \"            Y_T,\\n\",\n",
    "    \"            base,\\n\",\n",
    "    \"            order,\\n\",\n",
    "    \"            NODE,\\n\",\n",
    "    \"            th=th\\n\",\n",
    "    \"        )\\n\",\n",
    "    \"\\n\",\n",
    "    \"        if not np.all(np.isfinite(vec)):\\n\",\n",
    "    \"            vec = np.zeros(X_expanded.shape[1])\\n\",\n",
    "    \"        end_time = time.perf_counter()\\n\",\n",
    "    \"        return NODE, vec, end_time-start_time\\n\",\n",
    "    \"\\n\",\n",
    "    \"    except np.linalg.LinAlgError:\\n\",\n",
    "    \"        ExpandNodes = X.shape[1] + math.comb(X.shape[1] - 1, 2)\\n\",\n",
    "    \"        end_time = time.perf_counter()\\n\",\n",
    "    \"        return NODE, np.zeros(ExpandNodes), end_time-start_time\\n\",\n",
    "    \"\\n\",\n",
    "    \"    except Exception as e:\\n\",\n",
    "    \"        ExpandNodes = X.shape[1] + math.comb(X.shape[1] - 1, 2)\\n\",\n",
    "    \"        print(f\\\"[WARN] NODE={NODE} failed: {e}\\\")\\n\",\n",
    "    \"        end_time = time.perf_counter()\\n\",\n",
    "    \"        return NODE, np.zeros(ExpandNodes), end_time-start_time\"\n",
    "   ],\n",
    "   \"id\": \"711313c9cc3c1b3b\",\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": 5\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-08-24T09:05:05.497775Z\",\n",
    "     \"start_time\": \"2026-08-24T09:05:03.394097Z\"\n",
    "    }\n",
    "   },\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"args = argparse.Namespace(\\n\",\n",
    "    \"    device='cpu',\\n\",\n",
    "    \"    data_ind='power_grid',\\n\",\n",
    "    \"    net_nam='edges',\\n\",\n",
    "    \"    direc=True,\\n\",\n",
    "    \"    N=1,\\n\",\n",
    "    \"    n=120,\\n\",\n",
    "    \"    T=10000,\\n\",\n",
    "    \"    V=2,\\n\",\n",
    "    \"    dt=0.08,\\n\",\n",
    "    \"    ddt=0.02,\\n\",\n",
    "    \"    N_train=100,\\n\",\n",
    "    \"    N_test=10,\\n\",\n",
    "    \"    N_washout=0,\\n\",\n",
    "    \"    N_start=0,\\n\",\n",
    "    \"    n_trials=500,\\n\",\n",
    "    \"    Threshold=1e-3,\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"(Xsn, theta, time_point, edges_out, Sd) = read_data(args)\\n\",\n",
    "    \"data=theta.squeeze().T #T*n\\n\",\n",
    "    \"set_seed(42)\\n\",\n",
    "    \"with open(\\\"results/ARNI2_result_test.pkl\\\", \\\"rb\\\") as f:\\n\",\n",
    "    \"    result = pickle.load(f)\\n\",\n",
    "    \"params=result[\\\"best_params\\\"]\\n\",\n",
    "    \"basis_order=params[\\\"basis_order\\\"]\\n\",\n",
    "    \"th=params[\\\"th\\\"]\\n\",\n",
    "    \"typ=params[\\\"type\\\"]\\n\",\n",
    "    \"base=\\\"fourier\\\"\"\n",
    "   ],\n",
    "   \"id\": \"625febbb9d4be2ca\",\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": 6\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-08-24T09:05:36.267151Z\",\n",
    "     \"start_time\": \"2026-08-24T09:05:09.220139Z\"\n",
    "    }\n",
    "   },\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"node_nums = [120]\\n\",\n",
    "    \"T = 100\\n\",\n",
    "    \"ExpandNodes = args.n + math.comb(args.n - 1, 2)\\n\",\n",
    "    \"\\n\",\n",
    "    \"time_mean = []\\n\",\n",
    "    \"time_std = []\\n\",\n",
    "    \"time_all = {}\\n\",\n",
    "    \"node_times = []\\n\",\n",
    "    \"\\n\",\n",
    "    \"data_full = data.copy()\\n\",\n",
    "    \"\\n\",\n",
    "    \"for node_num in node_nums:\\n\",\n",
    "    \"    data_now = data_full[:T, :node_num]\\n\",\n",
    "    \"    X1 = data_now[:-1, :]\\n\",\n",
    "    \"    X2 = data_now[1:, :]\\n\",\n",
    "    \"    X = (X1 + X2) * 0.5\\n\",\n",
    "    \"    X = X % (2 * np.pi)\\n\",\n",
    "    \"    Y = (X2 - X1) / args.dt\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # ===== shared Taylor dictionary construction =====\\n\",\n",
    "    \"    T_from_Ainf = np.zeros((args.n, ExpandNodes))\\n\",\n",
    "    \"    Y_T = Y.T\\n\",\n",
    "    \"    results = Parallel(n_jobs=-1)(\\n\",\n",
    "    \"                delayed(run_node)(\\n\",\n",
    "    \"                    NODE,\\n\",\n",
    "    \"                    typ,\\n\",\n",
    "    \"                    base,\\n\",\n",
    "    \"                    basis_order,\\n\",\n",
    "    \"                    X,\\n\",\n",
    "    \"                    Y_T,\\n\",\n",
    "    \"                    th=th\\n\",\n",
    "    \"                )\\n\",\n",
    "    \"                for NODE in range(args.n)\\n\",\n",
    "    \"            )\\n\",\n",
    "    \"    for NODE, vec, running_time in results:\\n\",\n",
    "    \"        node_times.append(running_time)\\n\",\n",
    "    \"    node_times = np.asarray(node_times)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    time_all[node_num] = node_times\\n\",\n",
    "    \"\\n\",\n",
    "    \"    time_mean.append(node_times.mean())\\n\",\n",
    "    \"\\n\",\n",
    "    \"    time_std.append(node_times.std())\\n\",\n",
    "    \"    print(\\n\",\n",
    "    \"        f\\\"N={node_num:3d} | \\\"\\n\",\n",
    "    \"        f\\\"ARNI time per node = {node_times.mean():.4f} ± {node_times.std():.4f} s \\\"\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"\\n\",\n",
    "    \"save_dict = {\\n\",\n",
    "    \"    \\\"node_nums\\\": node_nums,\\n\",\n",
    "    \"    \\\"T\\\": T,\\n\",\n",
    "    \"    \\\"params\\\": params,\\n\",\n",
    "    \"    \\\"time_mean\\\": np.asarray(time_mean),\\n\",\n",
    "    \"    \\\"time_std\\\": np.asarray(time_std),\\n\",\n",
    "    \"    \\\"time_all\\\": time_all,\\n\",\n",
    "    \"}\\n\",\n",
    "    \"\\n\",\n",
    "    \"with open(\\\"ARNI2_time_scaling.pkl\\\", \\\"wb\\\") as f:\\n\",\n",
    "    \"    pickle.dump(save_dict, f)\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"Results saved to ARNI2_time_scaling.pkl\\\")\"\n",
    "   ],\n",
