    "{\n",
    " \"cells\": [\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"initial_id\",\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-08-24T12:59:46.816982Z\",\n",
    "     \"start_time\": \"2026-08-24T12:59:45.680567Z\"\n",
    "    }\n",
    "   },\n",
    "   \"source\": [\n",
    "    \"import sys\\n\",\n",
    "    \"sys.path.append('/home/caoren/tmp/PIRC_for_HigherOrderCausality')\\n\",\n",
    "    \"from Model.this import *\\n\",\n",
    "    \"import os\\n\",\n",
    "    \"os.chdir(\\\"/home/caoren/tmp/PIRC_for_HigherOrderCausality/Results/EEG\\\")\\n\",\n",
    "    \"import math\\n\",\n",
    "    \"import numpy as np\\n\",\n",
    "    \"import matplotlib.pyplot as plt\\n\",\n",
    "    \"import pickle\\n\",\n",
    "    \"import torch\\n\",\n",
    "    \"from collections import Counter\\n\",\n",
    "    \"from itertools import combinations\"\n",
    "   ],\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": 1\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-08-24T13:00:25.471845Z\",\n",
    "     \"start_time\": \"2026-08-24T13:00:25.439005Z\"\n",
    "    }\n",
    "   },\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"def top_freq_per_sequence(Ainf_list, order=3, top_n=5, threshold=None):\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    每个序列：\\n\",\n",
    "    \"    1. 可选：剔除 |weight| < threshold 的边\\n\",\n",
    "    \"    2. 按 |weight| 从大到小排序\\n\",\n",
    "    \"    3. 取 top_n\\n\",\n",
    "    \"    4. 统计超边出现频率\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    all_top_edges = []\\n\",\n",
    "    \"\\n\",\n",
    "    \"    for Ainf in Ainf_list:\\n\",\n",
    "    \"        if order not in Ainf or Ainf[order].shape[0] == 0:\\n\",\n",
    "    \"            continue\\n\",\n",
    "    \"\\n\",\n",
    "    \"        edges = Ainf[order]\\n\",\n",
    "    \"        weights = np.abs(edges[:, -1])\\n\",\n",
    "    \"\\n\",\n",
    "    \"        if threshold is not None:\\n\",\n",
    "    \"            valid = weights >= threshold\\n\",\n",
    "    \"            edges = edges[valid]\\n\",\n",
    "    \"            weights = weights[valid]\\n\",\n",
    "    \"\\n\",\n",
    "    \"        if len(weights) == 0:\\n\",\n",
    "    \"            continue\\n\",\n",
    "    \"\\n\",\n",
    "    \"        k = min(top_n, len(weights))\\n\",\n",
    "    \"        idx_top = np.argsort(weights)[-k:][::-1]\\n\",\n",
    "    \"\\n\",\n",
    "    \"        top_edges = edges[idx_top, :order]\\n\",\n",
    "    \"\\n\",\n",
    "    \"        for row in top_edges:\\n\",\n",
    "    \"            row = row.astype(int)\\n\",\n",
    "    \"\\n\",\n",
    "    \"            if order == 3:\\n\",\n",
    "    \"                target = int(row[0])\\n\",\n",
    "    \"                j, k0 = sorted([int(row[1]), int(row[2])])\\n\",\n",
    "    \"                edge = (target, j, k0)\\n\",\n",
    "    \"            else:\\n\",\n",
    "    \"                edge = tuple(row)\\n\",\n",
    "    \"\\n\",\n",
    "    \"            all_top_edges.append(edge)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    return Counter(all_top_edges)\\n\",\n",
    "    \"\\n\",\n",
    "    \"def build_T_to_Ainf(T_from_Ainf, max_order=3):\\n\",\n",
    "    \"    T_to_Ainf = {o: [] for o in range(2, max_order + 1)}\\n\",\n",
    "    \"\\n\",\n",
    "    \"    row, col = T_from_Ainf.shape\\n\",\n",
    "    \"    node_num = row\\n\",\n",
    "    \"\\n\",\n",
    "    \"    for i in range(row):\\n\",\n",
    "    \"        for j in range(col):\\n\",\n",
    "    \"            val = T_from_Ainf[i, j]\\n\",\n",
    "    \"\\n\",\n",
    "    \"            if val == 0:\\n\",\n",
    "    \"                continue\\n\",\n",
    "    \"\\n\",\n",
    "    \"            if j < node_num:\\n\",\n",
    "    \"                if j != i:\\n\",\n",
    "    \"                    T_to_Ainf[2].append([i, j, val])\\n\",\n",
    "    \"\\n\",\n",
    "    \"            elif j < node_num + math.comb(node_num - 1, 2):\\n\",\n",
    "    \"                idx = j - node_num\\n\",\n",
    "    \"                others = [x for x in range(node_num) if x != i]\\n\",\n",
    "    \"                comb_list = list(combinations(others, 2))\\n\",\n",
    "    \"                j0, k0 = comb_list[idx]\\n\",\n",
    "    \"                T_to_Ainf[3].append([i, j0, k0, val])\\n\",\n",
    "    \"\\n\",\n",
    "    \"            elif max_order == 4:\\n\",\n",
    "    \"                idx = j - node_num - math.comb(node_num - 1, 2)\\n\",\n",
    "    \"                others = [x for x in range(node_num) if x != i]\\n\",\n",
    "    \"                comb_list = list(combinations(others, 3))\\n\",\n",
    "    \"                j0, k0, l0 = comb_list[idx]\\n\",\n",
    "    \"                T_to_Ainf[4].append([i, j0, k0, l0, val])\\n\",\n",
    "    \"\\n\",\n",
    "    \"    for o in T_to_Ainf:\\n\",\n",
    "    \"        T_to_Ainf[o] = (\\n\",\n",
    "    \"            np.array(T_to_Ainf[o])\\n\",\n",
    "    \"            if len(T_to_Ainf[o]) > 0\\n\",\n",
    "    \"            else np.zeros((0, o + 1))\\n\",\n",
    "    \"        )\\n\",\n",
    "    \"\\n\",\n",
    "    \"    return T_to_Ainf\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"with open(\\\"PIRC_result.pkl\\\", \\\"rb\\\") as f:\\n\",\n",
    "    \"    data = pickle.load(f)\\n\",\n",
    "    \"    PIRC_Score=data[\\\"Score_all\\\"]\"\n",
    "   ],\n",
    "   \"id\": \"ba635b6f43eb84ab\",\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": 3\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-08-24T13:00:26.658114Z\",\n",
    "     \"start_time\": \"2026-08-24T13:00:26.492944Z\"\n",
    "    }\n",
    "   },\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"\\n\",\n",
    "    \"with open(\\\"THIS_result.pkl\\\", \\\"rb\\\") as f:\\n\",\n",
    "    \"    data = pickle.load(f)\\n\",\n",
    "    \"    THIS_Score=data[\\\"Score_all\\\"]\\n\",\n",
    "    \"\\n\",\n",
    "    \"with open(\\\"ARNI1_result.pkl\\\", \\\"rb\\\") as f:\\n\",\n",
    "    \"    data = pickle.load(f)\\n\",\n",
    "    \"    ARNI1_Score=data[\\\"Score_all\\\"]\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"with open(\\\"ARNI2_result.pkl\\\", \\\"rb\\\") as f:\\n\",\n",
    "    \"    data = pickle.load(f)\\n\",\n",
    "    \"    ARNI2_Score=data[\\\"Score_all\\\"]\\n\",\n",
    "    \"\\n\",\n",
    "    \"def high_order_ratio(Score, n=7):\\n\",\n",
    "    \"    if torch.is_tensor(Score):\\n\",\n",
    "    \"        Score = Score.detach().cpu().numpy()\\n\",\n",
    "    \"    Score = np.asarray(Score).copy()\\n\",\n",
    "    \"    for i in range(n):\\n\",\n",
    "    \"        Score[i, i] = 0.0\\n\",\n",
    "    \"    higher = Score[:, n:].sum()\\n\",\n",
    "    \"    total = Score.sum()\\n\",\n",
    "    \"    return higher / (total + 1e-12)\\n\",\n",
    "    \"\\n\",\n",
    "    \"data_plot = []\\n\",\n",
    "    \"for method in [PIRC_Score,THIS_Score,ARNI1_Score,ARNI2_Score]:\\n\",\n",
    "    \"    data_plot.append(np.array([high_order_ratio(S, n=7) for S in method]))\\n\",\n",
    "    \"\\n\",\n",
    "    \"top_select = 5\\n\",\n",
    "    \"\\n\",\n",
    "    \"Ainf_PIRC_list = [\\n\",\n",
    "    \"    build_T_to_Ainf(\\n\",\n",
    "    \"        Score.detach().cpu().numpy()\\n\",\n",
    "    \"        if torch.is_tensor(Score)\\n\",\n",
    "    \"        else np.asarray(Score),\\n\",\n",
    "    \"        max_order=3\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"    for Score in PIRC_Score\\n\",\n",
    "    \"]\\n\",\n",
    "    \"\\n\",\n",
    "    \"freq_PIRC = top_freq_per_sequence(\\n\",\n",
    "    \"    Ainf_PIRC_list,\\n\",\n",
    "    \"    order=3,\\n\",\n",
    "    \"    top_n=top_select,\\n\",\n",
    "    \"    threshold=None\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"top5_edges = freq_PIRC.most_common(5)\\n\",\n",
    "    \"\\n\",\n",
    "    \"rho_all = np.array([\\n\",\n",
    "    \"    high_order_ratio(S, n=7)\\n\",\n",
    "    \"    for S in PIRC_Score\\n\",\n",
    "    \"])\\n\",\n",
    "    \"\\n\",\n",
    "    \"rho_mean = float(rho_all.mean())\\n\",\n",
    "    \"rho_std = float(rho_all.std())\\n\",\n",
    "    \"\\n\",\n",
    "    \"top5_all_target0 = (\\n\",\n",
    "    \"    len(top5_edges) >= 5\\n\",\n",
    "    \"    and all(edge[0] == 0 for edge, count in top5_edges)\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(f\\\"rho_all: {rho_mean:.4f} ± {rho_std:.4f}\\\")\\n\",\n",
    "    \"print(\\\"Top5:\\\", top5_edges)\\n\",\n",
    "    \"print(\\\"Top5 all target 0:\\\", top5_all_target0)\\n\"\n",
    "   ],\n",
