    "      \"rho_all: 0.5950 ± 0.1652\\n\",\n",
    "      \"Top5: [((0, 2, 6), 23), ((0, 1, 2), 22), ((0, 1, 3), 21), ((0, 2, 3), 20), ((0, 2, 5), 18)]\\n\",\n",
    "      \"Top5 all target 0: True\\n\"\n",
    "     ]\n",
    "    }\n",
    "   ],\n",
