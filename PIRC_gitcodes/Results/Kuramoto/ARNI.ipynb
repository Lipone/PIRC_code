    "    \"print(\\\"max R:\\\", np.max(R))\\n\",\n",
    "    \"theta_tail = theta[len(theta) // 2:]\\n\",\n",
    "    \"dtheta = np.angle(\\n\",\n",
    "    \"    np.exp(1j * (theta_tail[:, :, None] - theta_tail[:, None, :]))\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"phase_diff_std = np.mean(np.std(dtheta, axis=0))\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"mean phase-difference std:\\\", phase_diff_std)\\n\",\n",
    "    \"\\n\",\n",
    "    \"T_Matrix=np.zeros((args.node_num, ExpandNodes))\\n\",\n",
    "    \"T_Matrix[:, :args.node_num] = (a2 != 0).astype(int)\\n\",\n",
    "    \"for i in range(args.node_num):\\n\",\n",
