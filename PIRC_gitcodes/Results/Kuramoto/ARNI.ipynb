    "    \"    Tri_strength=0.4,\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"ExpandNodes = args.node_num + math.comb(args.node_num - 1, 2)\\n\",\n",
    "    \"set_seed(42)\\n\",\n",
    "    \"data, a2, a3 = load_or_generate_kuramoto(args)\\n\",\n",
    "    \"data = data[args.N_start:,]\\n\",\n",
    "    \"theta = data  # shape: (T, N)，你的 kuramoto 生成的是相位\\n\",\n",
    "    \"R = np.abs(np.mean(np.exp(1j * theta), axis=1))\\n\",\n",
