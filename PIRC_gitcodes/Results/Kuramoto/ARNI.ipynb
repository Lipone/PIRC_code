    "   \"metadata\": {},\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"def run_node(\\n\",\n",
    "    \"    NODE,\\n\",\n",
    "    \"    typ,\\n\",\n",
    "    \"    base,\\n\",\n",
    "    \"    order,\\n\",\n",
    "    \"    expanded_cache,\\n\",\n",
    "    \"    Y_T,\\n\",\n",
    "    \"    th=1e-4\\n\",\n",
    "    \"):\\n\",\n",
    "    \"    X_expanded = expanded_cache[(NODE, typ)]\\n\",\n",
    "    \"    X_expanded_T = X_expanded.T\\n\",\n",
    "    \"    try:\\n\",\n",
    "    \"        llist, cost, vec = ARNI(\\n\",\n",
    "    \"            X_expanded_T,\\n\",\n",
    "    \"            Y_T,\\n\",\n",
    "    \"            base,\\n\",\n",
    "    \"            order,\\n\",\n",
    "    \"            NODE,\\n\",\n",
    "    \"            th=th\\n\",\n",
    "    \"        )\\n\",\n",
    "    \"    except np.linalg.LinAlgError:\\n\",\n",
    "    \"        return NODE, np.zeros(ExpandNodes), np.zeros(Y_T.shape[1])\\n\",\n",
    "    \"    X_basis = basis_expansion(\\n\",\n",
    "    \"        X_expanded_T,\\n\",\n",
    "    \"        order,\\n\",\n",
    "    \"        base,\\n\",\n",
    "    \"        NODE\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"    y_pred = np.zeros(Y_T.shape[1])\\n\",\n",
    "    \"    if len(llist) > 0:\\n\",\n",
    "    \"        R = np.vstack([\\n\",\n",
    "    \"            X_basis[:, :, idx]\\n\",\n",
    "    \"            for idx in llist\\n\",\n",
    "    \"        ])\\n\",\n",
    "    \"        try:\\n\",\n",
    "    \"            RI = np.linalg.pinv(R)\\n\",\n",
    "    \"            A = Y_T[NODE] @ RI\\n\",\n",
    "    \"            y_pred = A @ R\\n\",\n",
    "    \"        except np.linalg.LinAlgError:\\n\",\n",
    "    \"            pass\\n\",\n",
    "    \"    return NODE, vec, y_pred\\n\",\n",
    "    \"\\n\",\n",
    "    \"def rrmse_per_node(Y_true, Y_pred, eps=1e-12):\\n\",\n",
    "    \"    Y_true = np.asarray(Y_true)\\n\",\n",
    "    \"    Y_pred = np.asarray(Y_pred)\\n\",\n",
    "    \"    rmse = np.sqrt(np.mean((Y_true - Y_pred) ** 2, axis=1))\\n\",\n",
    "    \"    scale = np.sqrt(np.mean(Y_true ** 2, axis=1)) + eps\\n\",\n",
    "    \"    return rmse, rmse / scale\\n\",\n",
    "    \"\\n\",\n",
    "    \"params=result[\\\"best_params\\\"]\\n\",\n",
    "    \"basis_order=params[\\\"basis_order\\\"]\\n\",\n",
    "    \"th=params[\\\"th\\\"]\\n\",\n",
    "    \"type=params[\\\"type\\\"]\\n\",\n",
    "    \"base='polynomial'\\n\",\n",
    "    \"\\n\",\n",
    "    \"T_from_Ainf = np.zeros((args.node_num, ExpandNodes))\\n\",\n",
    "    \"X1 = data[:-1, :]\\n\",\n",
    "    \"X2 = data[1:, :]\\n\",\n",
    "    \"X = (X1 + X2) * 0.5\\n\",\n",
    "    \"X = X % (2 * np.pi)\\n\",\n",
    "    \"Y = (data[1:, :] - data[:-1, :]) / args.dt\\n\",\n",
    "    \"Y_T = Y.T\\n\",\n",
    "    \"\\n\",\n",
    "    \"expanded_cache = {}\\n\",\n",
    "    \"for NODE in range(args.node_num):\\n\",\n",
    "    \"    expanded_cache[(NODE, type)] = expand_nodes(\\n\",\n",
    "    \"        X.copy(),\\n\",\n",
    "    \"        NODE,\\n\",\n",
    "    \"        type=type\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"T_from_Ainf = np.zeros((args.node_num, ExpandNodes))\\n\",\n",
    "    \"Y_pred = np.zeros_like(Y_T)\\n\",\n",
    "    \"results = Parallel(n_jobs=-1)(\\n\",\n",
    "    \"    delayed(run_node)(\\n\",\n",
    "    \"        NODE,\\n\",\n",
    "    \"        type,\\n\",\n",
    "    \"        base,\\n\",\n",
    "    \"        basis_order,\\n\",\n",
    "    \"        expanded_cache,\\n\",\n",
    "    \"        Y_T,\\n\",\n",
    "    \"        th=th\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"    for NODE in range(args.node_num)\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"for NODE, vec, pred in results:\\n\",\n",
    "    \"    T_from_Ainf[NODE] = vec\\n\",\n",
    "    \"    Y_pred[NODE] = pred\\n\",\n",
    "    \"rmse, rrmse = rrmse_per_node(Y_T, Y_pred)\\n\",\n",
    "    \"AUC = ranking_auc_ALL(T_from_Ainf, T_Matrix)\\n\",\n",
    "    \"AUC = AUC.item() if hasattr(AUC, \\\"item\\\") else float(AUC)\\n\",\n",
    "    \"print(AUC)\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"Mean RMSE :\\\", np.mean(rmse))\\n\",\n",
    "    \"print(\\\"Mean RRMSE:\\\", np.mean(rrmse))\"\n",
    "   ],\n",
