    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"args = argparse.Namespace(\\n\",\n",
    "    \"    node_num=20,\\n\",\n",
    "    \"    N_train=1000,\\n\",\n",
    "    \"    N_test=10,\\n\",\n",
    "    \"    N_washout=0,\\n\",\n",
    "    \"    N_start=0,\\n\",\n",
    "    \"    dt=0.08,\\n\",\n",
    "    \"    P_probability=0.05,\\n\",\n",
    "    \"    T_probability=0.005,\\n\",\n",
    "    \"    Pair_strength=0.4,\\n\",\n",
    "    \"    Tri_strength=0.4,\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"ExpandNodes = args.node_num + math.comb(args.node_num - 1, 2)\\n\",\n",
    "    \"set_seed(42)\\n\",\n",
    "    \"data, a2, a3 = load_or_generate_kuramoto(args)\\n\",\n",
    "    \"data = data[args.N_start:,]\\n\",\n",
    "    \"theta = data  # shape: (T, N)，你的 kuramoto 生成的是相位\\n\",\n",
    "    \"R = np.abs(np.mean(np.exp(1j * theta), axis=1))\\n\",\n",
    "    \"print(\\\"mean R last half:\\\", np.mean(R[len(R) // 2:]))\\n\",\n",
    "    \"print(\\\"max R:\\\", np.max(R))\\n\",\n",
    "    \"theta_tail = theta[len(theta) // 2:]\\n\",\n",
    "    \"dtheta = np.angle(\\n\",\n",
    "    \"    np.exp(1j * (theta_tail[:, :, None] - theta_tail[:, None, :]))\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"phase_diff_std = np.mean(np.std(dtheta, axis=0))\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"mean phase-difference std:\\\", phase_diff_std)\\n\",\n",
    "    \"\\n\",\n",
    "    \"T_Matrix=np.zeros((args.node_num, ExpandNodes))\\n\",\n",
    "    \"T_Matrix[:, :args.node_num] = (a2 != 0).astype(int)\\n\",\n",
    "    \"for i in range(args.node_num):\\n\",\n",
    "    \"    com_list=list(combinations([x for x in range(args.node_num) if x != i], 2))\\n\",\n",
    "    \"    for index,(j,k) in enumerate(com_list):\\n\",\n",
    "    \"        T_Matrix[i, args.node_num+index] = int(a3[i][j][k] != 0)\\n\",\n",
    "    \"print(\\\"ground_truth\\\", T_Matrix)\\n\",\n",
    "    \"count_Pair = np.count_nonzero(T_Matrix[:, :args.node_num])\\n\",\n",
    "    \"count_Tri = np.count_nonzero(T_Matrix[:, args.node_num:])\\n\",\n",
    "    \"print(\\\"pair:\\\", count_Pair)\\n\",\n",
    "    \"print(\\\"Tri:\\\", count_Tri)\"\n",
    "   ],\n",
