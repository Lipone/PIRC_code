    "   },\n",
    "   \"source\": [\n",
    "    \"import sys\\n\",\n",
    "    \"sys.path.append('/home/caoren/tmp/PIRC_for_HigherOrderCausality')\\n\",\n",
    "    \"import os\\n\",\n",
    "    \"os.chdir(\\\"/home/caoren/tmp/PIRC_for_HigherOrderCausality/Results/Kuramoto\\\")\\n\",\n",
    "    \"from Torch_Library import *\\n\",\n",
    "    \"import argparse\\n\",\n",
    "    \"import numpy as np\\n\",\n",
    "    \"import pickle\\n\",\n",
    "    \"from sklearn.metrics import roc_curve, auc\\n\",\n",
    "    \"import matplotlib.pyplot as plt\\n\",\n",
    "    \"import matplotlib as mpl\"\n",
    "   ],\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": 26\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-07-11T18:54:11.567512Z\",\n",
    "     \"start_time\": \"2026-07-11T18:54:10.940688Z\"\n",
    "    }\n",
    "   },\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"import os\\n\",\n",
    "    \"import pickle\\n\",\n",
    "    \"import math\\n\",\n",
    "    \"import numpy as np\\n\",\n",
    "    \"import matplotlib.pyplot as plt\\n\",\n",
    "    \"import matplotlib as mpl\\n\",\n",
    "    \"import xgi\\n\",\n",
    "    \"\\n\",\n",
    "    \"from itertools import combinations\\n\",\n",
    "    \"from matplotlib.patches import FancyArrowPatch\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ============================================================\\n\",\n",
    "    \"# 0. 参数设置\\n\",\n",
    "    \"# ============================================================\\n\",\n",
    "    \"data_path = \\\"results/kuramoto_10_trajectories.pkl\\\"\\n\",\n",
    "    \"\\n\",\n",
    "    \"structure_index = 4       # 选择第几个结构，范围 0~9\\n\",\n",
    "    \"threshold = 1e-12         # 判断是否存在连边的阈值\\n\",\n",
    "    \"\\n\",\n",
    "    \"save_dir = \\\"results\\\"\\n\",\n",
    "    \"save_name = f\\\"HyperGraph_structure_{structure_index + 1}\\\"\\n\",\n",
    "    \"\\n\",\n",
    "    \"os.makedirs(save_dir, exist_ok=True)\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ============================================================\\n\",\n",
    "    \"# 1. 绘图格式\\n\",\n",
    "    \"# ============================================================\\n\",\n",
    "    \"mpl.rcParams.update({\\n\",\n",
    "    \"    \\\"font.family\\\": \\\"serif\\\",\\n\",\n",
    "    \"    \\\"font.serif\\\": [\\\"Times New Roman\\\", \\\"DejaVu Serif\\\"],\\n\",\n",
    "    \"    \\\"mathtext.fontset\\\": \\\"stix\\\",\\n\",\n",
    "    \"    \\\"svg.fonttype\\\": \\\"none\\\",\\n\",\n",
    "    \"    \\\"pdf.fonttype\\\": 42,\\n\",\n",
    "    \"    \\\"ps.fonttype\\\": 42,\\n\",\n",
    "    \"})\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ============================================================\\n\",\n",
    "    \"# 2. 读取结构矩阵\\n\",\n",
    "    \"# ============================================================\\n\",\n",
    "    \"with open(data_path, \\\"rb\\\") as f:\\n\",\n",
    "    \"    result = pickle.load(f)\\n\",\n",
    "    \"\\n\",\n",
    "    \"T_list = result[\\\"T_list\\\"]\\n\",\n",
    "    \"\\n\",\n",
    "    \"if not 0 <= structure_index < len(T_list):\\n\",\n",
    "    \"    raise IndexError(\\n\",\n",
    "    \"        f\\\"structure_index={structure_index} 超出范围，\\\"\\n\",\n",
    "    \"        f\\\"T_list 中共有 {len(T_list)} 个结构。\\\"\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"\\n\",\n",
    "    \"T = np.asarray(T_list[structure_index], dtype=float)\\n\",\n",
    "    \"\\n\",\n",
    "    \"if T.ndim != 2:\\n\",\n",
    "    \"    raise ValueError(\\n\",\n",
    "    \"        f\\\"T 必须是二维矩阵，但当前形状为 {T.shape}。\\\"\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"\\n\",\n",
    "    \"node_num = T.shape[0]\\n\",\n",
    "    \"\\n\",\n",
    "    \"expected_columns = (\\n\",\n",
    "    \"    node_num\\n\",\n",
    "    \"    + math.comb(node_num - 1, 2)\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"if T.shape[1] != expected_columns:\\n\",\n",
    "    \"    raise ValueError(\\n\",\n",
    "    \"        f\\\"T 的形状为 {T.shape}，\\\"\\n\",\n",
    "    \"        f\\\"但按照当前编码应为 \\\"\\n\",\n",
    "    \"        f\\\"({node_num}, {expected_columns})。\\\"\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"=\\\" * 60)\\n\",\n",
    "    \"print(\\\"Selected structure:\\\", structure_index + 1)\\n\",\n",
    "    \"print(\\\"T shape:\\\", T.shape)\\n\",\n",
    "    \"print(\\\"Node number:\\\", node_num)\\n\",\n",
    "    \"print(\\\"=\\\" * 60)\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ============================================================\\n\",\n",
    "    \"# 3. 从 T 中提取二元边和三元超边\\n\",\n",
    "    \"#\\n\",\n",
    "    \"# T[target, source]:\\n\",\n",
    "    \"#     source -> target\\n\",\n",
    "    \"#\\n\",\n",
    "    \"# T[target, node_num + k]:\\n\",\n",
    "    \"#     {source_1, source_2} -> target\\n\",\n",
    "    \"#\\n\",\n",
    "    \"# 注意：\\n\",\n",
    "    \"# 三元超边只画蓝色区域，不画任何蓝色箭头。\\n\",\n",
    "    \"# ============================================================\\n\",\n",
    "    \"pair_edges = []\\n\",\n",
    "    \"hyperedges = []\\n\",\n",
    "    \"\\n\",\n",
    "    \"for target in range(node_num):\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # --------------------------------------------------------\\n\",\n",
    "    \"    # 二元有向连接：source -> target\\n\",\n",
    "    \"    # --------------------------------------------------------\\n\",\n",
    "    \"    for source in range(node_num):\\n\",\n",
    "    \"\\n\",\n",
    "    \"        # 忽略自身作用\\n\",\n",
    "    \"        if source == target:\\n\",\n",
    "    \"            continue\\n\",\n",
    "    \"\\n\",\n",
    "    \"        value = T[target, source]\\n\",\n",
    "    \"\\n\",\n",
    "    \"        if np.isfinite(value) and abs(value) > threshold:\\n\",\n",
    "    \"            pair_edges.append((source, target))\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # --------------------------------------------------------\\n\",\n",
    "    \"    # 三元超边：{source_1, source_2, target}\\n\",\n",
    "    \"    # 只用于绘制蓝色 hull\\n\",\n",
    "    \"    # --------------------------------------------------------\\n\",\n",
    "    \"    source_nodes = [\\n\",\n",
    "    \"        node\\n\",\n",
    "    \"        for node in range(node_num)\\n\",\n",
    "    \"        if node != target\\n\",\n",
    "    \"    ]\\n\",\n",
    "    \"\\n\",\n",
    "    \"    source_pairs = list(\\n\",\n",
    "    \"        combinations(source_nodes, 2)\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"\\n\",\n",
    "    \"    for local_index, (source_1, source_2) in enumerate(\\n\",\n",
    "    \"        source_pairs\\n\",\n",
    "    \"    ):\\n\",\n",
    "    \"        column = node_num + local_index\\n\",\n",
    "    \"        value = T[target, column]\\n\",\n",
    "    \"\\n\",\n",
    "    \"        if np.isfinite(value) and abs(value) > threshold:\\n\",\n",
    "    \"            hyperedges.append(\\n\",\n",
    "    \"                (source_1, source_2, target)\\n\",\n",
    "    \"            )\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"Pairwise edges:\\\")\\n\",\n",
    "    \"print(pair_edges)\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"\\\\nTriadic hyperedges:\\\")\\n\",\n",
    "    \"print(hyperedges)\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"\\\\nNumber of pairwise edges:\\\", len(pair_edges))\\n\",\n",
    "    \"print(\\\"Number of triadic hyperedges:\\\", len(hyperedges))\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ============================================================\\n\",\n",
    "    \"# 4. 创建 XGI 超图\\n\",\n",
    "    \"#\\n\",\n",
    "    \"# 为避免 XGI 自动画出无向二元边，\\n\",\n",
    "    \"# H 中只加入三元超边。\\n\",\n",
    "    \"# 二元有向边后面用 FancyArrowPatch 单独绘制。\\n\",\n",
    "    \"# ============================================================\\n\",\n",
    "    \"H = xgi.Hypergraph()\\n\",\n",
    "    \"\\n\",\n",
    "    \"# 加入所有节点，包括孤立节点\\n\",\n",
    "    \"H.add_nodes_from(range(node_num))\\n\",\n",
    "    \"\\n\",\n",
    "    \"# 只加入三元超边\\n\",\n",
    "    \"for source_1, source_2, target in hyperedges:\\n\",\n",
    "    \"    H.add_edge([source_1, source_2, target])\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ============================================================\\n\",\n",
    "    \"# 5. 节点布局\\n\",\n",
    "    \"# ============================================================\\n\",\n",
    "    \"pos = xgi.circular_layout(H)\\n\",\n",
    "    \"\\n\",\n",
    "    \"fig, ax = plt.subplots(figsize=(5.2, 5.2))\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ============================================================\\n\",\n",
    "    \"# 6. 绘制节点和三元超边区域\\n\",\n",
    "    \"#\\n\",\n",
    "    \"# 三元连接：\\n\",\n",
    "    \"#     蓝色半透明 hull\\n\",\n",
    "    \"#\\n\",\n",
    "    \"# 二元连接：\\n\",\n",
    "    \"#     后面单独画黑色有向箭头\\n\",\n",
    "    \"# ============================================================\\n\",\n",
    "    \"xgi.draw(\\n\",\n",
    "    \"    H,\\n\",\n",
    "    \"    pos=pos,\\n\",\n",
    "    \"    ax=ax,\\n\",\n",
    "    \"\\n\",\n",
    "    \"    node_labels=True,\\n\",\n",
    "    \"    node_size=20,\\n\",\n",
    "    \"    node_lw=1.0,\\n\",\n",
    "    \"    node_ec=\\\"black\\\",\\n\",\n",
    "    \"\\n\",\n",
    "    \"    hull=True,\\n\",\n",
    "    \"    edge_fc=\\\"#6f94d4\\\",\\n\",\n",
    "    \"    alpha=0.35,\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # H 中没有二元边，这里仍显式关闭 dyad\\n\",\n",
    "    \"    dyad_color=\\\"none\\\",\\n\",\n",
    "    \"    dyad_lw=0,\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ============================================================\\n\",\n",
    "    \"# 7. 绘制二元有向连接 source -> target\\n\",\n",
    "    \"# ============================================================\\n\",\n",
    "    \"for source, target in pair_edges:\\n\",\n",
    "    \"    x1, y1 = pos[source]\\n\",\n",
    "    \"    x2, y2 = pos[target]\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # 双向边使用相反弯曲方向，避免完全重叠\\n\",\n",
    "    \"    if source < target:\\n\",\n",
    "    \"        rad = 0.18\\n\",\n",
    "    \"    else:\\n\",\n",
    "    \"        rad = -0.18\\n\",\n",
    "    \"\\n\",\n",
    "    \"    arrow = FancyArrowPatch(\\n\",\n",
    "    \"        (x1, y1),\\n\",\n",
    "    \"        (x2, y2),\\n\",\n",
    "    \"\\n\",\n",
    "    \"        arrowstyle=\\\"-|>\\\",\\n\",\n",
    "    \"        mutation_scale=14,\\n\",\n",
    "    \"\\n\",\n",
    "    \"        linewidth=1.2,\\n\",\n",
    "    \"        color=\\\"black\\\",\\n\",\n",
    "    \"        alpha=0.95,\\n\",\n",
    "    \"\\n\",\n",
    "    \"        connectionstyle=f\\\"arc3,rad={rad}\\\",\\n\",\n",
    "    \"\\n\",\n",
    "    \"        shrinkA=10,\\n\",\n",
    "    \"        shrinkB=10,\\n\",\n",
    "    \"\\n\",\n",
    "    \"        zorder=10\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"\\n\",\n",
    "    \"    ax.add_patch(arrow)\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ============================================================\\n\",\n",
    "    \"# 8. 图像细节\\n\",\n",
    "    \"# ============================================================\\n\",\n",
    "    \"ax.set_aspect(\\\"equal\\\")\\n\",\n",
    "    \"ax.axis(\\\"off\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"plt.tight_layout()\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ============================================================\\n\",\n",
    "    \"# 9. 保存\\n\",\n",
    "    \"# ============================================================\\n\",\n",
    "    \"svg_path = os.path.join(\\n\",\n",
    "    \"    save_dir,\\n\",\n",
    "    \"    save_name + \\\".svg\\\"\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"pdf_path = os.path.join(\\n\",\n",
    "    \"    save_dir,\\n\",\n",
    "    \"    save_name + \\\".pdf\\\"\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"png_path = os.path.join(\\n\",\n",
    "    \"    save_dir,\\n\",\n",
    "    \"    save_name + \\\".png\\\"\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"fig.savefig(\\n\",\n",
    "    \"    svg_path,\\n\",\n",
    "    \"    bbox_inches=\\\"tight\\\",\\n\",\n",
    "    \"    pad_inches=0.02\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"fig.savefig(\\n\",\n",
    "    \"    pdf_path,\\n\",\n",
    "    \"    bbox_inches=\\\"tight\\\",\\n\",\n",
    "    \"    pad_inches=0.02\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"fig.savefig(\\n\",\n",
    "    \"    png_path,\\n\",\n",
    "    \"    dpi=300,\\n\",\n",
    "    \"    bbox_inches=\\\"tight\\\",\\n\",\n",
    "    \"    pad_inches=0.02\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"plt.show()\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"\\\\nSaved files:\\\")\\n\",\n",
    "    \"print(svg_path)\\n\",\n",
    "    \"print(pdf_path)\\n\",\n",
    "    \"print(png_path)\"\n",
    "   ],\n",
