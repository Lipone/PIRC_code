    "   },\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"import pickle\\n\",\n",
    "    \"import numpy as np\\n\",\n",
    "    \"import matplotlib.pyplot as plt\\n\",\n",
    "    \"from sklearn.metrics import roc_curve, auc\\n\",\n",
    "    \"import matplotlib as mpl\\n\",\n",
    "    \"\\n\",\n",
    "    \"with open(\\\"results/kuramoto_10_trajectories.pkl\\\", \\\"rb\\\") as f:\\n\",\n",
    "    \"    result = pickle.load(f)\\n\",\n",
    "    \"\\n\",\n",
    "    \"data_list = result[\\\"data_list\\\"]\\n\",\n",
    "    \"a2_list = result[\\\"a2_list\\\"]\\n\",\n",
    "    \"a3_list = result[\\\"a3_list\\\"]\\n\",\n",
    "    \"T_list = result[\\\"T_list\\\"]\\n\",\n",
    "    \"\\n\",\n",
    "    \"with open(\\\"results/best_result_10.pkl\\\", \\\"rb\\\") as f:\\n\",\n",
    "    \"    result = pickle.load(f)\\n\",\n",
    "    \"\\n\",\n",
    "    \"PIRC_Score_list = result[\\\"Score_list\\\"]\\n\",\n",
    "    \"\\n\",\n",
    "    \"fig, ax = plt.subplots(figsize=(5.2, 4.2))\\n\",\n",
    "    \"\\n\",\n",
    "    \"# 10 个由浅到深的红色\\n\",\n",
    "    \"colors = plt.cm.Reds(np.linspace(0.35, 0.95, len(PIRC_Score_list)))\\n\",\n",
    "    \"\\n\",\n",
    "    \"auc_list = []\\n\",\n",
    "    \"\\n\",\n",
    "    \"for i, (score, T) in enumerate(zip(PIRC_Score_list, T_list)):\\n\",\n",
    "    \"    score = np.asarray(score)\\n\",\n",
    "    \"    T = np.asarray(T)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    if score.shape != T.shape:\\n\",\n",
    "    \"        raise ValueError(\\n\",\n",
    "    \"            f\\\"Trial {i}: score shape {score.shape} \\\"\\n\",\n",
    "    \"            f\\\"does not match T shape {T.shape}\\\"\\n\",\n",
    "    \"        )\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # 展平成一维\\n\",\n",
    "    \"    y_true = T.reshape(-1)\\n\",\n",
    "    \"    y_score = score.reshape(-1)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # 去除非有限值\\n\",\n",
    "    \"    valid = np.isfinite(y_true) & np.isfinite(y_score)\\n\",\n",
    "    \"    mask = np.ones_like(T, dtype=bool)\\n\",\n",
    "    \"    np.fill_diagonal(mask, False)\\n\",\n",
    "    \"    y_true = T[mask].astype(int)\\n\",\n",
    "    \"    y_score = score[mask]\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # 确保真实标签为 0/1\\n\",\n",
    "    \"    y_true = (y_true != 0).astype(int)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # 检查是否同时含有正负样本\\n\",\n",
    "    \"    if np.unique(y_true).size < 2:\\n\",\n",
    "    \"        print(f\\\"[WARN] Structure {i + 1} contains only one class, skipped.\\\")\\n\",\n",
    "    \"        continue\\n\",\n",
