    "    }\n",
    "   },\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"def read_data(args):\\n\",\n",
    "    \"    the = pd.read_csv(\\\"./dataset/data/theta.csv\\\").values[:, 1:].transpose()\\n\",\n",
    "    \"    theta = np.zeros((args.N, args.n, args.T, 1))\\n\",\n",
    "    \"    theta[0, :, :, 0] = the\\n\",\n",
    "    \"    Sd = pd.read_csv(\\\"./dataset/data/Sd.csv\\\").values[:, 1:]\\n\",\n",
    "    \"    Xs = pd.read_csv(\\\"./dataset/data/trajectory.csv\\\").values[:, 1:].transpose()\\n\",\n",
    "    \"    Xss = np.zeros((args.n, args.N * args.T, args.V))\\n\",\n",
    "    \"    Xsn = np.zeros((args.N, args.n, args.T, args.V))\\n\",\n",
    "    \"    for i in range(args.V):\\n\",\n",
    "    \"        Xss[:, :, i] = Xs[:, i * args.N * args.T:(i + 1) * args.N * args.T]\\n\",\n",
    "    \"    for i in range(args.N):\\n\",\n",
    "    \"        Xsn[i, :, :, :] = Xss[:, i * args.T:(i + 1) * args.T, :]\\n\",\n",
    "    \"    time_point = pd.read_csv(\\\"./dataset/data/time_point.csv\\\").values[:, 1:]\\n\",\n",
    "    \"    edges_out = pd.read_csv(\\\"./dataset/data/edges.csv\\\").values[:, 1:]\\n\",\n",
    "    \"    Xsn = torch.tensor(Xsn).float()\\n\",\n",
    "    \"    return (Xsn, theta, time_point, edges_out, Sd)\"\n",
    "   ],\n",
    "   \"id\": \"6abb89fd389aa854\",\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": 9\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-07-10T17:41:39.958820Z\",\n",
    "     \"start_time\": \"2026-07-10T17:41:39.095424Z\"\n",
    "    }\n",
    "   },\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"args = argparse.Namespace(\\n\",\n",
    "    \"    device='cpu',\\n\",\n",
    "    \"    data_ind='power_grid',\\n\",\n",
    "    \"    net_nam='edges',\\n\",\n",
    "    \"    direc=True,\\n\",\n",
    "    \"    N=1,\\n\",\n",
    "    \"    n=120,\\n\",\n",
    "    \"    T=10000,\\n\",\n",
    "    \"    V=2,\\n\",\n",
    "    \"    dt=0.08,\\n\",\n",
    "    \"    ddt=0.02,\\n\",\n",
    "    \"    N_train=1000,\\n\",\n",
    "    \"    N_test=10,\\n\",\n",
    "    \"    N_washout=0,\\n\",\n",
    "    \"    N_start=0,\\n\",\n",
    "    \"    n_trials=500,\\n\",\n",
    "    \"    Threshold=1e-3,\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"(Xsn, theta, time_point, edges_out, Sd) = read_data(args)\\n\",\n",
    "    \"data=theta.squeeze().T #T*n\\n\",\n",
    "    \"device = torch.device(\\\"cuda:1\\\")\\n\",\n",
    "    \"# device = torch.device(\\\"cpu\\\")\\n\",\n",
    "    \"set_seed(42)\"\n",
    "   ],\n",
    "   \"id\": \"e97f0bfbe4f84e59\",\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": 10\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-07-10T17:41:41.574194Z\",\n",
    "     \"start_time\": \"2026-07-10T17:41:41.553082Z\"\n",
    "    }\n",
    "   },\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"with open(\\\"results/ARNI1_result.pkl\\\", \\\"rb\\\") as f:\\n\",\n",
    "    \"    result = pickle.load(f)\\n\",\n",
    "    \"params=result[\\\"best_params\\\"]\\n\",\n",
    "    \"T_Matrix=result[\\\"T_Matrix\\\"]\\n\",\n",
    "    \"basis_order=params[\\\"basis_order\\\"]\\n\",\n",
    "    \"th=params[\\\"th\\\"]\\n\",\n",
    "    \"typ=params[\\\"type\\\"]\\n\",\n",
    "    \"base=\\\"polynomial\\\"\\n\",\n",
    "    \"data=data[:100,:]\\n\",\n",
    "    \"ExpandNodes = args.n + math.comb(args.n - 1, 2)\"\n",
    "   ],\n",
    "   \"id\": \"668b49508a8ece8e\",\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": 11\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-07-10T17:42:24.959585Z\",\n",
    "     \"start_time\": \"2026-07-10T17:41:44.387256Z\"\n",
    "    }\n",
    "   },\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"def run_node(\\n\",\n",
    "    \"    NODE,\\n\",\n",
    "    \"    typ,\\n\",\n",
    "    \"    base,\\n\",\n",
    "    \"    order,\\n\",\n",
    "    \"    expanded_cache,\\n\",\n",
    "    \"    Y_T,\\n\",\n",
    "    \"    th=1e-4\\n\",\n",
    "    \"):\\n\",\n",
    "    \"    X_expanded = expanded_cache[(NODE, typ)]\\n\",\n",
    "    \"    X_expanded_T = X_expanded.T\\n\",\n",
    "    \"    try:\\n\",\n",
    "    \"        llist, cost, vec = ARNI(\\n\",\n",
    "    \"            X_expanded_T,\\n\",\n",
    "    \"            Y_T,\\n\",\n",
    "    \"            base,\\n\",\n",
    "    \"            order,\\n\",\n",
    "    \"            NODE,\\n\",\n",
    "    \"            th=th\\n\",\n",
    "    \"        )\\n\",\n",
    "    \"    except np.linalg.LinAlgError:\\n\",\n",
    "    \"        return NODE, np.zeros(ExpandNodes), np.zeros(Y_T.shape[1])\\n\",\n",
    "    \"    X_basis = basis_expansion(\\n\",\n",
    "    \"        X_expanded_T,\\n\",\n",
    "    \"        order,\\n\",\n",
    "    \"        base,\\n\",\n",
    "    \"        NODE\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"    y_pred = np.zeros(Y_T.shape[1])\\n\",\n",
    "    \"    if len(llist) > 0:\\n\",\n",
    "    \"        R = np.vstack([\\n\",\n",
    "    \"            X_basis[:, :, idx]\\n\",\n",
    "    \"            for idx in llist\\n\",\n",
    "    \"        ])\\n\",\n",
    "    \"        try:\\n\",\n",
    "    \"            RI = np.linalg.pinv(R)\\n\",\n",
    "    \"            A = Y_T[NODE] @ RI\\n\",\n",
    "    \"            y_pred = A @ R\\n\",\n",
    "    \"        except np.linalg.LinAlgError:\\n\",\n",
    "    \"            pass\\n\",\n",
    "    \"    return NODE, vec, y_pred\\n\",\n",
    "    \"\\n\",\n",
    "    \"def rrmse_per_node(Y_true, Y_pred, eps=1e-12):\\n\",\n",
    "    \"    Y_true = np.asarray(Y_true)\\n\",\n",
    "    \"    Y_pred = np.asarray(Y_pred)\\n\",\n",
    "    \"    rmse = np.sqrt(np.mean((Y_true - Y_pred) ** 2, axis=1))\\n\",\n",
    "    \"    scale = np.sqrt(np.mean(Y_true ** 2, axis=1)) + eps\\n\",\n",
    "    \"    return rmse, rmse / scale\\n\",\n",
    "    \"\\n\",\n",
    "    \"T_from_Ainf = np.zeros((args.n, ExpandNodes))\\n\",\n",
    "    \"X1 = data[:-1, :]\\n\",\n",
    "    \"X2 = data[1:, :]\\n\",\n",
    "    \"X = (X1 + X2) * 0.5\\n\",\n",
    "    \"X = X % (2 * np.pi)\\n\",\n",
    "    \"Y = (data[1:, :] - data[:-1, :]) / args.dt\\n\",\n",
    "    \"Y_T = Y.T\\n\",\n",
    "    \"\\n\",\n",
    "    \"expanded_cache = {}\\n\",\n",
    "    \"for NODE in range(args.n):\\n\",\n",
    "    \"    expanded_cache[(NODE, typ)] = expand_nodes(\\n\",\n",
    "    \"        X.copy(),\\n\",\n",
    "    \"        NODE,\\n\",\n",
    "    \"        type=typ\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"T_from_Ainf = np.zeros((args.n, ExpandNodes))\\n\",\n",
    "    \"Y_pred = np.zeros_like(Y_T)\\n\",\n",
    "    \"results = Parallel(n_jobs=-1)(\\n\",\n",
    "    \"    delayed(run_node)(\\n\",\n",
    "    \"        NODE,\\n\",\n",
    "    \"        typ,\\n\",\n",
    "    \"        base,\\n\",\n",
    "    \"        basis_order,\\n\",\n",
    "    \"        expanded_cache,\\n\",\n",
    "    \"        Y_T,\\n\",\n",
    "    \"        th=th\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"    for NODE in range(args.n)\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"for NODE, vec, pred in results:\\n\",\n",
    "    \"    T_from_Ainf[NODE] = vec\\n\",\n",
    "    \"    Y_pred[NODE] = pred\\n\",\n",
    "    \"rmse, rrmse = rrmse_per_node(Y_T, Y_pred)\\n\",\n",
    "    \"AUC = ranking_auc_ALL(T_from_Ainf, T_Matrix)\\n\",\n",
    "    \"AUC = AUC.item() if hasattr(AUC, \\\"item\\\") else float(AUC)\\n\",\n",
    "    \"print(AUC)\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"Mean RMSE :\\\", np.mean(rmse))\\n\",\n",
    "    \"print(\\\"Mean RRMSE:\\\", np.mean(rrmse))\"\n",
    "   ],\n",
    "   \"id\": \"c2772d05f22bb3e7\",\n",
    "   \"outputs\": [\n",
    "    {\n",
    "     \"name\": \"stdout\",\n",
    "     \"output_type\": \"stream\",\n",
    "     \"text\": [\n",
    "      \"0.5026538968086243\\n\",\n",
    "      \"Mean RMSE : 0.14560180477536513\\n\",\n",
    "      \"Mean RRMSE: 0.18359414686257208\\n\"\n",
    "     ]\n",
    "    }\n",
    "   ],\n",
    "   \"execution_count\": 12\n",
    "  },\n",
