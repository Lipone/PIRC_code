    "   \"source\": [\n",
    "    \"import sys\\n\",\n",
    "    \"sys.path.append('/home/caoren/tmp/PIRC_for_HigherOrderCausality')\\n\",\n",
    "    \"import os\\n\",\n",
    "    \"os.chdir(\\\"/home/caoren/tmp/PIRC_for_HigherOrderCausality/Results/UK_PowerGrid\\\")\\n\",\n",
    "    \"from Torch_Library import *\\n\",\n",
    "    \"from Model.ARNI import ARNI, expand_nodes, basis_expansion\\n\",\n",
    "    \"import argparse\\n\",\n",
    "    \"import numpy as np\\n\",\n",
    "    \"import pickle\\n\",\n",
    "    \"import pandas as pd\\n\",\n",
    "    \"from sklearn.metrics import roc_curve, auc\\n\",\n",
    "    \"import matplotlib.pyplot as plt\"\n",
    "   ],\n",
