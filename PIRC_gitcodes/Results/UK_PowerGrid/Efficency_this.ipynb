    "  },\n",
    "  {\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-07-10T17:02:20.367245Z\",\n",
    "     \"start_time\": \"2026-07-10T17:02:19.483861Z\"\n",
    "    }\n",
    "   },\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"args = argparse.Namespace(\\n\",\n",
    "    \"    device='cpu',\\n\",\n",
    "    \"    data_ind='power_grid',\\n\",\n",
    "    \"    net_nam='edges',\\n\",\n",
    "    \"    direc=True,\\n\",\n",
    "    \"    N=1,\\n\",\n",
    "    \"    n=120,\\n\",\n",
    "    \"    T=10000,\\n\",\n",
    "    \"    V=2,\\n\",\n",
    "    \"    dt=0.08,\\n\",\n",
    "    \"    ddt=0.02,\\n\",\n",
    "    \"    N_train=1000,\\n\",\n",
    "    \"    N_test=10,\\n\",\n",
    "    \"    N_washout=0,\\n\",\n",
    "    \"    N_start=0,\\n\",\n",
    "    \"    n_trials=500,\\n\",\n",
    "    \"    Threshold=1e-3,\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"(Xsn, theta, time_point, edges_out, Sd) = read_data(args)\\n\",\n",
    "    \"data=theta.squeeze().T #T*n\\n\",\n",
    "    \"set_seed(42)\\n\",\n",
    "    \"ooi = []\\n\",\n",
    "    \"dmax = 2\\n\",\n",
    "    \"\\n\",\n",
    "    \"with open(\\\"results/THIS_result.pkl\\\", \\\"rb\\\") as f:\\n\",\n",
    "    \"    result = pickle.load(f)\\n\",\n",
    "    \"params=result['best_params']\\n\",\n",
    "    \"T_Matrix = result['T_Matrix']\\n\",\n",
    "    \"rho=params['alpha']\\n\",\n",
    "    \"niter=params['niter']\\n\",\n",
    "    \"lam=params['threshold']\"\n",
    "   ],\n",
    "   \"id\": \"625febbb9d4be2ca\",\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": 8\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-07-10T17:12:00.330134Z\",\n",
    "     \"start_time\": \"2026-07-10T17:02:22.450802Z\"\n",
    "    }\n",
    "   },\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"import time\\n\",\n",
    "    \"import numpy as np\\n\",\n",
    "    \"import pickle\\n\",\n",
    "    \"\\n\",\n",
    "    \"node_nums = [120]\\n\",\n",
    "    \"\\n\",\n",
    "    \"T = 101\\n\",\n",
    "    \"\\n\",\n",
    "    \"time_mean = []\\n\",\n",
    "    \"time_std = []\\n\",\n",
    "    \"time_all = {}\\n\",\n",
    "    \"theta_time_all = {}\\n\",\n",
    "    \"\\n\",\n",
    "    \"data_full = data.copy()\\n\",\n",
    "    \"\\n\",\n",
    "    \"for node_num in node_nums:\\n\",\n",
    "    \"    data_now = data_full[:T, :node_num]\\n\",\n",
    "    \"\\n\",\n",
    "    \"    X1 = data_now[:-1, :]\\n\",\n",
    "    \"    X2 = data_now[1:, :]\\n\",\n",
    "    \"    X = X1\\n\",\n",
    "    \"    X = X % (2 * np.pi)\\n\",\n",
    "    \"    Y = (X2 - X1) / args.dt\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # ===== shared Taylor dictionary construction =====\\n\",\n",
    "    \"    t_theta0 = time.perf_counter()\\n\",\n",
    "    \"    theta, d = get_thetad(X.T, dmax)\\n\",\n",
    "    \"    t_theta1 = time.perf_counter()\\n\",\n",
    "    \"\\n\",\n",
    "    \"    theta_time = t_theta1 - t_theta0\\n\",\n",
    "    \"    theta_time_per_node = theta_time / node_num\\n\",\n",
    "    \"\\n\",\n",
    "    \"    node_times = []\\n\",\n",
    "    \"\\n\",\n",
    "    \"    for i in range(node_num):\\n\",\n",
    "    \"        t0 = time.perf_counter()\\n\",\n",
    "    \"\\n\",\n",
    "    \"        coeff_i, err_i = my_sindy(\\n\",\n",
    "    \"            theta,\\n\",\n",
    "    \"            Y.T[i:i + 1, :],\\n\",\n",
    "    \"            lam=lam,\\n\",\n",
    "    \"            rho=rho,\\n\",\n",
    "    \"            niter=niter\\n\",\n",
    "    \"        )\\n\",\n",
    "    \"\\n\",\n",
    "    \"        t1 = time.perf_counter()\\n\",\n",
    "    \"\\n\",\n",
    "    \"        # include shared dictionary construction time averaged over nodes\\n\",\n",
    "    \"        node_times.append((t1 - t0) + theta_time_per_node)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    node_times = np.asarray(node_times)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    time_all[node_num] = node_times\\n\",\n",
    "    \"    theta_time_all[node_num] = theta_time\\n\",\n",
    "    \"\\n\",\n",
    "    \"    time_mean.append(node_times.mean())\\n\",\n",
    "    \"    time_std.append(node_times.std())\\n\",\n",
    "    \"\\n\",\n",
    "    \"    print(\\n\",\n",
    "    \"        f\\\"N={node_num:3d} | \\\"\\n\",\n",
    "    \"        f\\\"THIS time per node = {node_times.mean():.4f} ± {node_times.std():.4f} s \\\"\\n\",\n",
    "    \"        f\\\"(theta total={theta_time:.4f} s)\\\"\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"\\n\",\n",
    "    \"save_dict = {\\n\",\n",
    "    \"    \\\"node_nums\\\": node_nums,\\n\",\n",
    "    \"    \\\"T\\\": T,\\n\",\n",
    "    \"    \\\"lam\\\": lam,\\n\",\n",
    "    \"    \\\"rho\\\": rho,\\n\",\n",
    "    \"    \\\"niter\\\": niter,\\n\",\n",
    "    \"    \\\"dmax\\\": dmax,\\n\",\n",
    "    \"    \\\"time_mean\\\": np.asarray(time_mean),\\n\",\n",
    "    \"    \\\"time_std\\\": np.asarray(time_std),\\n\",\n",
    "    \"    \\\"time_all\\\": time_all,\\n\",\n",
    "    \"    \\\"theta_time_all\\\": theta_time_all,\\n\",\n",
    "    \"}\\n\",\n",
    "    \"\\n\",\n",
    "    \"with open(\\\"THIS_time_scaling.pkl\\\", \\\"wb\\\") as f:\\n\",\n",
    "    \"    pickle.dump(save_dict, f)\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"Results saved to THIS_time_scaling.pkl\\\")\"\n",
    "   ],\n",
