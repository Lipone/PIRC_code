    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"def read_data(args):\\n\",\n",
    "    \"    the = pd.read_csv(\\\"./dataset/data/theta.csv\\\").values[:, 1:].transpose()\\n\",\n",
    "    \"    theta = np.zeros((args.N, args.n, args.T, 1))\\n\",\n",
    "    \"    theta[0, :, :, 0] = the\\n\",\n",
    "    \"    Sd = pd.read_csv(\\\"./dataset/data/Sd.csv\\\").values[:, 1:]\\n\",\n",
    "    \"    Xs = pd.read_csv(\\\"./dataset/data/trajectory.csv\\\").values[:, 1:].transpose()\\n\",\n",
    "    \"    Xss = np.zeros((args.n, args.N * args.T, args.V))\\n\",\n",
    "    \"    Xsn = np.zeros((args.N, args.n, args.T, args.V))\\n\",\n",
    "    \"    for i in range(args.V):\\n\",\n",
    "    \"        Xss[:, :, i] = Xs[:, i * args.N * args.T:(i + 1) * args.N * args.T]\\n\",\n",
    "    \"    for i in range(args.N):\\n\",\n",
    "    \"        Xsn[i, :, :, :] = Xss[:, i * args.T:(i + 1) * args.T, :]\\n\",\n",
    "    \"    time_point = pd.read_csv(\\\"./dataset/data/time_point.csv\\\").values[:, 1:]\\n\",\n",
    "    \"    edges_out = pd.read_csv(\\\"./dataset/data/edges.csv\\\").values[:, 1:]\\n\",\n",
    "    \"    Xsn = torch.tensor(Xsn).float()\\n\",\n",
    "    \"    return (Xsn, theta, time_point, edges_out, Sd)\"\n",
    "   ],\n",
