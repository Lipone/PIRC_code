    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"args = argparse.Namespace(\\n\",\n",
    "    \"    device='cpu',\\n\",\n",
    "    \"    data_ind='power_grid',\\n\",\n",
