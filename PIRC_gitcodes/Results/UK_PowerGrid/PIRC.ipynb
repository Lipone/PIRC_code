    "    \"device = torch.device(\\\"cuda:2\\\")\\n\",\n",
    "    \"with open(\\\"results/PIRC_result_l100.pkl\\\", \\\"rb\\\") as f:\\n\",\n",
    "    \"    result = pickle.load(f)\"\n",
