    "   },\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"noise_level = 0   # 5%\\n\",\n",
    "    \"sigma = np.std(data, axis=0, keepdims=True)\\n\",\n",
    "    \"noise = noise_level * sigma * np.random.randn(*data.shape)\\n\",\n",
    "    \"data_noisy = data + noise\\n\",\n",
    "    \"\\n\",\n",
    "    \"X = torch.as_tensor(data_noisy, dtype=torch.float32, device=device)\\n\",\n",
    "    \"X_batch = torch.stack(\\n\",\n",
    "    \"    [shift_column_to_first(X, i) for i in range(args.n)],\\n\",\n",
    "    \"    dim=0\\n\",\n",
    "    \")\\n\",\n",
    "    \"X_washout, X_train, Y_train, Y_test = split_dataset2_batch(\\n\",\n",
    "    \"    X_batch,\\n\",\n",
    "    \"    args.N_washout,\\n\",\n",
    "    \"    args.N_train,\\n\",\n",
    "    \"    args.N_test,\\n\",\n",
    "    \"    in_dim=args.n,\\n\",\n",
    "    \"    out_dim=args.n\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"T_tensor = torch.as_tensor(T_Matrix, dtype=torch.float32, device=device)\\n\",\n",
    "    \"Score_full = torch.full_like(T_tensor, -1e9)\\n\",\n",
    "    \"rmse_all = []\\n\",\n",
    "    \"rrmse_all = []\\n\",\n",
    "    \"\\n\",\n",
    "    \"for i in range(args.n):\\n\",\n",
    "    \"        pirc = Nonliear_PIRC(\\n\",\n",
    "    \"            n_units=n_units,\\n\",\n",
    "    \"            in_dim=args.n,\\n\",\n",
    "    \"            out_dim=args.n,\\n\",\n",
    "    \"            Win=Win,\\n\",\n",
    "    \"            Wres=Wres,\\n\",\n",
    "    \"            Expand=1,\\n\",\n",
    "    \"            sigma_in=sigma_in,\\n\",\n",
    "    \"            rho=rho,\\n\",\n",
    "    \"            alpha=alpha,\\n\",\n",
    "    \"            tikh=tikh,\\n\",\n",
    "    \"            mode=mode,\\n\",\n",
    "    \"            block_dim=block_dim,\\n\",\n",
    "    \"            I_type=I_type,\\n\",\n",
    "    \"            option=option,\\n\",\n",
    "    \"            device=device,\\n\",\n",
    "    \"            dt=args.dt,\\n\",\n",
    "    \"            bias=bias\\n\",\n",
    "    \"        )\\n\",\n",
    "    \"\\n\",\n",
    "    \"        R, rmse, rrmse = pirc.train(\\n\",\n",
    "    \"            X_washout[i:i + 1, :, :],\\n\",\n",
    "    \"            X_train[i:i + 1, :, :],\\n\",\n",
    "    \"            Y_train[i:i + 1, :, :]\\n\",\n",
    "    \"        )\\n\",\n",
    "    \"        rmse_all.append(float(rmse))\\n\",\n",
    "    \"\\n\",\n",
    "    \"        rrmse_all.append(float(rrmse))\\n\",\n",
    "    \"\\n\",\n",
    "    \"        Y_test_predict = pirc.Prediction2(\\n\",\n",
    "    \"            R,\\n\",\n",
    "    \"            args.N_test,\\n\",\n",
    "    \"            Y_train[i:i + 1, :, :],\\n\",\n",
    "    \"            Y_test[i:i + 1, :, :]\\n\",\n",
    "    \"        )\\n\",\n",
    "    \"        base_all = Y_test_predict[0, :, :args.N_test, 0]\\n\",\n",
    "    \"        others_all = Y_test_predict[2:, :, :args.N_test, 0]\\n\",\n",
    "    \"        base_expand = base_all.unsqueeze(0).expand_as(others_all)\\n\",\n",
    "    \"        score_EN = score_0_1_torch(\\n\",\n",
    "    \"            others_all,\\n\",\n",
    "    \"            base_expand,\\n\",\n",
    "    \"            method=method,\\n\",\n",
    "    \"            tau=tau\\n\",\n",
    "    \"        )\\n\",\n",
    "    \"        Score = score_EN.transpose(0, 1).contiguous()\\n\",\n",
    "    \"        Score_full[i, :] = Score\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ====== Score and AUC computation ======\\n\",\n",
    "    \"Score_full = shift_column_for_Causal_Matrix(Score_full)\\n\",\n",
