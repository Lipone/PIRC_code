    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"for name, (file_path, key) in zip(name_list, file_settings):\\n\",\n",
    "    \"    with open(file_path, \\\"rb\\\") as f:\\n\",\n",
    "    \"        result = pickle.load(f)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    runtime = np.asarray(\\n\",\n",
    "    \"        result[\\\"time_all\\\"][key],\\n\",\n",
    "    \"        dtype=float,\\n\",\n",
    "    \"    ).reshape(-1)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Remove NaN and Inf\\n\",\n",
    "    \"    runtime = runtime[np.isfinite(runtime)]\\n\",\n",
    "    \"\\n\",\n",
    "    \"    if runtime.size == 0:\\n\",\n",
    "    \"        raise ValueError(\\n\",\n",
    "    \"            f\\\"No valid runtime values were found for {name} \\\"\\n\",\n",
    "    \"            f\\\"in {file_path}, time_all[{key}].\\\"\\n\",\n",
    "    \"        )\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Runtime should be positive\\n\",\n",
    "    \"    runtime = runtime[runtime > 0]\\n\",\n",
    "    \"\\n\",\n",
    "    \"    if runtime.size == 0:\\n\",\n",
    "    \"        raise ValueError(\\n\",\n",
    "    \"            f\\\"No positive runtime values were found for {name}.\\\"\\n\",\n",
    "    \"        )\\n\",\n",
    "    \"\\n\",\n",
    "    \"    runtime_list.append(runtime)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    print(name)\\n\",\n",
    "    \"    print(f\\\"Number of runs : {runtime.size}\\\")\\n\",\n",
    "    \"    print(f\\\"Mean runtime   : {np.mean(runtime):.6f} s\\\")\\n\",\n",
    "    \"    print(f\\\"Median runtime : {np.median(runtime):.6f} s\\\")\\n\",\n",
    "    \"    print(f\\\"Std runtime    : {np.std(runtime):.6f} s\\\")\\n\",\n",
    "    \"    print(\\\"-\\\" * 40)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ===============================\\n\",\n",
    "    \"# Calculate mean runtime\\n\",\n",
    "    \"# ===============================\\n\",\n",
    "    \"mean_runtime = np.asarray(\\n\",\n",
    "    \"    [np.mean(runtime) for runtime in runtime_list]\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ===============================\\n\",\n",
    "    \"# Plot settings\\n\",\n",
    "    \"# ===============================\\n\",\n",
    "    \"colors = [\\n\",\n",
