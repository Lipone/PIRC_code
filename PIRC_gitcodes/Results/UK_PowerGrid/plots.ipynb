    "   \"source\": [\n",
    "    \"import pickle\\n\",\n",
    "    \"import numpy as np\\n\",\n",
    "    \"import matplotlib.pyplot as plt\\n\",\n",
    "    \"import matplotlib as mpl\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ===============================\\n\",\n",
    "    \"# Matplotlib settings\\n\",\n",
    "    \"# ===============================\\n\",\n",
    "    \"mpl.rcParams[\\\"svg.fonttype\\\"] = \\\"none\\\"\\n\",\n",
