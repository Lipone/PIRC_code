    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"import pickle\\n\",\n",
    "    \"import numpy as np\\n\",\n",
    "    \"import matplotlib.pyplot as plt\\n\",\n",
    "    \"import matplotlib as mpl\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ===============================\\n\",\n",
    "    \"# Matplotlib settings\\n\",\n",
    "    \"# ===============================\\n\",\n",
    "    \"mpl.rcParams[\\\"svg.fonttype\\\"] = \\\"none\\\"\\n\",\n",
    "    \"mpl.rcParams[\\\"pdf.fonttype\\\"] = 42\\n\",\n",
    "    \"mpl.rcParams[\\\"ps.fonttype\\\"] = 42\\n\",\n",
    "    \"\\n\",\n",
    "    \"mpl.rcParams[\\\"font.family\\\"] = \\\"DejaVu Serif\\\"\\n\",\n",
    "    \"mpl.rcParams[\\\"mathtext.fontset\\\"] = \\\"stix\\\"\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ===============================\\n\",\n",
    "    \"# Load data\\n\",\n",
    "    \"# ===============================\\n\",\n",
    "    \"rmse = []\\n\",\n",
    "    \"rrmse = []\\n\",\n",
    "    \"\\n\",\n",
    "    \"name_list = [\\n\",\n",
    "    \"    \\\"PIRC\\\",\\n\",\n",
    "    \"    \\\"THIS\\\",\\n\",\n",
    "    \"    r\\\"ARNI$^{1}$\\\",\\n\",\n",
    "    \"    r\\\"ARNI$^{2}$\\\",\\n\",\n",
    "    \"]\\n\",\n",
    "    \"\\n\",\n",
    "    \"files = [\\n\",\n",
    "    \"    \\\"results/PIRC_fittingErrors.pkl\\\",\\n\",\n",
    "    \"    \\\"results/THIS_fittingErrors.pkl\\\",\\n\",\n",
    "    \"    \\\"results/ARNI1_fittingErrors.pkl\\\",\\n\",\n",
    "    \"    \\\"results/ARNI2_fittingErrors.pkl\\\",\\n\",\n",
    "    \"]\\n\",\n",
    "    \"\\n\",\n",
    "    \"for name, file in zip(name_list, files):\\n\",\n",
    "    \"    with open(file, \\\"rb\\\") as f:\\n\",\n",
    "    \"        result = pickle.load(f)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    this_rmse = np.asarray(\\n\",\n",
    "    \"        result[\\\"rmse\\\"],\\n\",\n",
    "    \"        dtype=float,\\n\",\n",
    "    \"    ).reshape(-1)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    this_rrmse = np.asarray(\\n\",\n",
    "    \"        result[\\\"rrmse\\\"],\\n\",\n",
    "    \"        dtype=float,\\n\",\n",
    "    \"    ).reshape(-1)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # 删除 NaN 和 Inf\\n\",\n",
    "    \"    this_rmse = this_rmse[np.isfinite(this_rmse)]\\n\",\n",
    "    \"    this_rrmse = this_rrmse[np.isfinite(this_rrmse)]\\n\",\n",
    "    \"\\n\",\n",
    "    \"    rmse.append(this_rmse)\\n\",\n",
    "    \"    rrmse.append(this_rrmse)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    print(f\\\"{name}\\\")\\n\",\n",
    "    \"    print(f\\\"Mean RMSE   : {np.mean(this_rmse):.6f}\\\")\\n\",\n",
    "    \"    print(f\\\"Mean RRMSE  : {np.mean(this_rrmse):.6f}\\\")\\n\",\n",
    "    \"    print(f\\\"Std RRMSE   : {np.std(this_rrmse):.6f}\\\")\\n\",\n",
    "    \"    print(f\\\"Median RRMSE: {np.median(this_rrmse):.6f}\\\")\\n\",\n",
    "    \"    print(\\\"-\\\" * 40)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ===============================\\n\",\n",
    "    \"# Choose plotting data\\n\",\n",
    "    \"# ===============================\\n\",\n",
    "    \"data_plot = rrmse\\n\",\n",
    "    \"ylabel = \\\"Mean RRMSE\\\"\\n\",\n",
    "    \"\\n\",\n",
    "    \"colors = [\\n\",\n",
    "    \"    \\\"#80B1D3\\\",  # PIRC\\n\",\n",
    "    \"    \\\"#BC80BD\\\",  # THIS\\n\",\n",
    "    \"    \\\"#FB8072\\\",  # ARNI1\\n\",\n",
    "    \"    \\\"#FDB462\\\",  # ARNI2\\n\",\n",
    "    \"]\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ===============================\\n\",\n",
    "    \"# Prepare data for log scale\\n\",\n",
    "    \"# ===============================\\n\",\n",
    "    \"eps = 1e-8\\n\",\n",
    "    \"data_plot_safe = []\\n\",\n",
    "    \"\\n\",\n",
    "    \"for y in data_plot:\\n\",\n",
    "    \"    y = np.asarray(y, dtype=float).reshape(-1)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # 删除 NaN 和 Inf\\n\",\n",
    "    \"    y = y[np.isfinite(y)]\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # 对数坐标不能出现 0 或负数\\n\",\n",
    "    \"    y = np.where(y <= 0, eps, y)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    data_plot_safe.append(y)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ===============================\\n\",\n",
    "    \"# Calculate statistics\\n\",\n",
    "    \"# ===============================\\n\",\n",
    "    \"means = np.asarray(\\n\",\n",
    "    \"    [np.mean(y) for y in data_plot_safe]\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"stds = np.asarray(\\n\",\n",
    "    \"    [np.std(y) for y in data_plot_safe]\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"x = np.arange(len(name_list))\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ===============================\\n\",\n",
    "    \"# Plot mean bar chart\\n\",\n",
    "    \"# ===============================\\n\",\n",
    "    \"fig, ax = plt.subplots(figsize=(5.5, 3.5))\\n\",\n",
    "    \"\\n\",\n",
    "    \"bars = ax.bar(\\n\",\n",
    "    \"    x,\\n\",\n",
    "    \"    means,\\n\",\n",
    "    \"    width=0.55,\\n\",\n",
    "    \"    color=colors,\\n\",\n",
    "    \"    edgecolor=\\\"black\\\",\\n\",\n",
    "    \"    linewidth=1.2,\\n\",\n",
    "    \"    zorder=3,\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ===============================\\n\",\n",
    "    \"# Error bars: mean ± standard deviation\\n\",\n",
    "    \"# ===============================\\n\",\n",
    "    \"ax.errorbar(\\n\",\n",
    "    \"    x,\\n\",\n",
    "    \"    means,\\n\",\n",
    "    \"    yerr=stds,\\n\",\n",
    "    \"    fmt=\\\"none\\\",\\n\",\n",
    "    \"    ecolor=\\\"black\\\",\\n\",\n",
    "    \"    elinewidth=1.4,\\n\",\n",
    "    \"    capsize=4,\\n\",\n",
    "    \"    capthick=1.4,\\n\",\n",
    "    \"    zorder=4,\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ===============================\\n\",\n",
    "    \"# Add mean values\\n\",\n",
    "    \"# ===============================\\n\",\n",
    "    \"for i, mean_value in enumerate(means):\\n\",\n",
    "    \"    ax.text(\\n\",\n",
    "    \"        i,\\n\",\n",
    "    \"        mean_value * 1.12,\\n\",\n",
    "    \"        f\\\"{mean_value:.3f}\\\",\\n\",\n",
    "    \"        ha=\\\"center\\\",\\n\",\n",
    "    \"        va=\\\"bottom\\\",\\n\",\n",
    "    \"        fontsize=10,\\n\",\n",
    "    \"        zorder=5,\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ===============================\\n\",\n",
    "    \"# Axis settings\\n\",\n",
    "    \"# ===============================\\n\",\n",
    "    \"ax.set_yscale(\\\"log\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"ax.set_xticks(x)\\n\",\n",
    "    \"ax.set_xticklabels(\\n\",\n",
    "    \"    name_list,\\n\",\n",
    "    \"    fontsize=13,\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"ax.set_ylabel(\\n\",\n",
    "    \"    ylabel,\\n\",\n",
    "    \"    fontsize=15,\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ===============================\\n\",\n",
    "    \"# Automatically set y-axis limits\\n\",\n",
    "    \"# ===============================\\n\",\n",
    "    \"all_y = np.concatenate(data_plot_safe)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# 同时考虑柱子和误差条上界\\n\",\n",
    "    \"upper_values = means + stds\\n\",\n",
    "    \"positive_lower_values = means - stds\\n\",\n",
    "    \"positive_lower_values = positive_lower_values[\\n\",\n",
    "    \"    positive_lower_values > 0\\n\",\n",
    "    \"]\\n\",\n",
    "    \"\\n\",\n",
    "    \"if len(positive_lower_values) > 0:\\n\",\n",
    "    \"    ymin = min(\\n\",\n",
    "    \"        np.min(all_y),\\n\",\n",
    "    \"        np.min(positive_lower_values),\\n\",\n",
    "    \"    ) * 0.5\\n\",\n",
    "    \"else:\\n\",\n",
    "    \"    ymin = np.min(all_y) * 0.5\\n\",\n",
    "    \"\\n\",\n",
    "    \"ymax = max(\\n\",\n",
    "    \"    np.max(all_y),\\n\",\n",
    "    \"    np.max(upper_values),\\n\",\n",
    "    \"    1.0,\\n\",\n",
    "    \") * 2.0\\n\",\n",
    "    \"\\n\",\n",
    "    \"ymin = max(ymin, eps)\\n\",\n",
    "    \"\\n\",\n",
    "    \"ax.set_ylim(ymin, ymax)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ===============================\\n\",\n",
    "    \"# Reference line: RRMSE = 1\\n\",\n",
    "    \"# ===============================\\n\",\n",
    "    \"ax.axhline(\\n\",\n",
    "    \"    1.0,\\n\",\n",
    "    \"    color=\\\"0.55\\\",\\n\",\n",
    "    \"    linestyle=\\\"--\\\",\\n\",\n",
    "    \"    linewidth=1.2,\\n\",\n",
    "    \"    zorder=1,\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"ax.text(\\n\",\n",
    "    \"    -0.45,\\n\",\n",
    "    \"    1.0 * 1.05,\\n\",\n",
    "    \"    \\\"RRMSE = 1\\\",\\n\",\n",
    "    \"    fontsize=10,\\n\",\n",
    "    \"    color=\\\"0.35\\\",\\n\",\n",
    "    \"    va=\\\"bottom\\\",\\n\",\n",
    "    \"    ha=\\\"left\\\",\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ===============================\\n\",\n",
    "    \"# Beautify\\n\",\n",
    "    \"# ===============================\\n\",\n",
    "    \"ax.spines[\\\"top\\\"].set_visible(False)\\n\",\n",
    "    \"ax.spines[\\\"right\\\"].set_visible(False)\\n\",\n",
    "    \"\\n\",\n",
    "    \"ax.spines[\\\"left\\\"].set_linewidth(1.8)\\n\",\n",
    "    \"ax.spines[\\\"bottom\\\"].set_linewidth(1.8)\\n\",\n",
    "    \"\\n\",\n",
    "    \"ax.tick_params(\\n\",\n",
    "    \"    axis=\\\"both\\\",\\n\",\n",
    "    \"    which=\\\"major\\\",\\n\",\n",
    "    \"    direction=\\\"out\\\",\\n\",\n",
    "    \"    width=1.5,\\n\",\n",
    "    \"    length=5,\\n\",\n",
    "    \"    labelsize=12,\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"ax.tick_params(\\n\",\n",
    "    \"    axis=\\\"y\\\",\\n\",\n",
    "    \"    which=\\\"minor\\\",\\n\",\n",
    "    \"    direction=\\\"out\\\",\\n\",\n",
    "    \"    width=1.0,\\n\",\n",
    "    \"    length=3,\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"ax.grid(False)\\n\",\n",
    "    \"\\n\",\n",
    "    \"plt.tight_layout()\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ===============================\\n\",\n",
    "    \"# Save figure\\n\",\n",
    "    \"# ===============================\\n\",\n",
    "    \"plt.savefig(\\n\",\n",
    "    \"    \\\"PowerGrid_mean_RRMSE_bar.pdf\\\",\\n\",\n",
    "    \"    bbox_inches=\\\"tight\\\",\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"plt.savefig(\\n\",\n",
    "    \"    \\\"PowerGrid_mean_RRMSE_bar.svg\\\",\\n\",\n",
    "    \"    bbox_inches=\\\"tight\\\",\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"plt.savefig(\\n\",\n",
    "    \"    \\\"PowerGrid_mean_RRMSE_bar.png\\\",\\n\",\n",
    "    \"    dpi=600,\\n\",\n",
    "    \"    bbox_inches=\\\"tight\\\",\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"plt.show()\"\n",
    "   ],\n",
    "   \"id\": \"9976db13d58c0a05\",\n",
