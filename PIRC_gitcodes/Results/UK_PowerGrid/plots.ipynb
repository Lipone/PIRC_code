    "    \"    \\\"#FDB462\\\",  # ARNI2\\n\",\n",
    "    \"]\\n\",\n",
    "    \"\\n\",\n",
    "    \"x = np.arange(len(name_list))\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ===============================\\n\",\n",
    "    \"# Plot mean runtime bar chart\\n\",\n",
    "    \"# ===============================\\n\",\n",
    "    \"fig, ax = plt.subplots(figsize=(5.5, 3.5))\\n\",\n",
    "    \"\\n\",\n",
    "    \"bars = ax.bar(\\n\",\n",
    "    \"    x,\\n\",\n",
    "    \"    mean_runtime,\\n\",\n",
    "    \"    width=0.55,\\n\",\n",
    "    \"    color=colors,\\n\",\n",
    "    \"    edgecolor=\\\"black\\\",\\n\",\n",
    "    \"    linewidth=1.2,\\n\",\n",
    "    \"    zorder=3,\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ===============================\\n\",\n",
    "    \"# Add mean values above bars\\n\",\n",
    "    \"# ===============================\\n\",\n",
    "    \"for bar, value in zip(bars, mean_runtime):\\n\",\n",
    "    \"    ax.text(\\n\",\n",
    "    \"        bar.get_x() + bar.get_width() / 2,\\n\",\n",
    "    \"        value * 1.10,\\n\",\n",
    "    \"        f\\\"{value:.2g}\\\",\\n\",\n",
    "    \"        ha=\\\"center\\\",\\n\",\n",
    "    \"        va=\\\"bottom\\\",\\n\",\n",
    "    \"        fontsize=10,\\n\",\n",
    "    \"        color=\\\"black\\\",\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ===============================\\n\",\n",
    "    \"# Axis settings\\n\",\n",
    "    \"# ===============================\\n\",\n",
    "    \"ax.set_yscale(\\\"log\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"ax.set_xticks(x)\\n\",\n",
    "    \"ax.set_xticklabels(\\n\",\n",
    "    \"    name_list,\\n\",\n",
    "    \"    fontsize=13,\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"ax.set_ylabel(\\n\",\n",
    "    \"    \\\"Runtime per target node (s)\\\",\\n\",\n",
    "    \"    fontsize=15,\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Leave space for value labels\\n\",\n",
