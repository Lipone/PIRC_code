    "    \"\\n\",\n",
    "    \"ax.tick_params(\\n\",\n",
    "    \"    axis=\\\"both\\\",\\n\",\n",
    "    \"    which=\\\"major\\\",\\n\",\n",
    "    \"    direction=\\\"out\\\",\\n\",\n",
